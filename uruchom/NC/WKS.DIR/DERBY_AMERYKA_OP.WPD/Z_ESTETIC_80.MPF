IF R10==1 GOTOF ZAWIASY
IF R10==2 GOTOF ZAWIASY
MSG("BRAK OPCJI W R10")
gotof zakonczenie


ZAWIASY:
N106 GOUP

IF R10==1 ; 3 ZAWIASY ESTETIC 80
  N107 R40=3 ; 3XESTETIC80
  N108 R41=275 ; 275 ; 230 dla 10; 300 kubica ; 275 WYS. 1 ZAWIASU
  N109 R42=R7/3 ;580 dla 10; 600 kubica ; WYS. 2 ZAWIASU
  N110 R43=R7-275 ; R7-230 dla 10 ;R7-300  kubica; 275 WYS. 3 ZAWIASU
  N111 R44=1000000000 ; WYS. 4 ZAWIASU
  N112 R45=1000000000 ; WYS. 5 ZAWIASU
  N113 R46=0 ; LICZNIK ZAWIASOW
ENDIF

IF R10==2 ; 4 ZAWIASY ESTETIC 80
  N107 R40=4 ; 3XESTETIC80
  N108 R41=200 ; WYS. 1 ZAWIASU
  N109 R42=R7/3 ; WYS. 2 ZAWIASU
  N110 R43=R7-R7/3 ; WYS. 3 ZAWIASU
  N111 R44=R7-200 ; WYS. 4 ZAWIASU
  N112 R45=1000000000 ; WYS. 5 ZAWIASU
  N113 R46=0 ; LICZNIK ZAWIASOW
ENDIF

N101 R50=5 ; WARTOSC BEZPIECZNA NAD MATERIALEM
N102 R51=112.3+R17 ; DLUGOSC SZYLDU
N103 R52=29.6+R17 ; SZEROKOSC SZYLDU
;N104 R53=6.6 ; GLEBOKOSC SZYLDU
N105 R54=R51/2-R52/2-3 ; BEZPIECZNY WIAZD W MATERIAL
N106 R55=R51/2-R52/2 ; POLOWA DLUGOSCI SZYLDU BEZ LUKU

N107 R56=70.2 ; DLUGOSC KASETY
N108 R57=R52; 29.6+R17 ; SZEROKOSC KASETY
N109 R58=35 ; GLEBOKOSC KASETY
N110 R59=3 ; ILOSC POZIOMOW
N111 R60=R56/2-R57/2-3 ; BEZPIECZNY WIAZD W KASETE
N112 R61=R56/2-R57/2 ; POLOWA DLUGOSCI KASETY BEZ LUKU
N113 R62=0 ; LICZNIK POZIOMOW KASETY

N115 WECHSEL(4,3,18000)

N116 IF R0==1 GOTOF LEWE
N117 IF R0==2 GOTOF PRAWE
N118 MSG("BRAK OPCJI DLA TAKIEJ WARTOSCI R0")
N119 M0
N120 GOTOF KONIEC

N131 LEWE:

N122 G0 X=R41 Y=-30
GOTOF LEWE_ZAWIASY

N126 PRAWE:
;----------
N127 G0 X=R41 Y=R6+30
N130 GOTOF PRAWE_ZAWIASY


LEWE_ZAWIASY:

N123 TRAFAN
N124 B180 C0

N132 R46=R46+1
N133 IF R46==1
N134 TRANS X=R41 Y=0 Z=R15/2; 2.5; -((R15-R52)/2); R15-4-R52/2
N136 AROT X=90
N141 ZAW_CHOW
N142 TRAFO_OFF
N143 ENDIF

N144 IF R46==2
N145 TRANS X=R42 Y=0 Z=R15/2; 2.5; -(R15-R52)/2; R15-4-R52/2
N147 AROT X=90
N152 ZAW_CHOW
N153 TRAFO_OFF
N154 ENDIF

N155 IF R46==3
N156 TRANS X=R43 Y=0 Z=R15/2; 2.5; -(R15-R52)/2; R15-4-R52/2
N158 AROT X=90
N163 ZAW_CHOW
N164 TRAFO_OFF
N165 ENDIF

N166 IF R46==4
N167 TRANS X=R44 Y=0 Z=R15/2; -(R15-R52)/2; R15-4-R52/2
N169 AROT X=90
N174 ZAW_CHOW
N175 TRAFO_OFF
N176 ENDIF

N177 IF R46==5
N178 TRANS X=R45 Y=0 Z=R15-4-R52/2
N180 AROT X=90
N185 ZAW_CHOW
N186 TRAFO_OFF
N187 ENDIF

N188 IF R46==R40
N189 GOTOF ZAKONCZENIE
N190 ENDIF

N191 GOTOB LEWE_ZAWIASY

N192 ZAKONCZENIE:

N193 GOUP
N194 M17

N131 PRAWE_ZAWIASY:
N128 TRAFAN
N129 B180 C-180

N132 R46=R46+1

N133 IF R46==1
N134 TRANS X=R41 Y=R6 Z=R15/2; -(R15-R52)/2; R15-4-R52/2
N136 AROT X=-90
N141 ZAW_CHOW
N142 TRAFO_OFF
N143 ENDIF

N144 IF R46==2
N145 TRANS X=R42 Y=R6 Z=R15/2; -(R15-R52)/2; R15-4-R52/2
N147 AROT X=-90
N152 ZAW_CHOW
N153 TRAFO_OFF
N154 ENDIF

N155 IF R46==3
N156 TRANS X=R43 Y=R6 Z=R15/2; -(R15-R52)/2; R15-4-R52/2
N158 AROT X=-90
N163 ZAW_CHOW
N164 TRAFO_OFF
N165 ENDIF

N166 IF R46==4
N167 TRANS X=R44 Y=R6 Z=R15/2; -(R15-R52)/2; R15-4-R52/2
N169 AROT X=-90
N174 ZAW_CHOW
N175 TRAFO_OFF
N176 ENDIF

N177 IF R46==5
N178 TRANS X=R45 Y=R6 Z=R15-4-R52/2
N180 AROT X=-90
N185 ZAW_CHOW
N186 TRAFO_OFF
N187 ENDIF

N188 IF R46==R40
N189 GOTOF ZAKONCZENIE
N190 ENDIF

N191 GOTOB PRAWE_ZAWIASY

N192 ZAKONCZENIE:

N193 GOUP
N194 M17


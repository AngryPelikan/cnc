;AUSWERTZYKLUS ZUR FRÄSZEITBERECHNUNG
;ERSTELLT ANWENDUNGSTECHNIK REICHENBACHER 08.01.03 T. PICK
;ÜBER DAS MD 11420 LEN_PROTOCOL_FILE WIRD DIE MAXIMALE LÄNGE DER
;PROTOKOLLDATEIEN IN KBYTE EINGESTELLT.
N101 DEF INT ERROR,DEL_ERROR
N102 DEF REAL ZEIT[5]
N103 DEF STRING[30] DATUM,UHRZEIT,PFAD

N104 ZEIT[0]=$AC_TIMER[1]
N105 ZEIT[0]=(ZEIT[0]/60)
N106 ZEIT[0]=(ZEIT[0]/60)
N107 ZEIT[2]=TRUNC(ZEIT[0])   ;ZEIT[2]=STUNDEN AKT.
N108 ZEIT[1]=ZEIT[0]-ZEIT[2]
N109 ZEIT[1]=ZEIT[1]*60
N110 ZEIT[3]=TRUNC(ZEIT[1])   ;ZEIT[3]=MINUTEN AKT.
N111 ZEIT[4]=ZEIT[1]-ZEIT[3]
N112 ZEIT[4]=ZEIT[4]*60       ;ZEIT[4]=SEKUNDEN AKT.

N113 DATUM=$A_DAY<<"."<<$A_MONTH<<".200"<<$A_YEAR
N114 UHRZEIT=$A_HOUR<<":"<<$A_MINUTE
N115 PFAD="/_N_MPF_DIR/_N_ZEITPROT_MPF"

N116 WRITE(ERROR,PFAD," ")
N117 IF ERROR == 10 ;DIE DATEI IST VOLL UND WIRD GELÖSCHT
N118    DELETE(DEL_ERROR,PFAD)
N119    WRITE(ERROR,PFAD," ")
N120 ENDIF
N121 WRITE(ERROR,PFAD,"ZEITMESSUNG VOM PROGRAMM "<<$P_PROG[0])
N122 WRITE(ERROR,PFAD,""<<DATUM<<" "<<UHRZEIT<<" FRAESZEIT: "<<ZEIT[2]<<" ST, "<<ZEIT[3]<<" MIN, UND " <<ZEIT[4]<<" SEK")
N123 MSG("FRAESZEIT: "<<ZEIT[2]<<" STUNDEN, "<<ZEIT[3]<<" MINUTEN, UND " <<ZEIT[4]<<" SEKUNDEN ")
N124 M17


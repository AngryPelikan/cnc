PROC CYCLE801(REAL _SPCA,REAL _SPCO,REAL _STA,REAL _DIS1,REAL _DIS2,INT _NUM1,INT _NUM2,INT _VARI,INT _UMODE) SAVE DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.17 Sep 08, 2003
;Punktegitter
DEF INT _I1,_I2
DEF INT HMC,_SPIND,_H8
DEF REAL _DX,_DY
DEF REAL _X0,_Y0
DEF AXIS _XX,_YY
DEF REAL _X,_Y
DEF REAL _RICH[10]
DEF REAL _HH1,_HH2,_HH3,_HH4,_HH5,_FAK1
_XX=$P_AXN1 _YY=$P_AXN2 HMC=$P_MC
_DIS1=ABS(_DIS1)_DIS2=ABS(_DIS2) _NUM1=ABS(_NUM1) _NUM2=ABS(_NUM2)
_HH1=((_NUM1-1)*_DIS1)/2
_HH2=((_NUM2-1)*_DIS2)/2
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
_SPIND=ABS(_VARI) DIV 100
IF ((_SPIND<>2)AND(_SPIND<>0)) GOTOF _FEHL5
IF ((_VARI MOD 100)<>0) GOTOF _FEHL5
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF _FEHL5
IF (_NUM1==0) OR (_NUM2==0)
SETAL(62105)
M0
STOPRE
IF _NUM1==0
_NUM1=1
ENDIF
IF _NUM2==0
_NUM2=1
ENDIF
ENDIF
IF _SPIND==2
SBLOF
ST_CUST(_UMODE)
SBLON
ENDIF
ATRANS AX[_XX]=_SPCA AX[_YY]=_SPCO
AROT RPL=_STA
_X0=$AA_IW[_XX]
_Y0=$AA_IW[_YY]
IF _DIS1<=_DIS2
_RICH[0]=SET(_X0,_Y0,_NUM1,_NUM2,_DIS1,_DIS2,_HH1,_HH2,_X,_Y)
ELSE
_RICH[0]=SET(_Y0,_X0,_NUM2,_NUM1,_DIS2,_DIS1,_HH2,_HH1,_Y,_X)
ENDIF
FOR _I2=0 TO _RICH[3]-1
IF _RICH[7]>=_RICH[1]
_HH3=_I2*_RICH[5]
ELSE
_HH3=(_RICH[3]-_I2-1)*_RICH[5]
ENDIF
FOR _I1=0 TO _RICH[2]-1
_HH4=_I1*_RICH[4]
_HH5=(_RICH[2]-_I1-1)*_RICH[4]
IF (_I2 MOD 2)==0
IF _RICH[6]>=_RICH[0]
_RICH[8]=_HH4 _RICH[9]=_HH3
ELSE
_RICH[8]=_HH5 _RICH[9]=_HH3
ENDIF
ELSE
IF _RICH[6]>=_RICH[0]
_RICH[8]=_HH5 _RICH[9]=_HH3
ELSE
_RICH[8]=_HH4 _RICH[9]=_HH3
ENDIF
ENDIF
IF _DIS1<=_DIS2
_X=_RICH[8] _Y=_RICH[9]
ELSE
_X=_RICH[9] _Y=_RICH[8]
ENDIF
G0 G9 G40 G90 AX[_XX]=_X AX[_YY]=_Y
ENDFOR
_I1=0
ENDFOR
IF _SPIND==2
SBLOF
ST_CUST(_UMODE+1)
SBLON
ENDIF
RET
_FEHL5:STOPRE
N710 SETAL(61002)
RET
_FEHL12:STOPRE
N711 SETAL(61002)
RET

PROC POCKET3(REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _LENG,REAL _WID,REAL _CRAD,REAL _PA,REAL _PO,REAL _STA,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _CDIR,INT _VARI,REAL _MIDA,REAL _AP1,REAL _AP2,REAL _AD,REAL _RAD1,REAL _DP1,INT _UMODE) SAVE SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.22 Dec 18, 2003
;Neue Rechtecktasche
N10 DEF AXIS _X,_Y,_Z
N13 DEF BOOL _ZB[12],_SOWZ
DEF INT _MIRR=0
N15 DEF REAL _BRIX,_BRIY,_MP[2],_WZR,_H1,_H2,_H3,_H4,_H5,_AT,_GT,_ZT,_LINT,_WINT,_DPINT,_PEA[3,2],_ERI,_BRI,_RURA,_WZMF=1,_EINRAD=2,_ADZI,_SDZI=1,_FALI,CPA,CPO,_LENG1,_LINT1,_I11,_H15,_ZTP
N18 DEF INT _I1,_I2,_I3,_I4,_I14,_AZ,_AZB,_RFT,_SPIND,_H8
N19 DEF REAL _ZTSDIS, _H6, _H7
N20 DEF REAL _EPS=0.001
IF ($P_SIM==1) AND ($P_TOOL==0)
_SOWZ=TRUE
MSG("$80013")
T0
ELSE
_SOWZ=FALSE
ENDIF
N20 _X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 _WZR=$P_TOOLR _H1=$MN_SCALING_SYSTEM_IS_METRIC _I1=$P_GG[13]
IF(_I1>2) GOTOF _MY5316
IF (_H1-_I1)==-1 GOTOF _MY5316
IF _H1<>1
_WZR=_WZR*$MN_SCALING_VALUE_INCH
ELSE
_WZR=_WZR/$MN_SCALING_VALUE_INCH
ENDIF
_MY5316: _I1=$P_TOOL _FAL=ABS(_FAL) _CRAD=ABS(_CRAD) _FALD=ABS(_FALD)
IF ((_I1==0)OR(_WZR==0)) AND ($P_SIM==0) GOTOF _FEHL1 IF _WZR<0 GOTOF _FEHL9 IF (_CRAD>ABS(_WID)/2) OR (_CRAD>ABS(_LENG)/2) GOTOF _FEHL10
_SPIND=ABS(_VARI) DIV 100 _VARI=_VARI MOD 100
IF _SPIND>2 GOTOF _FEHL2
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF _FEHL2
_I2=ABS(_VARI) _I1=_I2 MOD 10 _I2=((_I2-_I1) DIV 10) MOD 10
_I11=_I1
IF (_I1<1)OR(_I1>2)OR(_I2<0)OR(_I2>3) GOTOF _FEHL2 IF (_CDIR<0)OR(_CDIR>3) GOTOF _FEHL6 IF _I2<1 GOTOF _MY1
_ZB[0]=1
IF _I2==1 GOTOF _MY1
_ZB[1]=1
IF _I2==2 GOTOF _MY1
_ZB[7]=1
_MY1:_I1=_I1-1
IF _SOWZ==TRUE
_ZB[2]=1
ELSE
_ZB[2]=_I1
ENDIF
IF _FAL<>0
_ZB[10]=1
ENDIF
IF _FALD<>0
_ZB[9]=1
ENDIF
IF ABS(_WID-_CRAD*2)<_EPS
_ZB[11]=1
ENDIF
IF (_RTP==_RFP)AND(_DP==_RFP) GOTOF _FEHL11 IF _RTP==_RFP GOTOF _MY52 IF (_RFP==_DP) GOTOF _MY52 IF ((_RFP-_DP)/ABS(_RFP-_DP))<>((_RTP-_RFP)/ABS(_RTP-_RFP)) GOTOF _FEHL11
_MY52:
IF _RFP-_DP<>0
_H1=_RFP-_DP
ELSE
_H1=_RTP-_DP
ENDIF
_RFT=ABS(_H1)/_H1 _DPINT=_DP
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF (_CDIR==0) OR (_CDIR==2) GOTOF _SPG1
_CDIR=_CDIR-1
GOTOF _SPG2
_SPG1: _CDIR=_CDIR+1
_SPG2:
ENDIF
IF(_RFT==-1)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_ACTFRAME[_Z,MI])
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF _CDIR==2 GOTOF _MY3 IF _CDIR<>3 GOTOF _MY2
_ZB[3]=1
GOTOF _MY3
_MY2:
IF $P_SMODE[0]==1
_H1=$P_SDIR[$P_MSNUM]
ELSE
_ZB[3]=1
SETAL(62101)
GOTOF _MY3
ENDIF
IF (_H1<3) OR (_H1>4) GOTOF _FEHL3
IF (_CDIR==0)AND(_H1==4) GOTOF _MY3 IF (_CDIR==1)AND(_H1==3) GOTOF _MY3
_ZB[3]=1
_MY3:
IF _SDIS<>0
_SDZI=_SDIS
ENDIF
_MP[0]=_PA _MP[1]=_PO
IF _ZSD[2]
_MP[0]=_MP[0]+_LENG/2 _MP[1]=_MP[1]+_WID/2
ENDIF
IF (_ZSD[3]) AND ($P_GG[15]==3)
_ZB[8]=1
ENDIF
IF _CRAD==0
_CRAD=0.001/_WZMF
ENDIF
_LINT=ABS(_LENG)/2 _WINT=ABS(_WID)/2 _ERI=_CRAD
_MY5:_I1=$P_GG[13]
IF(_I1==2)OR(_I1==4) GOTOF _MY51
_WZMF=$MN_SCALING_VALUE_INCH _EINRAD=_EINRAD/_WZMF
IF _SDIS<>0 GOTOF _MY51
_SDZI=_SDZI/_WZMF
_MY51:
IF _FALD>ABS(_RFP-_DP)
IF _ZSD[1]==1
_FALD=ABS(_RFP-_DP)
ELSE
_FALD=ABS(_RFP-_DP)+ABS(_SDIS)
ENDIF
ENDIF
IF _MID>ABS(_RFP-_DP)
IF _ZSD[1]==1
_MID=ABS(_RFP-_DP)
ELSE
_MID=ABS(_RFP-_DP)+ABS(_SDIS)
ENDIF
ENDIF
IF NOT (_ZB[2])
_LINT=_LINT-_FAL _WINT=_WINT-_FAL _ERI=_CRAD-_FAL _DPINT=_DP+_RFT*_FALD _ADZI=ABS(_RFP-_DPINT)-ABS(_AD)
IF _ADZI<0
_ADZI=0
ENDIF
ELSE
IF NOT _FAL
IF _MIDA
_FAL=_MIDA
ELSE
_FAL=1.6*_WZR
ENDIF
ENDIF
IF NOT _FALD
IF _MID
_FALD=_MID
ELSE
IF ABS(_RFP-_DP)>2/_WZMF
_FALD=2/_WZMF
ELSE
_FALD=ABS(_RFP-_DP)
ENDIF
ENDIF
ENDIF
ENDIF
IF (_WZR>_LINT) OR(_WZR>_WINT) GOTOF _FEHL4 IF _ERI>=_WZR GOTOF _MY55
_ERI=_WZR
_MY55:
IF (_AP1<=0)OR(_AP1/2<_WZR)OR(_AP2/2<_WZR)OR(_AP2<=0)OR(_AD<=0)
_ZB[6]=1
ENDIF
IF _SPIND==2
ST_CUST(_UMODE)
ENDIF
IF ((((_WINT<=2*_WZR) AND (ABS(_CRAD-_WINT)<_EPS)) OR ((_LINT<=2*_WZR) AND (ABS(_CRAD-_LINT)<_EPS))) AND ((_MIDA>=_CRAD) OR ((_VARI MOD 10)==2))) OR (ABS(_WINT-_WZR)<_EPS) OR (ABS(_LINT-_WZR)<_EPS)
ATRANS AX[_X]=_MP[0] AX[_Y]=_MP[1]
IF(ABS(_LINT-_WZR)<_EPS) OR (ABS(_WINT-_WZR)<_EPS)
IF(ABS(_LINT-_WZR)<_EPS)
_LENG=_WID CPO=0 CPA=-_WINT
AROT RPL=_STA+90
ELSE
CPA=-_LINT CPO=0
AROT RPL=_STA
ENDIF
IF(_I11==1) AND (_ZB[9]==1)
_DP=_DP+_FALD
ENDIF
IF _I2==2
_I2=3
ENDIF
IF _SPIND==1
_I2=_I2+100
ENDIF
LONGHOLE(_RTP,_RFP,_SDIS,_DP,,1,_LENG,CPA,CPO,0,0,0,_FFD,_FFP1,_MID,_I2,_UMODE)
ELSE
IF(_WID>_LENG)
_LENG1=_LENG _LINT1=_LINT _LENG=_WID _WID=_LENG1 _LINT=_WINT _WINT=_LINT1
AROT RPL=_STA+90
ELSE
AROT RPL=_STA
ENDIF
CPA=-_LINT CPO=0
IF _SPIND==1
_I2=_I2+100
ENDIF
SLOT1(_RTP,_RFP,_SDIS,_DP,0,1,_LENG,_WID,CPA,CPO,0,0,0,_FFD,_FFP1,_MID,_CDIR,_FAL,_VARI,0,0,0,_FALD,_RAD1,_DP1,_UMODE)
ENDIF
ATRANS AX[_X]=-_MP[0] AX[_Y]=-_MP[1]
GOTOF _RET
ENDIF
IF (_MIDA>2*_WZR) AND ($P_SIM==0)
IF NOT( (_ZB[2]==1) AND (_ZB[9]==0) AND (_ZB[10]==1) )
GOTOF _FEHL8
ENDIF
ENDIF
IF((_SPIND==1)AND(_I2>1)AND(_ZB[2]==0)) GOTOF _FEHL2
_MY61:_GT=ABS(_RFP-_DPINT) _AZ=1
IF _ZSD[1] GOTOF _MQ1
_GT=_GT+ABS(_SDIS)
_MQ1:IF (_MID==0)OR(_GT==0) GOTOF _MQ2
_AZ=TRUNC(_GT/_MID)
IF _MID*_AZ==_GT GOTOF _MQ2
_AZ=_AZ+1
_MQ2:_ZT=_GT/_AZ _ZT=_ZT*_RFT
N100 _WKSNEU:ATRANS AX[_X]=_MP[0] AX[_Y]=_MP[1]
IF _WINT<=_LINT
N105 AROT RPL=_STA
ELSE
N105 AROT RPL=_STA+90
_H1=_AP1 _AP1=_AP2 _AP2=_H1 _H1=_WINT _WINT=_LINT _LINT=_H1
ENDIF
_I1=1
SBLON
N110 G0 G90 AX[_Z]=_RTP
N120 NORM DIAMOF CFTCP AX[_X]=0 AX[_Y]=0
N130 AX[_Z]=_RFP+_RFT*_SDIS
SBLOF
IF (_ERI-_WZR)<_EINRAD
_EINRAD=(_ERI-_WZR)
ENDIF
IF (_ZB[2]) AND (_SOWZ==TRUE) GOTOF _MSL1
IF (_ZB[2]) AND (_AZ<>1) GOTOF _MSL1
IF (_ZB[2]) AND (_ZB[9]==0) GOTOF _MSL1
IF _ZB[2] GOTOF _SCHLICHTEND
_BRI=_MIDA _H2=_WZR+_EINRAD _PEA[2,0]=_LINT-_H2 _PEA[2,1]=-_I3*_H2
IF _MIDA==0
_BRI=_WZR*1.6
ENDIF
_NXTIEF:_AT=_DPINT+((_AZ-_I1)*_ZT)
IF _AZ>1
IF _ZB[2]==0
IF(_I1==1)
WRTPR("TMP_BLK_BEG()",1)
ENDIF
IF(_I1==_AZ)
WRTPR("TMP_BLK_END()",1)
ENDIF
ENDIF
ENDIF
IF _ZB[6] GOTOF _SRV IF ABS(_AT-_DPINT)>_ADZI GOTOF _SRROH
_ZB[6]=1
N700 G0 G90 AX[_X]=0 AX[_Y]=0
GOTOF _SRV
_SRROH:_H1=_LINT-_AP1/2
IF _H1<0
_H1=0 _AP1=_LINT*2
ENDIF
IF _H1<_WINT-_AP2/2
_H1=_WINT-_AP2/2
ELSE
IF _WINT-_AP2/2<0
_AP2=_WINT*2
ENDIF
ENDIF
_SRR1:IF NOT _H1 GOTOF _END1
_AZB=TRUNC(_H1/_BRI) _I3=1
IF _BRI*_AZB==_H1 GOTOF _MY90
_AZB=_AZB+1
_MY90:_I2=1 _BRIX=(_LINT-_AP1/2)/_AZB _BRIY=(_WINT-_AP2/2)/_AZB _BRI=_H1/_AZB _H2=_WZR+_EINRAD
IF NOT(_ZB[3]) GOTOF _MY92
_I3=-1
_MY92:_PEA[0,0]=_AP1/2 _PEA[0,1]=0 _PEA[1,0]=_PEA[0,0]-_H2 _PEA[1,1]=_PEA[0,1]+_I3*_H2
_PEA[2,0]=_LINT-_H2 _PEA[2,1]=_PEA[0,1]-_I3*_H2
IF NOT(_ZB[3])
SBLON
N400 G0 G42 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
N403 G0 AX[_Z]=_AT+_RFT*_SDZI
SBLOF
IF NOT(_ZSD[3])
N405 G1 F=_FFD AX[_Z]=_AT
N408 G2 G64 F=_FFP1 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ELSE
IF _ZB[8]
N405 G1 G94 F=_FFD AX[_Z]=_AT
N408 G2 G64 G95 F=_FFP1 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ELSE
N405 G1 G95 F=_FFD AX[_Z]=_AT
N408 G2 G64 G94 F=_FFP1 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ENDIF
ENDIF
ELSE
SBLON
N400 G0 G41 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
N403 G0 AX[_Z]=_AT+_RFT*_SDZI
SBLOF
IF NOT(_ZSD[3])
N405 G1 F=_FFD AX[_Z]=_AT
N408 G3 G64 F=_FFP1 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ELSE
IF _ZB[8]
N405 G1 G94 F=_FFD AX[_Z]=_AT
N408 G3 G64 G95 F=_FFP1 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ELSE
N405 G1 G95 F=_FFD AX[_Z]=_AT
N408 G3 G64 G94 F=_FFP1 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ENDIF
ENDIF
ENDIF
_NXRU:
_RURA=_ERI-_BRI*(_AZB+1-_I2)
IF _RURA<=_WZR+0.001/_WZMF
_RURA=0
ENDIF
IF (_ZB[11]==1) AND (_I2>_AZB)
IF _RURA<>0
N410 G1 AX[_Y]=0 RND=_RURA
N412 AX[_Y]=-_I3*(_AP2/2+_BRIY*(_I2-1)) G91 AX[_X]=-_BRIY RND=_RURA
N415 G90 AX[_X]=-_AP1/2-_BRIX*(_I2-1) RND=_RURA
N420 AX[_Y]=_I3*(_AP2/2+_BRIY*(_I2-1)) RND=_RURA
ENDIF
ELSE
IF _RURA<>0
N410 G1 AX[_Y]=-_I3*(_AP2/2+_BRIY*(_I2-1)) RND=_RURA
N415 AX[_X]=-_AP1/2-_BRIX*(_I2-1) RND=_RURA
N420 AX[_Y]=_I3*(_AP2/2+_BRIY*(_I2-1)) RND=_RURA
ELSE
N410 G1 AX[_Y]=-_I3*(_AP2/2+_BRIY*(_I2-1))
N415 AX[_X]=-_AP1/2-_BRIX*(_I2-1)
N420 AX[_Y]=_I3*(_AP2/2+_BRIY*(_I2-1))
ENDIF
ENDIF
IF _I2<=_AZB GOTOF _NRU
IF _RURA<>0
N425 AX[_X]=_LINT RND=_RURA
ELSE
N425 AX[_X]=_LINT
ENDIF
N427 G1 AX[_Y]=0
IF NOT(_ZB[3])
N430 G2 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_H2
ELSE
N430 G3 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_H2
ENDIF
N431 G1 G40 AX[_X]=_PEA[2,0] AX[_Y]=-_I3*(_H2-_WZR)
SBLON
N433 G0 G91 AX[_Z]=_RFT*_SDZI
SBLOF
N435 G90 G40 AX[_X]=_PEA[1,0] AX[_Y]=0
GOTOF _END1
_NRU:
_RURA=_ERI-_BRI*(_AZB-_I2)
IF _RURA<=_WZR+0.001/_WZMF
_RURA=0
ENDIF
IF _RURA<>0
N440 AX[_X]=_AP1/2+_I2*_BRIX RND=_RURA
ELSE
N440 AX[_X]=_AP1/2+_I2*_BRIX
ENDIF
_I2=_I2+1
GOTOB _NXRU
_SRV:_H1=_WINT-_WZR
IF _MIDA
_BRI=_MIDA
ELSE
_BRI=_WZR*1.6
ENDIF
_AZB=TRUNC(_H1/_BRI) _I3=-1
IF _BRI*_AZB<>_H1
_AZB=_AZB+1
ENDIF
_BRI=_H1/_AZB _I2=1 _RURA=0 _H3=(_AZB-1)*_BRI
IF _ZB[3] GOTOF _MY84
_I3=1
_MY84:
IF _ZB[1] GOTOF _ZUBAHN
IF ((_SPIND==1)AND(_ZB[2]==0))
ST_CUST(_UMODE)
ENDIF
IF _ZB[2] GOTOF _ZBG1 IF _ZB[0] GOTOF _ZBG1
SBLON
N150 G0 AX[_Z]=_AT+_RFT*_SDZI
SBLOF
_ZBG1:
IF NOT(_ZSD[3])
F=_FFD
ELSE
IF _ZB[8]
G94 F=_FFD
ELSE
G95 F=_FFD
ENDIF
ENDIF
N152 G1 AX[_Z]=_AT
IF ((_SPIND==1)AND(_ZB[2]==0))
ST_CUST(_UMODE+1)
ENDIF
GOTOF _SEB
_ZUBAHN:
IF (_ZSD[1]==0)
_ZTSDIS=ABS(_ZT)
ELSE
_ZTSDIS=ABS(_ZT)+_SDIS
ENDIF
IF (_RAD1<=0) GOTOF _FEHL5 IF _ZB[7] GOTOF _ZPEN IF (_DP1<=0) GOTOF _FEHL5 IF ABS(_ZTSDIS)>=ABS(_DP1) GOTOF _MQ34
_I4=1
GOTOF _HELRAD
_MQ34:
IF(_ZSD[1]==1)
_I4=TRUNC(ABS(_ZT)/_DP1)
IF((_DP1*_I4)<>_ZT)
_I4=_I4+1
ENDIF
ELSE
_I4=TRUNC(ABS(_ZTSDIS)/_DP1)
IF((_DP1*_I4)<>_ZTSDIS)
_I4=_I4+1
ENDIF
ENDIF
_HELRAD:_H4=_RAD1
IF _RAD1<_WZR GOTOF _FALL2
_H4=_WZR
_FALL2:IF _H4+_WZR<_WINT GOTOF _FALL3
_H4=_WINT-_WZR
IF _H4==0 GOTOF _FEHL4
GOTOF _HELBAHN
_FALL3: IF _H4==_RAD1 GOTOF _HELBAHN
_FALL3NEU: IF ABS(_ZT)/_I4/_H4<_DP1/_RAD1 GOTOF _HELBAHN
_I4=_I4+1
GOTOB _FALL3NEU
_HELBAHN:
N150 G0 G40 G90 AX[_X]=_H4
IF NOT(_ZSD[3])
F=_FFD
ELSE
IF _ZB[8]
G94 F=_FFD
ELSE
G95 F=_FFD
ENDIF
ENDIF
IF(_I1>1)
N160 G0 G64 G91 AX[_Z]=-_RFT*_SDZI
ENDIF
IF((_ZSD[1]==1) AND (_I1==1))
IF(_SDIS<>0)
_I14=TRUNC(ABS(_SDIS)/_DP1)
IF((_DP1*_I14)<>_SDIS)
_I14=_I14+1
ENDIF
IF NOT(_ZB[3])
N1160 G91 G2 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=-_SDIS IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I14-1
ELSE
N1160 G91 G3 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=-_SDIS IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I14-1
ENDIF
ENDIF
ENDIF
IF NOT(_ZB[3])
N170 G91 G2 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=-_ZT IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I4-1
ELSE
N170 G91 G3 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=-_ZT IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I4-1
ENDIF
N190 G91 AX[_X]=0 AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N195 G1 G90 AX[_X]=0
GOTOF _SEB
_ZPEN:_I3=1 _H4=_LINT-_WINT
IF _H4<_BRI
_H4=_BRI
ENDIF
_H5=ABS(TAN(_RAD1))*2*_H4
IF ABS(_ZT)>ABS(_H5) GOTOF _ZP05
_I4=1
GOTOF _ZP10
_ZP05:_I4=TRUNC(ABS(_ZT)/_H5)
IF _H5*_I4==ABS(_ZT) GOTOF _ZP10
_I4=_I4+1
_ZP10:_H5=_ZT/_I4
IF (_I4 MOD 2)<>1
N150 G0 G90 AX[_X]=-_H4
ELSE
N150 G0 G90 AX[_X]=_H4
_I3=-_I3
ENDIF
IF NOT(_ZSD[3])
F=_FFD
ELSE
IF _ZB[8]
G94 F=_FFD
ELSE
G95 F=_FFD
ENDIF
ENDIF
IF((_ZSD[1]==1) AND (_I1==1))
_H15=ABS(TAN(_RAD1))*2*_H4
_ZTP=_SDZI+_ZT
IF ABS(_ZTP)>ABS(_H15) GOTOF _ZPP05
_I14=1
GOTOF _ZPP10
_ZPP05:_I14=TRUNC(ABS(_ZTP)/_H15)
IF _H15*_I14==ABS(_ZT) GOTOF _ZPP10
_I14=_I14+1
_ZPP10:_H15=_ZTP/_I14
_ZPPNEXT:
N1161 G1 G91 F=_FFD AX[_X]=_I3*_H4*2 AX[_Z]=-_H15
_I3=-_I3 _I14=_I14-1
IF _I14>0 GOTOB _ZPPNEXT
ENDIF
IF(_I1>1)
N1162 G0 G64 G91 AX[_Z]=-_RFT*_SDZI
ENDIF
IF((_ZSD[1]==1) AND (_I1==1)) GOTOF _M6201
_ZPNEXT: _H6=_AT+_H5*(_I4-1) _H7=$P_EP[_X]+_I3*_H4*2
IF(_VARI MOD 10==2)
N161 G1 G90 F=_FFP1 AX[_X]=_H7 AX[_Z]=_H6
ELSE
N161 G1 G90 F=_FFP1 AX[_X]=_H7 AX[_Z]=_H6
ENDIF
_I3=-_I3 _I4=_I4-1
IF _I4>0 GOTOB _ZPNEXT
_M6201:
IF (_ZB[3])
_I3=-1
ELSE
_I3=1
ENDIF
_SEB:
IF NOT(_ZSD[3])
F=_FFP1
ELSE
IF _ZB[8]
G95 F=_FFP1
ELSE
G94 F=_FFP1
ENDIF
ENDIF
N304 _SEB0: G1 G64 G40 G90 AX[_X]=-_LINT+_WINT
_H4=_LINT-_WINT
IF _ZB[3] GOTOF _ANFG3
IF _RURA<>0
N305 G1 G42 G64 AX[_X]=_LINT-_H3 RND=_RURA
ELSE
N305 G1 G42 G64 AX[_X]=_LINT-_H3
ENDIF
GOTOF _NXR
_ANFG3:
IF _RURA<>0
N305 G1 G41 G64 AX[_X]=_LINT-_H3 RND=_RURA
ELSE
N305 G1 G41 G64 AX[_X]=_LINT-_H3
ENDIF
_NXR:_H1=_H1-_BRI _RURA=_ERI-_H1
IF (_RURA<_WZR+0.001/_WZMF) OR ( (_RURA>(_I2*_BRI+_WZR)) AND (_ZB[11]==0) )
_RURA=0
ENDIF
IF (_I2==_AZB) AND (_ZB[2])
CFC
ENDIF
IF _RURA<>0
N310 AX[_Y]=-_I3*(_I2*_BRI+_WZR) RND=_RURA
N315 AX[_X]=-(_LINT-(_AZB-_I2)*_BRI) RND=_RURA
N320 AX[_Y]=_I3*(_I2*_BRI+_WZR) RND=_RURA
ELSE
N310 AX[_Y]=-_I3*(_I2*_BRI+_WZR)
N315 AX[_X]=-(_LINT-(_AZB-_I2)*_BRI)
N320 AX[_Y]=_I3*(_I2*_BRI+_WZR)
ENDIF
IF _I2==_AZB GOTOF _LRU IF (_ERI-_H1+_BRI)>(_I2*_BRI+_WZR) GOTOF _NX1 IF (_ERI-_H1+_BRI)<(_WZR+0.001/_WZMF) GOTOF _NX1
_RURA=_ERI-_H1+_BRI
_NX1:
IF _RURA<>0
N330 AX[_X]=_LINT-(_AZB-_I2-1)*_BRI RND=_RURA
ELSE
N330 AX[_X]=_LINT-(_AZB-_I2-1)*_BRI
ENDIF
_I2=_I2+1
IF _I2<=_AZB GOTOB _NXR
_LRU:
IF _RURA<>0
N340 AX[_X]=_LINT RND=_RURA
ELSE
N340 AX[_X]=_LINT
ENDIF
N345 AX[_Y]=0
IF NOT(_ZB[3])
N346 G2 AX[_X]=_PEA[2,0] AX[_Y]=-_I3*_H2 CR=_H2
ELSE
N346 G3 AX[_X]=_PEA[2,0] AX[_Y]=-_I3*_H2 CR=_H2
ENDIF
N347 G1 G40 AX[_X]=_PEA[2,0] AX[_Y]=-_I3*(_H2-_WZR)
IF (_AZ==1)OR (_I1==_AZ) GOTOF _FINE
SBLON
N348 G0 G91 AX[_Z]=_RFT*_SDZI
SBLOF
IF _ZB[1]==0
N350 G0 G90 G40 AX[_X]=0 AX[_Y]=0
ELSE
N350 G0 G90 G40 AX[_X]=_H4 AX[_Y]=0
ENDIF
_END1:_I1=_I1+1
IF (_ZB[2]) AND (_ZB[10]==0) GOTOF _FINE IF _I1<=_AZ GOTOB _NXTIEF
GOTOF _FINE
_MSL1:IF (_FALD>_MID) AND (_SOWZ==FALSE) GOTOF _FEHL7
IF (_ERI-_WZR)>=_EINRAD GOTOF _MY74
_EINRAD=(_ERI-_WZR)
_MY74:_H1=1
IF NOT _ZB[3] GOTOF _MSL3
_H1=-1
_MSL3:_H2=_WZR+_FAL+_EINRAD _PEA[0,0]=_H1*(_LINT-_ERI) _PEA[0,1]=_WINT _I3=0
IF (_H2<_WINT) GOTOF _MSL31
_H2=_WINT
_MSL31:IF (_LINT-_H2>_FAL) AND (_WINT-_H2>_FAL) GOTOF _MSL4
_I3=1
_MSL4:
IF _ERI>_H2
_PEA[1,0]=_PEA[0,0]-_H1*_ERI _PEA[1,1]=_PEA[0,1]-_ERI
ELSE
_PEA[1,0]=_PEA[0,0]-_H1*_H2 _PEA[1,1]=_PEA[0,1]-_H2
ENDIF
_H5=_WZR+_EINRAD
IF NOT (_H5<_ERI)
_H5=_ERI
ENDIF
_PEA[2,0]=_PEA[0,0]+_H1*_H5 _PEA[2,1]=_PEA[0,1]-_H5
_ANFSZ:_AT=_DPINT+(_AZ-_I1)*_ZT
IF _ZB[10]==0
_AT=_DPINT _ZT=_ZT*_AZ
GOTOF _SCHLICHTEND
ENDIF
N529 CFC
IF (_ZB[2]) AND (_ZB[9]==0) GOTOF _ANFSZ1
IF (ABS(_AT-_DPINT)>=_FALD) GOTOF _ANFSZ1
_AT=_DPINT+_FALD*_RFT _ZT=_FALD*_RFT
_ANFSZ1:
IF _SOWZ==TRUE
_AT=_DPINT
ENDIF
IF NOT(_ZB[0]) AND (_I3==0) AND (_AT-_DPINT<>_FALD)
N520 G90 G0 AX[_Z]=_AT
ELSE
IF NOT(_ZSD[3])
F=_FFD
ELSE
IF _ZB[8]
G94 F=_FFD
ELSE
G95 F=_FFD
ENDIF
ENDIF
N521 G90 G1 AX[_Z]=_AT
ENDIF
IF NOT(_ZSD[3])
F=_FFP1
ELSE
IF _ZB[8]
G95 F=_FFP1
ELSE
G94 F=_FFP1
ENDIF
ENDIF
IF NOT(_ZB[3])
N530 G1 G64 G42 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
IF _H2<_ERI
N535 G2 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_ERI
ELSE
N535 G2 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ENDIF
N540 G2 G91 AX[_X]=_ERI AX[_Y]=-_ERI CR=_ERI
N545 G1 AX[_Y]=-2*(_WINT-_ERI)
N550 G2 AX[_X]=-_ERI AX[_Y]=-_ERI CR=_ERI
N555 G1 AX[_X]=-2*(_LINT-_ERI)
N560 G2 AX[_X]=-_ERI AX[_Y]=_ERI CR=_ERI
N565 G1 AX[_Y]=2*(_WINT-_ERI)
N570 G2 AX[_X]=_ERI AX[_Y]=_ERI CR=_ERI
N575 G1 AX[_X]=2*(_LINT-_ERI)
IF _H5<_ERI
N580 G2 G90 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_ERI
ELSE
N580 G2 G90 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_H5
ENDIF
ELSE
N530 G1 G64 G41 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
IF _H2<_ERI
N535 G3 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_ERI
ELSE
N535 G3 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ENDIF
N540 G3 G91 AX[_X]=-_ERI AX[_Y]=-_ERI CR=_ERI
N545 G1 AX[_Y]=-2*(_WINT-_ERI)
N550 G3 AX[_X]=_ERI AX[_Y]=-_ERI CR=_ERI
N555 G1 AX[_X]=2*(_LINT-_ERI)
N560 G3 AX[_X]=_ERI AX[_Y]=_ERI CR=_ERI
N565 G1 AX[_Y]=2*(_WINT-_ERI)
N570 G3 AX[_X]=-_ERI AX[_Y]=_ERI CR=_ERI
N575 G1 AX[_X]=-2*(_LINT-_ERI)
IF _H5<_ERI
N580 G3 G90 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_ERI
ELSE
N580 G3 G90 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_H5
ENDIF
ENDIF
SBLON
N585 G0 G91 AX[_Z]=_RFT*_SDZI
SBLOF
N590 G0 G90 G40 AX[_X]=_PEA[1,0]+_WZR*_H1 AX[_Y]=_PEA[1,1]
_I1=_I1+1
IF _SOWZ==TRUE GOTOF _FINE
IF _I1<_AZ GOTOB _ANFSZ
IF (_I1==_AZ) AND (_ZB[9]==0)
_AT=_DP
GOTOB _ANFSZ1
ENDIF
IF (_I1>_AZ) AND (_ZB[9]==0) GOTOF _FINE
SBLON
N600 G0 G40 G90 CFTCP AX[_X]=0 AX[_Y]=0
SBLOF
_AT=_DPINT _PEA[2,0]=_LINT-_H2
_SCHLICHTEND:
IF _AZ==1
_AT=_DPINT _ZT=_FALD
SBLON
N610 G0 AX[_Z]=_AT+(_FALD+_SDZI)*_RFT
SBLOF
ENDIF
_SCHL1:_H2=_WZR+_EINRAD _PEA[2,0]=_LINT-_H2 _PEA[2,1]=-_I3*_H2
GOTOB _SRV
_FINE:
SBLON
N900 G0 G90 AX[_Z]=_RTP
IF ((_ZB[2]) AND (_ZB[9]==0))
N910 G40 G90 AX[_X]=0 AX[_Y]=0
ENDIF
_RET:
IF ($P_SIM==1) AND ($P_TOOL==0)
MSG("")
ENDIF
SBLON
IF _SPIND==2
SBLOF
ST_CUST(_UMODE+1)
SBLON
ENDIF
WRTPR("TMP_BLK_DEL()",1)
RET

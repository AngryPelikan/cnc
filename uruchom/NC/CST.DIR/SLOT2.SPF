PROC SLOT2(REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,INT NUM,REAL AFSL,REAL WID,REAL CPA,REAL CPO,REAL RAD,REAL STA1,REAL INDA,REAL FFD,REAL FFP1,REAL MID,INT CDIR,REAL FAL,INT VARI,REAL MIDF,REAL FFP2,REAL SSF,REAL _FFCP,INT _UMODE) SAVE SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.17 Sep 08, 2003
;Kreisnut
N10 DEF AXIS _X,_Y,_Z
N12 DEF REAL HH1,HH2,HH3,HH4,HH5,HH6,HH7,HH8,HH9,HH10,WZR,HHS,HHF,HHF1,_SDZI,_RFT,_WZMF=1
N14 DEF INT HZ1,HZ2,HZ3,HZ4,_POS,_SPIND,_H8
N24 DEF BOOL SOWZ,_H9,_H10,_H11
N24 DEF BOOL _MDG
DEF INT _MIRR=0
_X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 SDIS=ABS(SDIS) DPR=ABS(DPR) AFSL=ABS(AFSL) WID=ABS(WID)
_SPIND=ABS(VARI) DIV 100 VARI=VARI MOD 100
IF _SPIND>2 GOTOF FEHL5
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF FEHL5
_POS=ABS(VARI) DIV 10
IF _POS>1 GOTOF FEHL5
VARI=VARI MOD 10
IF _ZSD[1]==0
_SDZI=SDIS
ENDIF
IF ($P_SIM==1) AND ($P_TOOL==0)
SOWZ=TRUE
MSG("$80013")
T0
VARI=3 _MDG=1
ELSE
SOWZ=FALSE
ENDIF
RAD=ABS(RAD) NUM=ABS(NUM) MID=ABS(MID) MIDF=ABS(MIDF) VARI=ABS(VARI) INDA=ABS(INDA) HH6=STA1 HH10=1
IF ($P_TOOL==0)AND ($P_SIM==0) GOTOF FEHL6 IF VARI>3 GOTOF FEHL5 IF NUM==0 GOTOF FEHL2 IF VARI<2 GOTOF _MMA IF FAL GOTOF _MMA
FAL=WID
_MMA:
IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM03 IF DP==HH2 GOTOF _MM1A
N30 MSG("$80000")
_MDG=1
_MM03:DP=HH2
GOTOF _MM1A
_MM1:DPR=ABS(RFP-DP)
_MM1A:IF RFP==DP GOTOF _MM8 IF INDA<>0 GOTOF _MM1B
INDA=360/NUM
GOTOF _MM1C
_MM1B:HH1=INDA*(NUM-1)+AFSL
IF (NUM>1)AND(AFSL>INDA) GOTOF FEHL3
IF HH1>360 GOTOF FEHL2
IF(NUM<>1)
IF ABS(SIN(HH1 /2))*RAD<=WID/2
GOTOF FEHL3
ENDIF
ENDIF
_MM1C:
_RFT=(RFP-DP)/DPR
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF CDIR==2
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
IF(_RFT==-1)
IF(CDIR==2)
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
IF($P_ACTFRAME[_Z,MI])
IF(CDIR==2)
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
IF CDIR==2 GOTOF _MM00
HH10=-1
IF CDIR==3 GOTOF _MM00
N20 MSG("$80001")
CDIR=3 _MDG=1
_MM00:IF FFP2 GOTOF _MM01
FFP2=FFP1
_MM01:IF SSF<0 GOTOF _M01
HHS=$P_S[0]
_M01:IF SSF>0 GOTOF _MM02
SSF=HHS
_MM02:
IF(NUM<>1)
IF ABS(SIN((INDA-AFSL)/2))*RAD<=WID/2
GOTOF FEHL3
ENDIF
ENDIF
WZR=$P_TOOLR HHF=$P_F
IF MIDF GOTOF _MM1D
MIDF=_SDZI+DPR
_MM1D:IF RTP==RFP GOTOF _MM2 IF (RTP-RFP)/ABS(RTP-RFP)<>(RFP-DP)/DPR GOTOF FEHL1
_MM2:HZ1=$MN_SCALING_SYSTEM_IS_METRIC HZ2=$P_GG[13]
IF(HZ2>2) GOTOF _MM3
IF ((HZ1)AND(HZ2==2))OR((HZ1==0)AND(HZ2<>2)) GOTOF _MM3
_WZMF=$MN_SCALING_VALUE_INCH
IF HZ1 GOTOF _MM2A
WZR=WZR*_WZMF
GOTOF _MM3
_MM2A:WZR=WZR/_WZMF
_MM3:WZR=WZR/$P_ACTFRAME[_X,SC]
IF((VARI==2)OR(VARI==0))
IF(WID<(WZR*2))
GOTOF FEHL4
ENDIF
IF(WID>(WZR*4))
GOTOF FEHL7
ENDIF
ELSE
IF(VARI==1)
IF((WID-2*FAL)<(WZR*2))
GOTOF FEHL4
ENDIF
IF((WID-2*FAL)>(WZR*4))
GOTOF FEHL7
ENDIF
ELSE
IF(WID<(WZR*2))
GOTOF FEHL4
ENDIF
ENDIF
ENDIF
;
IF ((_SPIND==2)AND(_H11==0))
ST_CUST(_UMODE)
_H11=1
ENDIF
N100 ATRANS AX[_X]=CPA AX[_Y]=CPO
HH4=COS(AFSL) HH5=SIN(AFSL)
IF MID GOTOF _MM4A
MID=_SDZI+DPR
_MM4A:HZ1=(_SDZI+DPR)/MID+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1 HH3=WID/2-FAL HHF1=FFP1
IF HH3>WZR GOTOF _MM5
FAL=WID/2-WZR HH3=WZR
_MM5:HH9=HH3 HH8=0
IF SOWZ==TRUE GOTOF _MM6
N110 MSG("$80008")
_MDG=1
N120 _MM6:AROT AX[_Z]=HH6
IF((_POS==0)OR(HZ3==0))
N130 G0 G40 G60 G90 CFTCP AX[_X]=RAD AX[_Y]=0
ELSE
N130 G3 G40 G60 G90 CFTCP CR=RAD AX[_X]=RAD AX[_Y]=0 F=_FFCP
ENDIF
SBLON
IF ((_SPIND==1)AND(VARI<2))
ST_CUST(_UMODE)
_H9=1
ENDIF
N140 G0 G64 AX[_Z]=RFP+SDIS*_RFT
SBLOF
IF ((VARI==2)OR(VARI==3)) GOTOF _MS1
_MM7:
IF HZ1>1
IF(HZ2==1)
WRTPR("TMP_BLK_BEG()",1)
ENDIF
IF(HZ2==HZ1)
WRTPR("TMP_BLK_END()",1)
ENDIF
ENDIF
IF ((_H9==0)AND(_H10==0))
IF ((_SPIND==1)AND(VARI<2))
ST_CUST(_UMODE)
ENDIF
ENDIF
_H9=0
IF SOWZ==TRUE
HZ2=HZ1
ENDIF
SBLON
G0 AX[_Z]=IC(0)
SBLOF
N150 G1 G90 G60 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*_RFT
IF _H10==0
IF ((_SPIND==1)AND(VARI<2))
ST_CUST(_UMODE+1)
ENDIF
ENDIF
IF HH3>WZR GOTOF _MG0 IF HH7 GOTOF _MM7B
N150 G3 AX[_X]=RAD*HH4 AX[_Y]=RAD*HH5 IP[_X]=AC(0)IP[_Y]=AC(0) F=HHF1
HH7=1
GOTOF _MM7A
N160 _MM7B:G2 AX[_X]=RAD AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0) F=HHF1
HH7=0
_MM7A:HZ2=HZ2+1
IF SOWZ==TRUE GOTOF _MS0
IF HZ2 <= HZ1 GOTOB _MM7
GOTOF _MS0
_MG0:IF (CDIR==2) AND (HH7==0) OR (CDIR==3) AND (HH7) GOTOF _MG2
N300 _MG1:G1 G41 NORM G64 AX[_X]=RAD+HH8 AX[_Y]=HH9 F=HHF1
N310 G3 AX[_X]=RAD+HH3 AX[_Y]=0 IP[_X]=AC(RAD) IP[_Y]=AC(0)
N320 G3 AX[_X]=(RAD+HH3)*HH4 AX[_Y]=(RAD+HH3)*HH5 IP[_X]=AC(0) IP[_Y]=AC(0)
N330 G3 AX[_X]=(RAD-HH3)*HH4 AX[_Y]=(RAD-HH3)*HH5 IP[_X]=AC(RAD*HH4) IP[_Y]=AC(RAD*HH5)
N340 G2 AX[_X]=RAD-HH3 AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N350 G3 AX[_X]=RAD-HH3+(WZR+4*HH3)/5 AX[_Y]=-(WZR+4*HH3)/5 IP[_X]=AC(RAD-HH3+(WZR+4*HH3)/5) IP[_Y]=AC(0)
N360 G1 G40 G60 AX[_X]=RAD AX[_Y]=0
GOTOB _MM7A
N200 _MG2:G1 G42 NORM G64 AX[_X]=RAD+HH8 AX[_Y]=HH9 F=HHF1
N210 G2 AX[_X]=RAD-HH3 AX[_Y]=0 IP[_X]=AC(RAD) IP[_Y]=AC(0)
N230 G3 AX[_X]=(RAD-HH3)*HH4 AX[_Y]=(RAD-HH3)*HH5 IP[_X]=AC(0) IP[_Y]=AC(0)
N240 G2 AX[_X]=(RAD+HH3)*HH4 AX[_Y]=(RAD+HH3)*HH5 IP[_X]=AC(RAD*HH4) IP[_Y]=AC(RAD*HH5)
N245 AX[_X]=RAD+HH3 AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N250 AX[_X]=RAD+HH3-(WZR+4*HH3)/5 AX[_Y]=-(WZR+4*HH3)/5 IP[_X]=AC(RAD+HH3-(WZR+4*HH3)/5) IP[_Y]=AC(0)
N260 G1 G40 G60 AX[_X]=RAD AX[_Y]=0
GOTOB _MM7A
_MS0:IF HZ4 GOTOF _MM17B IF (VARI==1)OR(FAL==0) GOTOF _MM7C
N261 _MS1:CFC
IF WZR==WID/2 GOTOF _MS02
HH8=(POT(RAD+(HH3-WZR)*HH10)-POT(WID/2-WZR)-POT(RAD))*WID/2/(2*RAD*(WID/2-WZR)) HH9=SQRT(POT(WID/2)-POT(HH8))
_MS02:HZ4=1 HH3=WID/2 HZ1=(_SDZI+DPR)/MIDF+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1 HHF1=FFP2 _H10=1
IF HH7==0 GOTOF _MS3
N400 AROT AX[_Z]=AFSL
N410 AMIRROR AX[_Y]=0
_MS3:IF SSF<0 GOTOB _MM7
N420 S=SSF G60
GOTOB _MM7
_MM17B:IF HH7==0 GOTOF _MM7C
IF NOT(WZR==WID/2)
N430 AMIRROR AX[_Y]=0
N440 AROT AX[_Z]=-AFSL
ENDIF
HH7=0
_MM7C:
SBLON
N450 G0 G90 G60 AX[_Z]=RTP
SBLOF
HZ2=1 HH6=INDA HZ3=HZ3+1 HZ4=0 HH7=0 _H10=0
IF HZ3>=NUM GOTOF _M7C IF SSF<0 GOTOB _MM4A
N460 S=HHS
GOTOB _MM4A
_M7C:
IF _SPIND==2
ST_CUST(_UMODE+1)
_H11=0
ENDIF
IF HHF GOTOF _MM7E
HHF=HHF1
N470 _MM7E:F=HHF
IF SSF<0 GOTOF _MM8
N480 S=HHS
N490 _MM8:
IF _MDG==1
MSG("")
ENDIF
SBLON
WRTPR("TMP_BLK_DEL()",1)
RET
N500 FEHL1:STOPRE
SETAL(61101)
RET
N502 FEHL2:STOPRE
SETAL(61106)
RET
N504 FEHL3:STOPRE
SETAL(61104)
RET
N506 FEHL4:STOPRE
SETAL(61105)
RET
N508 FEHL5:STOPRE
SETAL(61002)
RET
N510 FEHL6:STOPRE
SETAL(61000)
RET
N511 FEHL7:STOPRE
SETAL(61905)
RET
_FEHL12:STOPRE
N711 SETAL(61002)
RET

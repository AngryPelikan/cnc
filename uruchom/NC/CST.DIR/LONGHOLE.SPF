PROC LONGHOLE (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,INT NUM,REAL LENG,REAL CPA,REAL CPO,REAL RAD,REAL STA1,REAL INDA,REAL FFD,REAL FFP1,REAL MID,INT _VARI,INT _UMODE) SAVE DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.17 Sep 08, 2003
;Langloch
DEF AXIS _X,_Y,_Z
DEF REAL HH1,HH2,HH3,HH4,HH5,HH6,HH7,_FAK1,_SDZI,_ZUZ
DEF INT HZ1,HZ2,HZ3,_SPIND,_H8
DEF BOOL _ZB[12],_H9, _MDG
_X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 SDIS=ABS(SDIS) DPR=ABS(DPR) LENG=ABS(LENG)
RAD=ABS(RAD) NUM=ABS(NUM) MID=ABS(MID) HH6=STA1
_SPIND=ABS(_VARI) DIV 100 _VARI=_VARI MOD 100
IF _SPIND>2 GOTOF _FEHL5
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
IF(_VARI>3) OR (_VARI==2) GOTOF _FEHL5
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF _FEHL5
IF((_SPIND==1)AND(_VARI==3)) GOTOF _FEHL5
IF(_ZSD[1]==0)
_SDZI=SDIS
ENDIF
IF(_VARI==3)
_SDZI=SDIS
ENDIF
IF (_ZSD[3]) AND ($P_GG[15]==3)
_ZB[8]=1
ENDIF
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
IF $P_SIM
IF $P_TOOL==0
HH3=1
ELSE
HH3=$P_TOOLR
ENDIF
ELSE
IF $P_TOOL==0
GOTOF FEHL6
ELSE
HH3=$P_TOOLR
ENDIF
ENDIF
HH3=HH3*_FAK1
IF NUM==0 GOTOF FEHL2 IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MSG("$80000")
_MDG=1
_MM0: DP=HH2
GOTOF _MM1A
_MM1:DPR=ABS(RFP-DP)
_MM1A:IF RFP==DP GOTOF _MM8
IF RTP==RFP GOTOF _MM2 IF (RTP-RFP)/ABS(RTP-RFP)<>(RFP-DP)/DPR GOTOF FEHL1
_MM2:HH2=(RFP-DP)/DPR
HZ1=$MN_SCALING_SYSTEM_IS_METRIC HZ2=$P_GG[13] HH4=$MN_SCALING_VALUE_INCH
IF($P_SIM)GOTOF _MM2B
IF(HZ2>2) GOTOF _MM2B
IF ((HZ1)AND(HZ2==2))OR((HZ1==0)AND(HZ2<>2)) GOTOF _MM2B
IF HZ1 GOTOF _MM2A
HH3=HH3*HH4
GOTOF _MM2B
_MM2A:HH3=HH3/HH4
_MM2B:HH3=HH3/$P_ACTFRAME[_X,SC]
IF NUM==1 GOTOF _MM14 IF INDA<>0 GOTOF _MM3
INDA=360/NUM
GOTOF _MM4
_MM3:IF ABS(INDA*(NUM-1))>=360 GOTOF FEHL2
IF (INDA*(NUM-1)<=180) GOTOF _MM4 IF ABS((RAD+HH3)*SIN((INDA*(NUM-1))/2))<=HH3 GOTOF FEHL3
_MM4:IF (INDA>180) GOTOF _MM14 IF ABS((RAD+HH3)*SIN(INDA/2))<=HH3 GOTOF FEHL3
_MM14:IF MID GOTOF _MM4A
MID=_SDZI+DPR
_MM4A:HZ1=(_SDZI+DPR)/MID+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1
HH4=RAD+HH3 HH5=RAD+LENG-HH3 HH3=HH4 HH7=1 HZ2=1
IF HH5<=HH4
IF $P_SEARCH
RET
ELSE
GOTOF FEHL4
ENDIF
ENDIF
IF SQRT(POT(CPA+HH4*COS(STA1)-$P_EP[_X]*_FAK1)+POT(CPO+HH4*SIN(STA1)-$P_EP[_Y]*_FAK1)) <= SQRT(POT(CPA+HH5*COS(STA1)-$P_EP[_X]*_FAK1)+POT(CPO+HH5*SIN(STA1)-$P_EP[_Y]*_FAK1)) GOTOF _MM5
HH3=HH5 HH7=-1
_MM5:
IF _SPIND==2
ST_CUST(_UMODE)
ENDIF
ATRANS AX[_X]=CPA AX[_Y]=CPO
_MM6:MSG("$80006")
_MDG=1
AROT AX[_Z]=HH6
SBLON
N20 G0 G40 G60 G601 AX[_X]=HH3 AX[_Y]=0
IF ((_SPIND==1)AND(_VARI<2))
SBLOF
ST_CUST(_UMODE)
SBLON
_H9=1
ENDIF
N21 G64 AX[_Z]=RFP+SDIS*HH2
SBLOF
_ZUZ=(RFP+SDIS*HH2)-(DP+(HZ1-HZ2)*HH1*HH2)
N22 _MM7:
IF HZ1>1
IF(HZ2==1)
WRTPR("TMP_BLK_BEG()",1)
ENDIF
IF(HZ2==HZ1)
WRTPR("TMP_BLK_END()",1)
ENDIF
ENDIF
IF ((_SPIND==1)AND(_VARI<2)AND(_H9==0))
ST_CUST(_UMODE)
ENDIF
_H9=0
IF(_VARI==3)
IF NOT(_ZSD[3])
F=FFP1
ELSE
IF _ZB[8]
G95 F=FFP1
ELSE
G94 F=FFP1
ENDIF
ENDIF
N23 G1 G91 AX[_X]=(HH5-HH4)*HH7 AX[_Y]=0 AX[_Z]=-_ZUZ F=FFP1
ELSE
IF NOT(_ZSD[3])
F=FFD
ELSE
IF _ZB[8]
G94 F=FFD
ELSE
G95 F=FFD
ENDIF
ENDIF
G1G90 G60 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
IF ((_SPIND==1)AND(_VARI<2))
ST_CUST(_UMODE+1)
ENDIF
IF NOT(_ZSD[3])
F=FFP1
ELSE
IF _ZB[8]
G95 F=FFP1
ELSE
G94 F=FFP1
ENDIF
ENDIF
N230 G91 AX[_X]=(HH5-HH4)*HH7 AX[_Y]=0 F=FFP1
ENDIF
HH7=-HH7 HZ2=HZ2+1
IF HZ2 <= HZ1 GOTOB _MM7
IF(_VARI==3)
IF NOT(_ZSD[3])
F=FFP1
ELSE
IF _ZB[8]
G95 F=FFP1
ELSE
G94 F=FFP1
ENDIF
ENDIF
N231 G1 G91 AX[_X]=(HH5-HH4)*HH7 AX[_Y]=0 F=FFP1
ENDIF
SBLON
N24 G0 G90 G60 AX[_Z]=RTP
SBLOF
HZ2=1 HH6=INDA HZ3=HZ3+1
IF HZ3>=NUM GOTOF _MM8
IF ($P_EP[_X]*_FAK1>=HH4*0.999)AND($P_EP[_X]*_FAK1<=HH4*1.001) GOTOF _MM7B
IF SQRT(POT(HH4*COS(INDA)-HH5)+POT(HH4*SIN(INDA)))<=SQRT(POT(HH5*COS(INDA)-HH5)+POT(HH5*SIN(INDA))) GOTOF _MM7B
HH3=HH5 HH7=-1
GOTOB _MM6
_MM7B:HH3=HH4 HH7=1
GOTOB _MM6
_MM8:
IF _SPIND==2
ST_CUST(_UMODE+1)
ENDIF
IF _MDG==1
MSG("")
ENDIF
SBLON
WRTPR("TMP_BLK_DEL()",1)
RET
FEHL1:STOPRE
SETAL(61101)
RET
FEHL2:STOPRE
SETAL(61106)
RET
FEHL3:STOPRE
SETAL(61104)
RET
FEHL4:STOPRE
SETAL(61609)
RET
_FEHL5:STOPRE
SETAL(61002)
RET
FEHL6:STOPRE
SETAL(61000)
RET
_FEHL12:STOPRE
N711 SETAL(61002)
RET

PROC CYCLE800(INT _FR,STRING[32] _TC,INT _ST,INT _MODE,REAL _X0,REAL _Y0,REAL _Z0,REAL _A,REAL _B,REAL _C,REAL _X1,REAL _Y1,REAL _Z1,INT _DIR,INT _LOG_ON) SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.23 Feb 10, 2004
DEF REAL _A1, _A2, _A3, _A4, _Amax=90, _Amin=-90, _TCDIAG[8]
DEF INT _DD,_NV_akt, _G17_18_19, _TCMD, _TCI, _TCBA, _TCC, _HIRTH, _ISO=1, _ADDFR, _VA1, _VA2, _SOL2, _SWIV=1, _LOG, _TCRD
DEF AXIS _XX,_YY,_ZZ,_AX1,_AX2,_AX3
DEF FRAME _WPFR, _OLDFR
DEF STRING[40] _SERR
IF (_LOG_ON==1) OR (_LOG_ON==2) OR (_LOG_ON==3)
DELETE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF")
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","LOGFILE CYCLE800: "<<$A_DAY<<"."<<$A_MONTH<<"."<<$A_YEAR<<" "<<$A_HOUR<<":"<<$A_MINUTE<<":"<<$A_SECOND)
ENDIF
_NV_akt=$P_GG[8]
_G17_18_19=$P_GG[6]
IF(_G17_18_19==1)
_XX=$P_AXN1 _YY=$P_AXN2 _ZZ=$P_AXN3
ELSE
IF(_G17_18_19==2)
_XX=$P_AXN2 _YY=$P_AXN3 _ZZ=$P_AXN1
ELSE
_XX=$P_AXN3 _YY=$P_AXN1 _ZZ=$P_AXN2
ENDIF
ENDIF
IF $P_SIM==1 GOTOF _SI1
IF ($AN_NCK_VERSION < 480000) GOTOF _ERR1
IF(ISFILE("/_N_CST_DIR/_N_E_TCARR_SPF"))
  _ISO=0
ENDIF
IF(ISFILE("/_N_CST_DIR/_N_F_TCARR_SPF"))
  _ISO=2
ENDIF
_TCMD=$MN_MM_NUM_TOOL_CARRIER
IF(_TC=="0") OR ($P_SUBPAR[1]==0)
IF(_ISO==2)
_SWIV=0
WRTPR("SWIV_TR("<<2<<","<<0<<","<<0<<","<<0<<","<<0<<","<<0<<","<<0<<")",1)
ENDIF
STOPRE
TCARR=0
PAROTOF
TOROTOF
$P_PARTFR=CTRANS()
$P_TOOLFR=CTRANS()
$P_WPFRAME=CTRANS()
$P_WPFR=$P_WPFRAME
G[8]=_NV_akt
IF (NOT $P_SEARCH) AND (NOT $P_ISTEST) AND (NOT $P_SIM)
_TC_NUM=0
ENDIF
$MC_TOOL_CARRIER_RESET_VALUE=0
D=$P_TOOL
TOOLCARR(40,0)
GOTOF _RETa
ENDIF
IF ((_TC=="") AND (_TCMD>1)) OR (_TCMD==0) GOTOF _ERR0
IF (_TC=="") AND (_TCMD==1)
_TCI=1
ELSE
_TCMD=TRUNC(_TCMD/$ON_NUM_CHANNELS)
_TCI=1
WHILE ($TC_CARR34[_TCI]<>_TC)
_TCI=_TCI+1
IF (_TCI>_TCMD) GOTOF _ERR2
ENDWHILE
ENDIF
_VA1=ABS($TC_CARR7[_TCI])+ABS($TC_CARR8[_TCI])+ABS($TC_CARR9[_TCI])
_VA2=ABS($TC_CARR10[_TCI])+ABS($TC_CARR11[_TCI])+ABS($TC_CARR12[_TCI])
IF (_VA1+_VA2)==0 GOTOF _ERR6
IF $TC_CARR35[_TCI]=="" GOTOF _ERR8
IF ((ABS($TC_CARR30[_TCI]))+(ABS($TC_CARR31[_TCI]))+(ABS($TC_CARR32[_TCI]))+(ABS($TC_CARR33[_TCI])))==0 GOTOF _ERR5
IF ($TC_CARR30[_TCI]>$TC_CARR32[_TCI]) OR ($TC_CARR31[_TCI]>$TC_CARR33[_TCI]) GOTOF _ERR5
_TC_N_WZ= _ST MOD 100 DIV 10
_TC_A_WZ= _ST MOD 1000 DIV 100
TOOLCARR(40,_TCI)
_TCBA=($TC_CARR37[_TCI] MOD 1000 DIV 100)*10
IF _TCBA>=20
_TCBA=10
_TCRD=4
ENDIF
_TCRD=_TCRD+($TC_CARR37[_TCI] MOD 100 DIV 10)
IF ($TC_CARR37[_TCI] MOD 100 DIV 10)>0
_TCBA=_TCBA+21
ELSE
_TCBA=_TCBA+20
ENDIF
IF $TC_CARR36[_TCI]==""
_TCBA=_TCBA+2
IF (_TCBA==32)OR(_TCBA==33)
_TCBA=_TCBA-10
ENDIF
$TC_CARR10[_TCI]=0 $TC_CARR11[_TCI]=0 $TC_CARR12[_TCI]=0
ENDIF
IF _TC_FR > 0
IF ((_TCBA==21) OR (_TCBA==23) OR (_TCBA==31))
WHILE $TC_CARR35[_TCI]<>$MC_AXCONF_CHANAX_NAME_TAB[_TCC]
_TCC=_TCC+1
IF _TCC>_TC_FR GOTOF _MA3
ENDWHILE
IF $MC_AXCONF_MACHAX_USED[_TCC]<>0
_TCBA=_TCBA+4
ENDIF
_MA3:
ENDIF
_TCC=0
IF (_TCBA==30) OR (_TCBA==31) OR (_TCBA==35)
WHILE $TC_CARR36[_TCI]<>$MC_AXCONF_CHANAX_NAME_TAB[_TCC]
_TCC=_TCC+1
IF _TCC>_TC_FR GOTOF _MA6
ENDWHILE
IF $MC_AXCONF_MACHAX_USED[_TCC]<>0
_TCBA=_TCBA+2
ENDIF
_MA6:
ENDIF
ENDIF
_TC_ST=_TCBA
IF ($TC_CARR28[_TCI])OR($TC_CARR29[_TCI])
_HIRTH=1
IF ($MC_TOCARR_ROT_ANGLE_INCR[0])OR($MC_TOCARR_ROT_ANGLE_INCR[1])
$MC_TOCARR_ROT_ANGLE_OFFSET[0]=0
$MC_TOCARR_ROT_ANGLE_OFFSET[1]=0
$MC_TOCARR_ROT_ANGLE_INCR[0]=0
$MC_TOCARR_ROT_ANGLE_INCR[1]=0
NEWCONF
ENDIF
ENDIF
PAROTOF
TOROTOF
$P_PARTFR=CTRANS()
$P_TOOLFR=CTRANS()
IF NOT( $P_TRAFO B_AND 'H300')
TRAFOOF
ENDIF
TCARR=0
G[8]=_NV_akt
$TC_CARR21[_TCI]=_XX $TC_CARR22[_TCI]=_XX
$TC_CARR13[_TCI]=0 $TC_CARR14[_TCI]=0
IF (_ST MOD 10)==0
$P_WPFRAME=CTRANS():CROT()
$P_WPFR=$P_WPFRAME
TRANS
G[8]=_NV_akt
IF NOT ((_TCBA==21) OR (_TCBA==23) OR (_TCBA==31))
N890 $TC_CARR13[_TCI]=$P_UIFR[(_NV_akt-1),AXNAME($TC_CARR35[_TCI]),TR]
ELSE
$TC_CARR13[_TCI]=0
ENDIF
IF ($TC_CARR36[_TCI]<>"") AND ((_TCBA==20) OR (_TCBA==21) OR (_TCBA==25) OR (_TCBA==32) OR (_TCBA==33) OR (_TCBA==37))
$TC_CARR14[_TCI]=0
IF (_VA1==2) AND ($TC_CARR13[_TCI]<>0)
N891 $TC_CARR14[_TCI]=$P_UIFR[(_NV_akt-1),AXNAME($TC_CARR36[_TCI]),TR]
ENDIF
ENDIF
IF (_VA1==2)
TCOABS TCARR=_TCI
PAROT
_WPFR=$P_PARTFRAME
_WPFR[_XX,TR]=0 _WPFR[_YY,TR]=0 _WPFR[_ZZ,TR]=0
$P_WPFRAME=INVFRAME(_WPFR)
IF $TC_CARR13[_TCI]<>0
N892 $P_WPFRAME=$P_WPFRAME:CTRANS(AXNAME($TC_CARR35[_TCI]),-$TC_CARR13[_TCI])
ENDIF
IF $TC_CARR36[_TCI]<>""
IF $TC_CARR13[_TCI]<>0
N893 $P_WPFRAME=$P_WPFRAME:CTRANS(AXNAME($TC_CARR36[_TCI]),-$TC_CARR14[_TCI])
ENDIF
ENDIF
PAROTOF
ENDIF
ELSE
$P_WPFRAME=$P_WPFRAME:$P_PFRAME
$P_WPFR=$P_WPFRAME
TRANS
G[8]=_NV_akt
ENDIF
IF (_LOG_ON==1) OR (_LOG_ON==2)
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","TC:"<<$TC_CARR34[_TCI]<<" AX1:"<<$TC_CARR35[_TCI]<<" AX2:"<<$TC_CARR36[_TCI]<<" MODE:"<<_MODE)
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","min AX1: "<<$TC_CARR30[_TCI]<<" max AX1: "<<$TC_CARR32[_TCI])
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","min AX2: "<<$TC_CARR31[_TCI]<<" max AX2: "<<$TC_CARR33[_TCI])
ENDIF
IF (_LOG_ON==3)
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","Inputs _A  _B  _C || $P_TCANG[1] _$P_TCANG[2] || $P_TCANG [3] $P_TCANG[4] || Solution  _A1  _A2 || $P_TCDIFF[1]  $P_TCDIFF[2]")
ENDIF
_SI1:
IF _MODE<=0 GOTOF _ERR4
IF((_MODE B_AND 'B11000000')=='B01000000')
_WPFR=CTRANS(_XX,_X0,_YY,_Y0,_ZZ,_Z0):CROT(_ZZ,_A):CROT(_YY,_B):CTRANS(_XX,_X1,_YY,_Y1,_ZZ,_Z1)
ELSE
_AX1=_XX _AX2=_XX _AX3=_XX
IF((_MODE B_AND 'B000011')=='B000001')
_AX1=_XX
ENDIF
IF((_MODE B_AND 'B000011')=='B000010')
_AX1=_YY
ENDIF
IF((_MODE B_AND 'B000011')=='B000011')
_AX1=_ZZ
ENDIF
IF((_MODE B_AND 'B001100')=='B000100')
_AX2=_XX
ENDIF
IF((_MODE B_AND 'B001100')=='B001000')
_AX2=_YY
ENDIF
IF((_MODE B_AND 'B001100')=='B001100')
_AX2=_ZZ
ENDIF
IF((_MODE B_AND 'B110000')=='B010000')
_AX3=_XX
ENDIF
IF((_MODE B_AND 'B110000')=='B100000')
_AX3=_YY
ENDIF
IF((_MODE B_AND 'B110000')=='B110000')
_AX3=_ZZ
ENDIF
IF((_MODE B_AND 'B11000000')=='B10000000')
_WPFR=CTRANS(_XX,_X0,_YY,_Y0,_ZZ,_Z0):CROTS(_AX1,_A,_AX2,_B):CROT(_AX3,_C):CTRANS(_XX,_X1,_YY,_Y1,_ZZ,_Z1)
ELSE
IF _TC_A_WZ==0
_WPFR=CTRANS(_XX,_X0,_YY,_Y0,_ZZ,_Z0):CROT(_AX1,_A):CROT(_AX2,_B):CROT(_AX3,_C):CTRANS(_XX,_X1,_YY,_Y1,_ZZ,_Z1)
ELSE
IF _A>_Amax
_A=_Amax
ENDIF
IF _B>_Amax
_B=_Amax
ENDIF
IF _C>_Amax
_C=_Amax
ENDIF
IF _A<_Amin
_A=_Amin
ENDIF
IF _B<_Amin
_B=_Amin
ENDIF
IF _C<_Amin
_C=_Amin
ENDIF
_WPFR=CROT(_AX1,_A):CROT(_AX2,_B):CROT(_AX3,_C)
ENDIF
ENDIF
ENDIF
IF $P_SIM==1
IF (_TC=="0") OR ($P_SUBPAR[1]==0) GOTOF _RET
IF (_ST MOD 10)==0
TRANS
ENDIF
$P_PFRAME=$P_PFRAME:_WPFR
G[8]=_NV_akt
CUT2DF
GOTOF _RET
ENDIF
IF _FR==3
  _FR=1+TRUNC($TC_CARR37[_TCI]/1000000) MOD 10
ENDIF
IF _FR>0
IF _FR>2 GOTOF _ERR3
IF _FR==1
TOOLCARR(41,_TCI)
ELSE
IF ($TC_CARR37[_TCI] DIV 1000000 MOD 10) == 1
TOOLCARR(42,_TCI)
ELSE
GOTOF _ERR3
ENDIF
ENDIF
ENDIF
IF(_ISO==2)
WRTPR("SWIV_TR("<<2<<","<<0<<","<<0<<","<<0<<","<<0<<","<<0<<","<<0<<")",1)
ENDIF
_OLDFR=$P_WPFRAME
$P_WPFRAME=$P_WPFRAME:_WPFR
$P_WPFR=$P_WPFRAME
G[8]=_NV_akt
REPEAT _FRa _FRe
IF $P_TCSOL==0 GOTOF _ERR4
_A1=$P_TCANG[1] _A2=$P_TCANG[2]
_A3=$P_TCANG[3] _A4=$P_TCANG[4]
IF $P_TCSOL==2
IF (($TC_CARR37[_TCI] MOD 10000 DIV 1000) == 2)
IF(_DIR*_A2<_DIR*_A4)
_A1=_A3 _A2=_A4 _SOL2=1
ENDIF
ELSE
IF(_DIR*_A1<_DIR*_A3)
_A1=_A3 _A2=_A4 _SOL2=1
ENDIF
ENDIF
ENDIF
$TC_CARR13[_TCI]=_A1 $TC_CARR14[_TCI]=_A2
IF _SOL2==1
REPEAT _FRa _FRe
ENDIF
IF ABS(_A1)==360
_A1=0
ENDIF
IF ABS(_A2)==360
_A2=0
ENDIF
_TC_A1=ROUND(_A1*1000)/1000
_TC_A2=ROUND(_A2*1000)/1000
PAROT
IF _HIRTH
CASE _G17_18_19 OF 2 GOTOF _G18 3 GOTOF _G19 DEFAULT GOTOF _G17
_G18: TOROTY
GOTOF _GGe
_G19: TOROTX
GOTOF _GGe
_G17: TOROT
_GGe:
ENDIF
IF (NOT $P_SEARCH) AND (NOT $P_ISTEST) AND (NOT $P_SIM)
_TC_NUM=_TCI
ENDIF
$MC_TOOL_CARRIER_RESET_VALUE=_TCI
D=$P_TOOL
IF (_LOG_ON==1)OR(_LOG_ON==2)
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","Inputs "<<AXSTRING(_AX1)<<":"<<_A<<" "<<AXSTRING(_AX2)<<":"<<_B<<" "<<AXSTRING(_AX3)<<":"<<_C)
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","$P_TCANG 1,2: "<<$P_TCANG[1]<<" | "<<$P_TCANG[2])
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","$P_TCANG 3,4: "<<$P_TCANG[3]<<" | "<<$P_TCANG[4])
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","TC_CARR13: "<<$TC_CARR13[_TCI]<<" TC_CARR14: "<<$TC_CARR14[_TCI])
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF","Solution: "<<$P_TCSOL<<" _A1: "<<_A1<<" _A2: "<<_A2)
ENDIF
IF (_LOG_ON==4)
_TCDIAG[0]=ROUND($P_TCANG[1]*10000)/10000 _TCDIAG[1]=ROUND($P_TCANG[2]*10000)/10000
_TCDIAG[2]=ROUND($P_TCANG[3]*10000)/10000 _TCDIAG[3]=ROUND($P_TCANG[4]*10000)/10000
_TCDIAG[4]=ROUND($P_TCDIFF[1]*10000)/10000 _TCDIAG[5]=ROUND($P_TCDIFF[2]*10000)/10000
_TCDIAG[6]=ROUND(_A1*10000)/10000 _TCDIAG[7]=ROUND(_A2*10000)/10000
WRITE(_LOG,"/_N_MPF_DIR/_N_TC_LOG_MPF"," "<<_A<<" | "<<_B<<" | "<<_C<<" || "<<_TCDIAG[0]<<" | "<<_TCDIAG[1]<<" || "<<_TCDIAG[2]<<" | "<<_TCDIAG[3]<<" || "<<$P_TCSOL<<" | "<<_TCDIAG[6]<<" | "<<_TCDIAG[7]<<" || "<<_TCDIAG[4]<<" | "<<_TCDIAG[5])
ENDIF
IF (NOT _DIR==0) AND (NOT $P_SIM)
IF (NOT $P_SEARCH) AND (NOT $P_ISTEST)
IF (_TCBA==31) OR (_TCBA==33) OR (_TCBA==35) OR (_TCBA==37)
CASE _TCRD OF 1 GOTOF _RD1 2 GOTOF _RD2 4 GOTOF _RD4 5 GOTOF _RD4 DEFAULT GOTOF _RDe
_RD1:
_SERR=<<(SUBSTR($TC_CARR35[_TCI],0,5))<<": "<<_TC_A1<<"  "<<(SUBSTR($TC_CARR36[_TCI],0,5))<<": "<<_TC_A2
SETAL(62180,_SERR)
GOTOF _RDe
_RD2: _SERR=<<(SUBSTR($TC_CARR36[_TCI],0,5))<<": "<<_TC_A2
SETAL(62181,_SERR)
GOTOF _RDe
_RD4: _SERR=<<(SUBSTR($TC_CARR35[_TCI],0,5))<<": "<<_TC_A1
SETAL(62181,_SERR)
_RDe:
ENDIF
IF (_TCBA==21) OR (_TCBA==23) OR (_TCBA==25) OR (_TCBA==27)
IF _TCRD<>2
_SERR=<<(SUBSTR($TC_CARR35[_TCI],0,5))<<": "<<_TC_A1
SETAL(62181,_SERR)
ENDIF
ENDIF
IF (_TCBA==30) OR (_TCBA==32)
IF _TCRD<4
_SERR=<<(SUBSTR($TC_CARR36[_TCI],0,5))<<": "<<_TC_A2
SETAL(62181,_SERR)
ENDIF
ENDIF
IF _HIRTH AND (_ISO<>1) AND ((ROUND($P_TCDIFF[1]*100000)/100000) OR (ROUND($P_TCDIFF[2]*100000)/100000))
TOOLCARR (10,_TCI,_A1,_A2)
ENDIF
ENDIF
TOOLCARR (_TCBA,_TCI,_A1,_A2)
ENDIF
IF (_TC_A_WZ==1)
$P_WPFRAME=_OLDFR
$P_WPFR=$P_WPFRAME
G[8]=_NV_akt
PAROT
ENDIF
_TC_P[9]=_TC_P[9]+0.001
IF _LOG_ON==2
MSG ("see LOG-File")
M0
stopre
ENDIF
_RET:
IF(_ISO==2)
WRTPR("SWIV_TR("<<_SWIV<<","<<$P_WPFRAME[_XX,TR]<<","<<$P_WPFRAME[_YY,TR]<<","<<$P_WPFRAME[_ZZ,TR]<<","<<$P_WPFRAME[_XX,RT]<<","<<$P_WPFRAME[_YY,RT]<<","<<$P_WPFRAME[_ZZ,RT]<<")",1)
ENDIF
G4 F0
M17
_RETa:
IF(_ISO==2)
WRTPR("SWIV_TR("<<_SWIV<<","<<$P_WPFRAME[_XX,TR]<<","<<$P_WPFRAME[_YY,TR]<<","<<$P_WPFRAME[_ZZ,TR]<<","<<$P_WPFRAME[_XX,RT]<<","<<$P_WPFRAME[_YY,RT]<<","<<$P_WPFRAME[_ZZ,RT]<<")",1)
ENDIF
RET
_FRa:
CASE _G17_18_19 OF 2 GOTOF _Y18 3 GOTOF _X19 DEFAULT GOTOF _Z17
_Y18: CUT2DF TCOFRY TCARR=_TCI
GOTOF _FRe
_X19: CUT2DF TCOFRX TCARR=_TCI
GOTOF _FRe
_Z17: CUT2DF TCOFR TCARR=_TCI
_FRe:
_ERR0: STOPRE
SETAL(61180)
RET
_ERR1: STOPRE
SETAL(61181)
RET
_ERR2: STOPRE
SETAL(61182)
_ERR3: STOPRE
SETAL(61183)
RET
_ERR4: STOPRE
SETAL(61184)
RET
_ERR5: STOPRE
SETAL(61185)
RET
_ERR6: STOPRE
SETAL(61186)
RET
_ERR7: STOPRE
SETAL(61187)
RET
_ERR8: STOPRE
SETAL(61188)
RET
_ERR10: STOPRE
SETAL(61190)
RET

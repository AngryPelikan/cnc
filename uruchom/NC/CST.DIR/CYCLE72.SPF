PROC CYCLE72(STRING[140] _KNAME,REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _VARI,INT _RL,INT _AS1,REAL _LP1,REAL _FF3,INT _AS2,REAL _LP2,INT _UMODE) SAVE SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.22 Jan 06, 2004
;Konturfraesen
N11 DEF AXIS _XX,_YY,_ZZ
N12 DEF INT _BA1,_BA10,_BA100,_HZ,_IZ,_AS11,_GZW,_G15T,_G15K,_H8,_SPIND,_H10,_H11,_P49=0
N13 DEF REAL _HEZ,_DIS1,_DIS2,_DPA,_DPR,_DPZ,_FAK1,_PMZ,_RDF,_SDZ,_WEZ,_OFFN,_XXS,_YYS,_XAP=0,_YAP=0,_ALPHA,_L,_VORZ
N14 DEF BOOL _ZV[2], _SOWZ
N15 DEF STRING[32] _SLA,_SLE
N16 DEF STRING[80] _PNAME
N17 DEF INT II,IH1,IH2
DEF REAL _KTS[100,6]
DEF INT _ERROR=0
_OFFN=$P_OFFN
IH2=STRLEN(_KNAME) IH1=0
FOR II=0 TO IH2
IF SUBSTR(_KNAME,II,1)==":"
IF IH1<>0
GOTOF _M5201
ENDIF
IH1=II
ENDIF
ENDFOR
_M5201:
IF IH1==0 GOTOF _M5202
IF (IH1<>0) AND (II==STRLEN(_KNAME))
_SLA=SUBSTR(_KNAME,0,IH1) _SLE=SUBSTR(_KNAME,IH1+1,IH2-IH1-1)
ELSE
_PNAME=SUBSTR(_KNAME,0,IH1)
_SLA=SUBSTR(_KNAME,IH1+1,II-IH1-1)
_SLE=SUBSTR(_KNAME,II+1,STRLEN(_KNAME)-II-1)
ENDIF
_M5202:
_SDIS=ABS(_SDIS) _MID=ABS(_MID) _FALD=ABS(_FALD) _RL=ABS(_RL) _AS1=ABS(_AS1) _AS2=ABS(_AS2) _LP1=ABS(_LP1) _LP2=ABS(_LP2) _VARI=ABS(_VARI)
_XX=$P_AXN1 _YY=$P_AXN2 _ZZ=$P_AXN3
IF($P_ACTFRAME[_ZZ,SC]<>1) GOTOF _FEHL10
IF($P_GG[13]==2)OR($P_GG[13]==4)
_RDF=0.001
ELSE
_RDF=0.0001
ENDIF
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
IF($P_TOOLNO==0) AND ($P_SIM==0) GOTOF _FEHL0
IF($P_TOOL==0) AND ($P_SIM==0) GOTOF _FEHL1
IF($P_TOOLR<0) GOTOF _FEHL9
IF($P_SIM==1) AND ($P_TOOL==0)
_SOWZ=TRUE
ELSE
_SOWZ=FALSE
ENDIF
_BA1=_VARI MOD 10 _BA10=TRUNC(_VARI/10) MOD 10 _BA100=TRUNC(_VARI/100) MOD 10
_SPIND=TRUNC(_VARI/1000) MOD 10
IF(_BA1<1)OR(_BA1>2)OR(_BA100>3)OR(_SPIND>2) GOTOF _FEHL2
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL13
_STCCMA:
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF _FEHL2
IF(_RL<40) OR (_RL>42) GOTOF _FEHL4
IF($P_SIM==0) GOTOF _VS1
IF($P_TOOL==0)
T0
_BA1=2
MSG("$80013")
ENDIF
_VS1:
_AS11=_AS1 MOD 10
IF(_AS11<1)OR(_AS11>4) GOTOF _FEHL5
IF(_AS11<4)AND(_AS2 MOD 10 >3) GOTOF _FEHL5
IF(_RL==40)AND((_AS11==2)OR(_AS11==3)) GOTOF _FEHL5
IF(_AS11==4)AND(_RL<>40) GOTOF _FEHL11
IF(TRUNC(_AS1/10)>1) GOTOF _FEHL5
IF(_AS11<4)
IF(TRUNC(_AS2/10)>1) GOTOF _FEHL5
IF(_AS2==10)OR(_AS2 MOD 10 > 3) GOTOF _FEHL5
IF(_LP1==0) GOTOF _FEHL6
IF(_AS2==0)
_AS2=_AS1 _LP2=_LP1
ELSE
IF(_LP2==0) GOTOF _FEHL6
ENDIF
IF(_RL==40)AND(_AS2 MOD 10 >1) GOTOF _FEHL5
ENDIF
IF(_FFP1<=0) GOTOF _FEHL7
IF(_FFD<=0)
_FFD=_FFP1
ENDIF
_DPR=ABS(_RFP-_DP) _PMZ=_RTP-_RFP
IF(_RFP==_DP) GOTOF _RET
IF(_RTP==_RFP) GOTOF _M1
IF(_PMZ/ABS(_PMZ) <> (_RFP-_DP)/_DPR) GOTOF _FEHL3
_M1: _PMZ=(_RFP-_DP)/_DPR
IF(_RFP==_RTP)
_RTP=_RFP+_SDIS*_PMZ
ENDIF
IF(_PMZ==1)
IF((_RFP+_SDIS) > _RTP) GOTOF _FEHL12
ELSE
IF((_RFP-_SDIS) < _RTP) GOTOF _FEHL12
ENDIF
IF($P_EP[_ZZ]*_FAK1<_RTP)
N4 SBLON
N5 G0 G90 AX[_ZZ]=_RTP
N6 SBLOF
ENDIF
IF(_ZSD[1]==0)
_SDZ=_SDIS
ELSE
_SDZ=0
ENDIF
IF(_BA1==2)
_FALD=0 _FAL=0
ENDIF
IF(_FALD>=_DPR) GOTOF _FEHL8
_DPA=_DPR-_FALD
IF(_MID>=_DPA)OR(_MID==0)
_MID=_DPA+_SDZ
ENDIF
_HZ=(_DPA+_SDZ)/_MID+0.4999
_HEZ=(_DPA+_SDZ)/_HZ
_ZV[1]=0 _G15T=3
IF((_ZSD[3])AND($P_GG[15]==3))OR((_ZSD[3]==0)AND($P_GG[15]==2))
_ZV[1]=1 _G15T=2
ENDIF
IF(_AS11==4)
IF(_ZSD[3]==1)
IF(_G15T==3)
_G15K=2
ELSE
_G15K=3
ENDIF
ELSE
_G15K=_G15T
ENDIF
IF($P_GG[49]==3)
CP
_P49=3
ENDIF
CONTDCON(_KTS)
IF ((_PNAME=="") AND (_SLA=="") AND (_SLE==""))
N400 CALL _KNAME
ELSE
IF (_PNAME=="")
N402 CALL $P_PROG[$P_STACK-1] BLOCK _SLA TO _SLE
ELSE
N404 CALL _PNAME BLOCK _SLA TO _SLE
ENDIF
ENDIF
N406 EXECUTE(_ERROR)
IF(_P49==3)
PTPG0
ENDIF
_XXS=_KTS[1,1] _YYS=_KTS[1,2]
ENDIF
IF(_SPIND==2)
N410 ST_CUST(_UMODE)
_H11=1
ENDIF
FOR _IZ=1 TO _HZ
IF _SOWZ==TRUE
_IZ=_HZ
ENDIF
IF(_BA1==1)AND(_HZ>1)
IF(_IZ==1)
WRTPR("TMP_BLK_BEG()",1)
ENDIF
IF(_IZ==_HZ)
WRTPR("TMP_BLK_END()",1)
ENDIF
ENDIF
IF(_BA10==0)
_GZW=1
N430 G0 G90 G64
ELSE
_GZW=2
IF(_FF3==0)OR(_BA100==3)
_FF3=_FFP1
ENDIF
N435 G1 G90 G64 F=_FF3
ENDIF
_DPZ=_DP+(_DPR+_SDZ-_IZ*_HEZ)*_PMZ
_DIS1=(_HEZ+_SDIS)*_PMZ
IF(ABS(_DIS1)>ABS(_RTP-_DPZ))
_DIS1=ABS(_RTP-_DPZ)*_PMZ
ENDIF
IF(_IZ>1)
IF(_BA100==1)
IF(_PMZ==1)
IF((_DPZ+_DIS1)>(_RFP+_SDIS*_PMZ))
_DIS1=((_RFP+_SDIS*_PMZ)-_DPZ)
ENDIF
ELSE
IF((_DPZ+_DIS1)<(_RFP+_SDIS*_PMZ))
_DIS1=((_RFP+_SDIS*_PMZ)-_DPZ)
ENDIF
ENDIF
ENDIF
IF(_BA100==3)
_DIS1=_HEZ*_PMZ
ENDIF
ENDIF
IF(_AS11<>4)
IF(_BA1==1) AND (_RL<>40)
CFTCP
ENDIF
IF($P_GG[1]==1)AND($P_GG[49]==3)AND($P_TRAFO B_AND 'H100')AND(_IZ>1)
IF(_RL==40)
_XAP=$P_APR[_XX]
_YAP=$P_APR[_YY]
ELSE
IF((_AS1 MOD 10)==3)
_L=($P_TOOLR+_FAL)/(2*(_FAL+_LP1+$P_TOOLR))
_XAP=$P_APR[_XX]-($P_APR[_XX]-$P_AEP[_XX])*_L
_YAP=$P_APR[_YY]-($P_APR[_YY]-$P_AEP[_YY])*_L
ELSE
IF(_RL==41)
_VORZ=1
ELSE
_VORZ=-1
ENDIF
IF((_AS1 MOD 10)==1)
_ALPHA=ATAN2(($P_APR[_YY]-$P_AEP[_YY]),($P_APR[_XX]-$P_AEP[_XX]))
_XAP=$P_APR[_XX]+($P_TOOLR+_FAL)*SIN(_ALPHA)*_VORZ
_YAP=$P_APR[_YY]-($P_TOOLR+_FAL)*COS(_ALPHA)*_VORZ
ELSE
_ALPHA=ATAN2(($P_APR[_YY]-$P_AEP[_YY]),($P_APR[_XX]-$P_AEP[_XX]))
_XAP=$P_APR[_XX]-($P_TOOLR+_FAL)*SIN(45-_ALPHA*_VORZ)
_YAP=$P_APR[_YY]-($P_TOOLR+_FAL)*COS(45-_ALPHA*_VORZ)*_VORZ
ENDIF
ENDIF
ENDIF
N21 G0 AX[_XX]=_XAP AX[_YY]=_YAP
ENDIF
IF(_RL==40)
N18 G140 G40
GOTOF _MAN
ELSE
IF(_BA1==1)
N19 OFFN=_OFFN+_FAL
ENDIF
IF(_RL==41)
N20 G140 G41 NORM
ELSE
N30 G140 G42 NORM
ENDIF
ENDIF
_MAN:
N32 SBLON
IF(_ZV[1]==0) GOTOF _MMU
IF(_AS1==1)
N35 G341 G147 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==11)
N40 G340 G147 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==2)
N45 G341 G247 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==12)
N50 G340 G247 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==3)
N55 G341 G347 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==13)
N60 G340 G347 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
GOTOF _MKON
_MMU:
IF(_AS1==1)
N65 G341 G147 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PR(_FFD)
ENDIF
IF(_AS1==11)
N70 G340 G147 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PR(_FFD)
ENDIF
IF(_AS1==2)
N75 G341 G247 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PR(_FFD)
ENDIF
IF(_AS1==12)
N80 G340 G247 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PR(_FFD)
ENDIF
IF(_AS1==3)
N85 G341 G347 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PR(_FFD)
ENDIF
IF(_AS1==13)
N90 G340 G347 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PR(_FFD)
ENDIF
_MKON:
N34 SBLOF
IF ((_PNAME=="") AND (_SLA=="") AND (_SLE==""))
N91 CALL _KNAME
ELSE
IF (_PNAME=="")
N92 CALL $P_PROG[$P_STACK-1] BLOCK _SLA TO _SLE
ELSE
N93 CALL _PNAME BLOCK _SLA TO _SLE
ENDIF
ENDIF
IF(_BA100==0)
_WEZ=_RTP
IF(_AS2<10)
_DIS2=_RDF*_PMZ
ELSE
_DIS2=(_HEZ+_SDIS)*_PMZ
IF(_PMZ==1)
IF((_DPZ+_DIS2)>_WEZ)
_DIS2=_WEZ-_DPZ
ENDIF
ELSE
IF((_DPZ+_DIS2)<_WEZ)
_DIS2=_WEZ-_DPZ
ENDIF
ENDIF
ENDIF
ENDIF
IF(_BA100==1)
_WEZ=_RFP+_SDIS*_PMZ+_RDF*_PMZ
IF(_AS2<10)
_DIS2=_RDF*_PMZ
ELSE
_DIS2=(_HEZ+_SDIS)*_PMZ
IF(_PMZ==1)
IF((_DPZ+_DIS2)>_WEZ)
_DIS2=_WEZ-_DPZ
ENDIF
ELSE
IF((_DPZ+_DIS2)<_WEZ)
_DIS2=_WEZ-_DPZ
ENDIF
ENDIF
ENDIF
ENDIF
IF(_BA100==2)
_WEZ=_DPZ+_SDIS*_PMZ+_RDF*_PMZ _DIS2=_SDIS*_PMZ
ENDIF
IF(_BA100==3)
_WEZ=_DPZ+_RDF*_PMZ _DIS2=0 _BA10=1
ENDIF
N94 SBLON
IF(_BA10==0)AND(_BA100<>3)
N95 G00
IF(_AS2==1)
N100 G341 G148 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==11)
N105 G340 G148 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==2)
N110 G341 G248 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==12)
N115 G340 G248 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==3)
N120 G341 G348 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==13)
N125 G340 G348 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
ELSE
N140 G01
IF(_BA100==3)
N145 _FF3=_FFP1
ENDIF
IF(_AS2==1)
N150 G341 G148 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==11)
N155 G340 G148 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==2)
N160 G341 G248 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==12)
N165 G340 G248 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==3)
N170 G341 G348 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==13)
N175 G340 G348 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
ENDIF
N176 SBLOF
ELSE
IF(_GZW==2)
IF(_G15K==2)
N180 G94 F=_FF3
ELSE
N182 G95 F=_FF3
ENDIF
ENDIF
SBLON
N200 AX[_XX]=_XXS AX[_YY]=_YYS
SBLOF
IF((_SPIND==1)AND(_BA1==1))
N202 ST_CUST(_UMODE)
_H10=1
ENDIF
SBLON
N205 AX[_ZZ]=_DPZ+_DIS1
SBLOF
IF(_G15T==2)
N207 G94 F=_FFD
ELSE
N208 G95 F=_FFD
ENDIF
N210 G1 AX[_ZZ]=_DPZ
IF(_H10==1)
N215 ST_CUST(_UMODE+1)
_H10=0
ENDIF
IF(_G15K==2)
N216 G94 F=_FFP1
ELSE
N217 G95 F=_FFP1
ENDIF
IF ((_PNAME=="") AND (_SLA=="") AND (_SLE==""))
N220 CALL _KNAME
ELSE
IF (_PNAME=="")
N225 CALL $P_PROG[$P_STACK-1] BLOCK _SLA TO _SLE
ELSE
N230 CALL _PNAME BLOCK _SLA TO _SLE
ENDIF
ENDIF
IF(_BA100==0)
_WEZ=_RTP
ENDIF
IF(_BA100==1)
_WEZ=_RFP+_SDIS*_PMZ
ENDIF
IF(_BA100==2)
_WEZ=_DPZ+_SDIS*_PMZ
ENDIF
IF(_BA100==3)
_WEZ=_DPZ _GZW=2 _BA10=1
ENDIF
IF(_GZW==1)AND(_BA100<>3)
N235 G0
ELSE
IF(_FF3==0)
_FF3=_FFP1
ENDIF
IF(_G15K==2)
N240 G1 G94 F=_FF3
ELSE
N242 G1 G95 F=_FF3
ENDIF
ENDIF
SBLON
N250 G90 G40 AX[_ZZ]=_WEZ
SBLOF
ENDIF
ENDFOR
N298 SBLON
N300 G0 AX[_ZZ]=_RTP
N310 AX[_XX]=$P_EP[_XX]*_FAK1 AX[_YY]=$P_EP[_YY]*_FAK1
N312 SBLOF
IF((_SPIND==2)AND(_H11==1))
N320 ST_CUST(_UMODE+1)
_H11=0
ENDIF
GOTOF _RET
_FEHL0: STOPRE
SETAL(61009)
RET
_FEHL1: STOPRE
SETAL(61000)
RET
_FEHL2: STOPRE
SETAL(61002)
RET
_FEHL3: STOPRE
SETAL(61101)
RET
_FEHL4: STOPRE
SETAL(61114)
RET
_FEHL5: STOPRE
SETAL(61115)
RET
_FEHL6: STOPRE
SETAL(61116)
RET
_FEHL7: STOPRE
SETAL(61003)
RET
_FEHL8: STOPRE
SETAL(61010)
RET
_FEHL9: STOPRE
SETAL(61112)
RET
_FEHL10: STOPRE
SETAL(61011)
RET
_FEHL11: STOPRE
SETAL(61129)
RET
_FEHL12: STOPRE
SETAL(61014)
RET
_FEHL13:STOPRE
SETAL(61002)
RET
_RET: OFFN=_OFFN
IF($P_SIM==1) AND ($P_TOOL==0)
MSG("")
ENDIF
SBLON
WRTPR("TMP_BLK_DEL()",1)
RET

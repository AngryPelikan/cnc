PROC POCKET4(REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _PRAD,REAL _PA,REAL _PO,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _CDIR,INT _VARI,REAL _MIDA,REAL _AP1,REAL _AD,REAL _RAD1,REAL _DP1,INT _UMODE) SAVE SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;C06.02.16.02 Nov 27, 2003
;Neue Kreistasche
N10 DEF AXIS _X,_Y,_Z
N13 DEF BOOL _ZB[11],_SOWZ
DEF INT _MIRR=0
N15 DEF REAL _WZR,_H1,_H2,_H3,_H4,_AT,_GT,_ZT,_RT,_PEA[3,2],_ERI,_BRI,_RURA,_CRAD,_WZMF=1,_EINRAD=2,_ADZI,_SDZI=1,_HS_A
N18 DEF INT _I1,_I2,_I3,_I4,_I14,_AZ,_AZB,_RFT,_SPIND,_H8
N19 DEF REAL _ZTSDIS
IF ($P_SIM==1) AND ($P_TOOL==0)
_SOWZ=TRUE
T0
MSG("$80013")
ELSE
_SOWZ=FALSE
ENDIF
N20 _X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 _WZR=$P_TOOLR _I1=$P_TOOL
_CRAD=ABS(_PRAD) _ADZI=ABS(_RFP-_DP)-ABS(_AD)
IF _ADZI<_FALD
_ADZI=_FALD
ENDIF
N25 IF ((_I1==0)OR(_WZR==0)) AND ($P_SIM==0) GOTOF _FEHL1 IF _WZR<0 GOTOF _FEHL9
_SPIND=ABS(_VARI) DIV 100 _VARI=_VARI MOD 100
IF _SPIND>2 GOTOF _FEHL2
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
_I2=ABS(_VARI) _I1=_I2 MOD 10 _I2=((_I2-_I1) DIV 10) MOD 10
N30 IF (_I1<1)OR(_I1>2)OR(_I2<0)OR(_I2>2)GOTOF _FEHL2 IF (_CDIR<0)OR(_CDIR>3) GOTOF _FEHL6 IF _I2<1 GOTOF _MY1
_ZB[0]=1
IF _I2==1 GOTOF _MY1
_ZB[1]=1
_MY1:_I1=_I1-1
IF _SOWZ==TRUE
_ZB[2]=1
ELSE
_ZB[2]=_I1
ENDIF
IF _FAL<>0
_ZB[10]=1
ENDIF
IF _FALD<>0
_ZB[9]=1
ENDIF
IF (_RTP==_RFP)AND(_DP==_RFP) GOTOF _FEHL11 IF _RTP==_RFP GOTOF _MY52 IF _RFP==_DP GOTOF _MY52 IF ((_RFP-_DP)/ABS(_RFP-_DP))<>((_RTP-_RFP)/ABS(_RTP-_RFP)) GOTOF _FEHL11
_MY52:
IF _RFP-_DP<>0
_H1=_RFP-_DP
ELSE
_H1=_RTP-_DP
ENDIF
_RFT=ABS(_H1)/_H1
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF (_CDIR==0) OR (_CDIR==2) GOTOF _SPG1
_CDIR=_CDIR-1
GOTOF _SPG2
_SPG1: _CDIR=_CDIR+1
_SPG2:
ENDIF
IF(_RFT==-1)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_ACTFRAME[_Z,MI])
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF _CDIR==2 GOTOF _MY3 IF _CDIR<>3 GOTOF _MY2
_ZB[3]=1
GOTOF _MY3
_MY2:
IF $P_SMODE[0]==1
_H1=$P_SDIR[$P_MSNUM]
ELSE
_ZB[3]=1
SETAL(62101)
GOTOF _MY3
ENDIF
IF (_H1<3) OR (_H1>4) GOTOF _FEHL3
N35 IF (_CDIR==0)AND(_H1==4) GOTOF _MY3 IF (_CDIR==1)AND(_H1==3) GOTOF _MY3
_ZB[3]=1
_MY3:
IF _SDIS<>0
_SDZI=_SDIS
ENDIF
IF (_ZSD[3]) AND ($P_GG[15]==3)
_ZB[8]=1
ENDIF
_H1=$MN_SCALING_SYSTEM_IS_METRIC _I1=$P_GG[13]
IF(_I1>2) GOTOF _MY5
IF (_H1-_I1)==-1 GOTOF _MY5 IF _H1==1 GOTOF _MY4M
_WZR=_WZR*$MN_SCALING_VALUE_INCH
GOTOF _MY5
_MY4M:_WZR=_WZR/$MN_SCALING_VALUE_INCH
_MY5:IF(_I1==2)OR(_I1==4) GOTOF _MY51
_WZMF=$MN_SCALING_VALUE_INCH _EINRAD=_EINRAD/_WZMF
IF _SDIS<>0 GOTOF _MY51
_SDZI=_SDZI/_WZMF
_MY51:_ERI=_CRAD
IF (_MIDA>2*_WZR) AND ($P_SIM==0)
IF NOT( (_ZB[2]==1) AND (_ZB[9]==0) AND (_ZB[10]==1) )
GOTOF _FEHL8
ENDIF
ENDIF
IF _WZR>=_CRAD GOTOF _FEHL4 IF NOT(_ZB[2])AND(_WZR>=ABS(_CRAD-_FAL)) GOTOF _FEHL4
_MY55:_ZB[6]=1
IF (_AP1>0)
_ZB[6]=0 _ZB[4]=1
ENDIF
IF _AD>0
_ZB[6]=0 _ZB[5]=1
ENDIF
IF _AP1<_WZR
_ZB[6]=1
ENDIF
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF _FEHL2
IF((_SPIND==1)AND(_I2>1)AND(_ZB[2]==0)) GOTOF _FEHL2
_MY61:
IF _FALD>ABS(_RFP-_DP)
IF _ZSD[1]==1
_FALD=ABS(_RFP-_DP)
ELSE
_FALD=ABS(_RFP-_DP)+ABS(_SDIS)
ENDIF
ENDIF
IF _MID>ABS(_RFP-_DP)
IF _ZSD[1]==1
_MID=ABS(_RFP-_DP)
ELSE
_MID=ABS(_RFP-_DP)+ABS(_SDIS)
ENDIF
ENDIF
_GT=ABS(_RFP-_DP) _AZ=1
IF _ZB[2] GOTOF _MQ11
_GT=_GT-ABS(_FALD)
_MQ11:IF _ZSD[1] GOTOF _MQ1
_GT=_GT+ABS(_SDIS)
_MQ1:IF (_MID==0) OR (_GT==0) GOTOF _MQ2
_AZ=TRUNC(_GT/_MID)
IF _MID*_AZ==_GT GOTOF _MQ2
_AZ=_AZ+1
N40 _MQ2:_ZT=_GT/_AZ _ZT=_ZT*_RFT
IF ABS(_AD)>=_GT
IF NOT((_ZB[2]==1) AND (_AZ==1) AND (_ZB[9]==1))
_ZB[7]=1
ENDIF
ENDIF
IF _ZB[6]==1
_ZB[7]=0
ENDIF
IF _SPIND==2
ST_CUST(_UMODE)
ENDIF
N100 _WKSN:ATRANS AX[_X]=_PA AX[_Y]=_PO
SBLON
N110 G0 G90 AX[_Z]=_RTP
N120 NORM CDOF DIAMOF CFTCP AX[_X]=0 AX[_Y]=0
N130 AX[_Z]=_RFP+_RFT*_SDIS
SBLOF
IF (_ZB[2]) AND (_AZ<>1) GOTOF _MSL1
IF (_ZB[2]) AND (_ZB[9]==0) GOTOF _MSL1
IF _ZB[2] GOTOF _SCHLICHTEND
N200 _SEB1:IF (_CRAD-_FAL-_WZR)>=_EINRAD GOTOF _MY71
_EINRAD=(_CRAD-_FAL-_WZR)
_MY71:_BRI=_MIDA _I1=1
IF _MIDA<>0 GOTOF _NXTIEF
_BRI=_WZR*1.6
_NXTIEF:_AT=_DP+((_AZ-_I1)*_ZT)
IF _AZ>1
IF _ZB[2]==0
IF(_I1==1)
WRTPR("TMP_BLK_BEG()",1)
ENDIF
IF(_I1==_AZ)
WRTPR("TMP_BLK_END()",1)
ENDIF
ENDIF
ENDIF
IF _ZB[7] GOTOF _SRROH
IF _ZB[6] GOTOF _SRV
IF ABS(_AT-_DP)+_FALD>_ADZI GOTOF _SRROH
_ZB[6]=1
N240 G0 G90 G40 AX[_X]=0 AX[_Y]=0
GOTOF _SRV
N400 _SRROH:_H1=ABS(_PRAD)-ABS(_AP1)-_FAL
IF (_H1<_BRI) AND (_ZB[7]==1)
_PRAD=_PRAD-_FAL _FAL=0 _CRAD=_PRAD _ERI=_CRAD _ZB[2]=1
IF _FALD>0
_DP=_DP+_FALD*(_RFP-_DP)/ABS(_RFP-_DP)
ENDIF
IF NOT(_ZB[7])
GOTOF _MSL1
ENDIF
ENDIF
_AZB=TRUNC(_H1/_BRI) _I3=1
IF _H1<=0 GOTOF _END1 IF _BRI*_AZB==_H1 GOTOF _MY90
_AZB=_AZB+1
_MY90:_BRI=_H1/_AZB _I2=1 _RURA=_ERI-_FAL-_H1+_BRI
IF ABS(_WZR-_AP1)<_EINRAD
_EINRAD=ABS(_WZR-_AP1)*0.9
ENDIF
_H2=_WZR+_EINRAD
IF NOT(_ZB[3]) GOTOF _MY92
_I3=-1
_MY92:
IF _ZB[3]==1
_PEA[0,0]=0 _PEA[0,1]=-(_AP1+_BRI)
_PEA[1,0]=_PEA[0,0]+_I3*_H2 _PEA[1,1]=-(_CRAD-_FAL-(_AZB-_I2)*_BRI-_H2 )
_PEA[2,0]=_CRAD-_FAL-_H2 _PEA[2,1]=-_I3*_H2
ELSE
_PEA[0,0]=0 _PEA[0,1]=_AP1+_BRI
_PEA[1,0]=_PEA[0,0]-_I3*_H2 _PEA[1,1]=_CRAD-_FAL-(_AZB-_I2)*_BRI-_H2
_PEA[2,0]=_CRAD-_FAL-_H2 _PEA[2,1]=-_I3*_H2
ENDIF
IF _ZB[3] GOTOF _AFG3
IF ( ( NOT (_EINRAD<2) ) AND (ABS(_PEA[1,0])-_WZR > 0) )
N420 G0 AX[_X]=0 AX[_Y]=_PEA[1,1]-_WZR
SBLON
N421 G0 AX[_Z]=_AT+_RFT*(_FALD+_SDZI)
SBLOF
IF NOT(_ZSD[3])
N422 G1 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N4221 G1 G42 G64 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
N423 G2 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ELSE
IF _ZB[8]
N422 G1 G94 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N4221 G1 G42 G95 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ELSE
N422 G1 G95 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N4221 G1 G42 G94 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ENDIF
N423 G2 G64 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ENDIF
ELSE
N420 G0 AX[_X]=0 AX[_Y]=0
SBLON
N421 G0 AX[_Z]=_AT+_RFT*(_FALD+_SDZI)
SBLOF
IF NOT(_ZSD[3])
N422 G1 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N423 G42 G64 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ELSE
IF _ZB[8]
N422 G1 G94 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N423 G42 G64 G95 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ELSE
N422 G1 G95 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N423 G42 G64 G94 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ENDIF
ENDIF
N4231 G2 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ENDIF
_NXRUG2:
N424 G2 AX[_X]=0 AX[_Y]=_RURA IP[_X]=AC(0) IP[_Y]=AC(0)
IF _I2<>_AZB GOTOF _MQ84
N427 G2 AX[_X]=(_CRAD-_FAL) AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N428 G2 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_H2
SBLON
N429 G0 G91 AX[_Z]=_RFT*_SDZI
SBLOF
N402 G90 G40 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1]+_WZR+0.001/_WZMF
GOTOF _END1
N425 _MQ84:G1 AX[_X]=_BRI
N426 G2 AX[_X]=_BRI+_RURA AX[_Y]=0 IP[_X]=AC(_BRI) IP[_Y]=AC(0)
_I2=_I2+1 _RURA=_RURA+_BRI
GOTOB _NXRUG2
_AFG3:
IF ( ( NOT (_EINRAD<2) ) AND (ABS(_PEA[1,0])-_WZR > 0) )
N410 G0 AX[_X]=0 AX[_Y]=_PEA[1,1]+_WZR
SBLON
N411 G0 AX[_Z]=_AT+_RFT*(_FALD+_SDZI)
SBLOF
IF NOT(_ZSD[3])
N412 G1 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N4121 G1 G41 G64 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
N413 G3 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ELSE
IF _ZB[8]
N412 G1 G94 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N4121 G1 G41 G95 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ELSE
N412 G1 G95 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N4121 G1 G41 G94 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ENDIF
N413 G3 G64 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ENDIF
ELSE
N410 G0 AX[_X]=0 AX[_Y]=0
SBLON
N411 G0 AX[_Z]=_AT+_RFT*(_FALD+_SDZI)
SBLOF
IF NOT(_ZSD[3])
N412 G1 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N413 G41 G64 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ELSE
IF _ZB[8]
N412 G1 G94 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N413 G41 G64 G95 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ELSE
N412 G1 G95 F=_FFD AX[_Z]=_AT+_RFT*_FALD
N413 G41 G64 G94 F=_FFP1 AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ENDIF
ENDIF
N4131 G3 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
ENDIF
_NXRU:
N414 G3 AX[_X]=0 AX[_Y]=-_RURA IP[_X]=AC(0) IP[_Y]=AC(0)
IF _I2<>_AZB GOTOF _MQ85
N417 G3 AX[_X]=(_CRAD-_FAL) AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N418 G3 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_H2
SBLON
N419 G0 G91 AX[_Z]=_RFT*_SDZI
SBLOF
N404 G90 G40 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1]-_WZR-0.001/_WZMF
GOTOF _END1
N415 _MQ85:G1 AX[_X]=_BRI
N416 G3 AX[_X]=_BRI+_RURA AX[_Y]=0 IP[_X]=AC(_BRI) IP[_Y]=AC(0)
_I2=_I2+1 _RURA=_RURA+_BRI
GOTOB _NXRU
N300 _SRV:_H1=_CRAD-_WZR
IF _ZB[2] GOTOF _MY79
_H1=_H1-_FAL
_MY79:_BRI=_MIDA
IF _MIDA<>0 GOTOF _MY79A
_BRI=_WZR*1.6
_MY79A:_AZB=TRUNC(_H1/_BRI) _I3=1
IF _BRI*_AZB==_H1 GOTOF _MY80
_AZB=_AZB+1
_MY80:_BRI=_H1/_AZB _I2=1 _RURA=0 _H2=_WZR+_EINRAD
IF NOT(_ZB[3]) GOTOF _MY84
_I3=-1
_MY84:
IF _ZB[2] GOTOF _SEB IF _ZB[1] GOTOF _ZUBAHN
IF ((_SPIND==1)AND(_ZB[2]==0))
ST_CUST(_UMODE)
ENDIF
IF _ZB[0] GOTOF _ZBG1
SBLON
N302 G0 AX[_Z]=_AT+_RFT*(_FALD+_SDZI)
SBLOF
_ZBG1:
IF NOT(_ZSD[3])
F=_FFD
ELSE
IF _ZB[8]
G94 F=_FFD
ELSE
G95 F=_FFD
ENDIF
ENDIF
N303 G1 AX[_Z]=_AT+_RFT*_FALD
IF ((_SPIND==1)AND(_ZB[2]==0))
ST_CUST(_UMODE+1)
ENDIF
GOTOF _SEB
N380 _ZUBAHN:
IF ((_ZSD[1]==0) AND (_I1==1))
_ZTSDIS=ABS(_ZT)
ELSE
_ZTSDIS=ABS(_ZT)+_SDIS
ENDIF
IF (_RAD1<=0) OR (_DP1<=0) GOTOF _FEHL5 IF ABS(_ZTSDIS)>=ABS(_DP1) GOTOF _MQ34
_I4=1
GOTOF _HELRAD
_MQ34:_I4=TRUNC(_ZTSDIS/_DP1)
IF _DP1*_I4==_ZTSDIS GOTOF _HELRAD
_I4=_I4+1
_HELRAD:_H4=_RAD1
IF _RAD1<_WZR GOTOF _FALL2
_H4=_WZR
_FALL2:IF _H4+_WZR<_PRAD-_FAL GOTOF _FALL3
_H4=_PRAD-_FAL-_WZR
IF _H4==0 GOTOF _FEHL4
GOTOF _HELBAHN
_FALL3: IF _H4==_RAD1 GOTOF _HELBAHN
_FALL3NEU: IF ABS(_ZT)/_I4/_H4<_DP1/_RAD1 GOTOF _HELBAHN
_I4=_I4+1
GOTOB _FALL3NEU
_HELBAHN:
N382 G0 G40 G90 AX[_X]=_H4
IF NOT(_ZSD[3])
F=_FFD
ELSE
IF _ZB[8]
G94 F=_FFD
ELSE
G95 F=_FFD
ENDIF
ENDIF
IF(_I1>1)
N383 G0 G64 G91 AX[_Z]=-_RFT*_SDZI
ENDIF
IF((_ZSD[1]==1) AND (_I1==1))
IF(_SDIS<>0)
_I14=TRUNC(ABS(_SDIS)/_DP1)
IF((_DP1*_I14)<>_SDIS)
_I14=_I14+1
ENDIF
IF NOT(_ZB[3])
N1160 G91 G2 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=-_SDIS IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I14-1 F=_FFD
ELSE
N1160 G91 G3 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=-_SDIS IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I14-1 F=_FFD
ENDIF
ENDIF
ENDIF
IF _ZB[3] GOTOF _HELG3
N384 G90 G2 G64 AX[_X]=_H4 AX[_Y]=0 AX[_Z]=(_AT+_RFT*_FALD) IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I4-1
GOTOF _HELKR
N385 _HELG3:G90 G3 G64 AX[_X]=_H4 AX[_Y]=0 AX[_Z]=(_AT+_RFT*_FALD) IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I4-1
_HELKR:
N386 G91 AX[_X]=0 AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N387 G1 G90 AX[_X]=0
N305 _SEB:
IF NOT(_ZSD[3])
F=_FFP1
ELSE
IF _ZB[8]
G95 F=_FFP1
ELSE
G94 F=_FFP1
ENDIF
ENDIF
_H1=_H1-_BRI _RURA=_ERI-_H1 _H3=_CRAD-(_AZB-_I2)*_BRI
IF _ZB[2] GOTOF _MY78
_RURA=_RURA-_FAL _H3=_H3-_FAL
_MY78:IF (_ZB[3])AND(_I2==1) GOTOF _MY930 IF _ZB[3] GOTOF _N310G3 IF _I2>1 GOTOF _N310
N320 G1 G42 G64 AX[_X]=_H3
N321 _N310:G2 G90 AX[_X]=-_RURA AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N322 G2 G90 AX[_X]=0 AX[_Y]=_RURA IP[_X]=AC(0) IP[_Y]=AC(0)
IF _I2<>_AZB GOTOF _MY93
N326 G2 AX[_X]=_RURA AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
IF _ZB[2]
N327 G2 AX[_X]=_CRAD-_H2 AX[_Y]=-_I3*_H2 IP[_X]=AC(_CRAD-_H2) IP[_Y]=AC(0)
ELSE
N328 G2 AX[_X]=_CRAD-_FAL-_H2 AX[_Y]=-_I3*_H2 IP[_X]=AC(_CRAD-_FAL-_H2) IP[_Y]=AC(0)
ENDIF
GOTOF _WEG1
_MY93:
IF (_I2==(_AZB-1))AND(_ZB[2])
N323 CFC G1 AX[_X]=_BRI
ELSE
N324 G1 AX[_X]=_BRI
ENDIF
N325 G2 AX[_X]=_BRI+_RURA AX[_Y]=0 IP[_X]=AC(_BRI) IP[_Y]=AC(0)
GOTOF _MY94
N310 _MY930:G1 G41 G64 AX[_X]=_H3
N311 _N310G3:G3 G90 AX[_X]=-_RURA AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N312 G3 G90 AX[_X]=0 AX[_Y]=-_RURA IP[_X]=AC(0) IP[_Y]=AC(0)
IF _I2<>_AZB GOTOF _MY93A
N316 G3 AX[_X]=_RURA AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
IF _ZB[2]
N317 G3 AX[_X]=_CRAD-_H2 AX[_Y]=-_I3*_H2 IP[_X]=AC(_CRAD-_H2) IP[_Y]=AC(0)
ELSE
N318 G3 AX[_X]=_CRAD-_FAL-_H2 AX[_Y]=-_I3*_H2 IP[_X]=AC(_CRAD-_FAL-_H2) IP[_Y]=AC(0)
ENDIF
N319 G1 G40 AX[_X]=_CRAD-_FAL-_H2 AX[_Y]=-_I3*_H2+(_WZR+0.001/_WZMF)*_I3
_WEG1:IF _I1==_AZ GOTOF _FINE IF _ZB[2] GOTOF _FINE
SBLON
N306 G0 G91 AX[_Z]=_RFT*_SDZI
N307 G90 G40 AX[_X]=0 AX[_Y]=0
SBLOF
GOTOF _END1
N315 _MY93A:
IF (_I2==(_AZB-1))AND(_ZB[2])
N313 CFC G1 AX[_X]=_BRI
ELSE
N314 G1 AX[_X]=_BRI
ENDIF
N315 G3 AX[_X]=_BRI+_RURA AX[_Y]=0 IP[_X]=AC(_BRI) IP[_Y]=AC(0)
_MY94:_I2=_I2+1
IF _I2<=_AZB GOTOB _SEB
_END1:_I1=_I1+1
IF _I1<=_AZ GOTOB _NXTIEF
IF _ZB[7] GOTOF _FINE
N500 _MSL1:IF _FALD>_MID GOTOF _FEHL7 IF (_CRAD-_WZR)>=_EINRAD GOTOF _MY74
_EINRAD=(_CRAD-_WZR)
_MY74:_H1=1
IF NOT _ZB[3] GOTOF _MSL3
_H1=-1
_MSL3:
IF NOT _FAL
IF _MIDA
_FAL=_MIDA
ELSE
_FAL=1.6*_WZR
ENDIF
IF (_CRAD-_WZR)<_FAL
_FAL=(_CRAD-_WZR)/2
ENDIF
ENDIF
IF NOT _FALD
IF _MID
_FALD=_MID
ELSE
IF ABS(_RFP-_DP)>2/_WZMF
_FALD=2/_WZMF
ELSE
_FALD=ABS(_RFP-_DP)
ENDIF
ENDIF
ENDIF
IF _SOWZ==TRUE GOTOF _MS1
_MS0:IF _ZB[10]==0 GOTOF _MS1 IF (_FAL<2*_WZR) GOTOF _MS1
_AP1=_CRAD-_FAL _FAL=0 _ZB[2]=0 _ADZI=_FALD _FALD=0
GOTOB _SEB1
_MS1:_H2=_WZR+_EINRAD _PEA[0,0]=_CRAD _PEA[0,1]=0
IF SQRT(POT(_CRAD-_WZR-_EINRAD)+POT(_EINRAD))<_CRAD-_FAL-_WZR GOTOF _MSL4
_I3=1 _H4=1/_WZMF
IF _CRAD-_FAL-_WZR-_H4<0
_H4=_CRAD-_FAL-_WZR
ENDIF
IF (POT(_CRAD-_FAL-_H4)-POT(_EINRAD)>=0.001)
_HS_A=SQRT(POT(_CRAD-_FAL-_H4)-POT(_EINRAD))-_WZR
ELSE
_HS_A=-_WZR
ENDIF
_MSL4:_PEA[1,0]=_PEA[0,0]-_H2 _PEA[1,1]=_PEA[0,1]+_H1*_H2 _PEA[2,0]=_PEA[1,0] _PEA[2,1]=_PEA[0,1]-_H1*_H2
_I1=1
_ANFSZ:_AT=_DP+((_AZ-_I1)*_ZT)
IF _ZB[10]==0
_AT=_DP _ZT=_ZT*_AZ
GOTOF _SCHLICHTEND
ENDIF
IF _ZB[9]==0 GOTOF _ANFSZ1 IF (_FALD<=ABS(_ZT))OR (_AZ-_I1<>1) GOTOF _ANFSZ1
_AT=_DP+_FALD*_RFT _ZT=_FALD*_RFT
_ANFSZ1:
IF _SOWZ==TRUE
_AT=_DP
ENDIF
IF NOT(_ZB[0]) AND (ABS(_AT-_DP)==_FALD)
N502 G90 G0 AX[_Z]=_AT+_RFT*_SDZI
ENDIF
IF NOT(_ZB[0]) AND (ABS(_AT-_DP)>_FALD)
N503 G90 G0 AX[_Z]=_AT
ELSE
IF NOT(_ZSD[3])
F=_FFD
ELSE
IF _ZB[8]
G94 F=_FFD
ELSE
G95 F=_FFD
ENDIF
ENDIF
N504 G1 G90 AX[_Z]=_AT
ENDIF
IF NOT(_ZSD[3])
F=_FFP1
ELSE
IF _ZB[8]
G95 F=_FFP1
ELSE
G94 F=_FFP1
ENDIF
ENDIF
IF (ABS(_AT-_DP)>_FALD)
N505 G0
ELSE
N506 G1
ENDIF
IF _ZB[3] GOTOF _SLEG3
IF _I3
IF SQRT(POT(_HS_A)+POT(_EINRAD))>(_PRAD-_FAL-_WZR)
_H3=(_PRAD-_FAL-_WZR)*0.9/SQRT(POT(_HS_A)+POT(_EINRAD))
ELSE
_H3=1
ENDIF
N518 G0 G90 G64 AX[_X]=_HS_A*_H3 AX[_Y]=_EINRAD*_H3
N519 G1 G42 CFC AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ELSE
N520 G0 G90 G64 G42 CFC AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ENDIF
N521 _SLG2:G2 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
N522 G2 AX[_X]=0 AX[_Y]=-_ERI IP[_X]=AC(0) IP[_Y]=AC(0)
GOTOF _KR270
_SLEG3:
IF _I3
IF SQRT(POT(_HS_A)+POT(_EINRAD))>(_PRAD-_FAL-_WZR)
_H3=(_PRAD-_FAL-_WZR)*0.9/SQRT(POT(_HS_A)+POT(_EINRAD))
ELSE
_H3=1
ENDIF
N508 G0 G90 G64 AX[_X]=_HS_A*_H3 AX[_Y]=-_EINRAD*_H3
N509 G1 G41 CFC AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ELSE
N510 G0 G90 G64 G41 CFC AX[_X]=_PEA[1,0] AX[_Y]=_PEA[1,1]
ENDIF
N511 _SLG3:G3 AX[_X]=_PEA[0,0] AX[_Y]=_PEA[0,1] CR=_H2
N512 G3 AX[_X]=0 AX[_Y]=_ERI IP[_X]=AC(0) IP[_Y]=AC(0)
N530 _KR270:AX[_X]=_ERI AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N531 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1] CR=_H2
N540 G1 G40 G90 AX[_X]=_PEA[2,0] AX[_Y]=_PEA[2,1]+(_WZR+0.001/_WZMF)*_H1
IF _I3
N541 AX[_X]=_HS_A*_H3 AX[_Y]=-_EINRAD*_H1*_H3
ENDIF
IF _AT==_DP+_FALD*_RFT
_AT=_DP+(_FALD+_SDZI)*_RFT _ZT=_FALD+_SDZI
N541 G0 AX[_Z]=_AT
ENDIF
_NT:_I1=_I1+1
IF _SOWZ==TRUE GOTOF _FINE
IF _I1<_AZ GOTOB _ANFSZ
IF (_I1==_AZ) AND (_ZB[7]==1) GOTOB _ANFSZ
IF (_I1==_AZ+1) AND (_ZB[7]==1) GOTOF _FINE
IF (_I1==_AZ) AND (_ZB[9]==0)
_AT=_DP
GOTOB _ANFSZ1
ENDIF
IF (_I1>_AZ) AND (_ZB[9]==0) GOTOF _FINE
N550 G0 G40 G90 CFTCP AX[_X]=0 AX[_Y]=0
_SCHLICHTEND:
IF _AZ==1
_AT=_DP+(_FALD+_SDZI)*_RFT _ZT=_FALD+_SDZI
N551 G0 AX[_Z]=_AT
ENDIF
N800 CFC
IF _ZB[1]
IF (_RAD1<=0) OR (_DP1<=0)
GOTOF _FEHL5
ENDIF
IF ABS(_ZT)>=ABS(_DP1) GOTOF _HB1
_I4=1
GOTOF _HBR
_HB1:_I4=TRUNC(ABS(_ZT)/_DP1)
IF _DP1*_I4==_ZT GOTOF _HBR
_I4=_I4+1
_HBR:_H4=_RAD1
IF _RAD1<_WZR GOTOF _FLL2
_H4=_WZR
_FLL2:IF _H4+_WZR<_PRAD-_FAL GOTOF _FLL3
_H4=_PRAD-_WZR
IF _H4==0
GOTOF _FEHL4
ENDIF
GOTOF _HBAHN
_FLL3: IF ABS(_ZT)/_I4/_H4<_DP1/_RAD1 GOTOF _HBAHN
_I4=_I4+1
GOTOB _FLL3
N580 _HBAHN:G0 G40 G90 AX[_X]=_H4
IF NOT(_ZSD[3])
F=_FFP1
ELSE
IF _ZB[8]
G95 F=_FFP1
ELSE
G94 F=_FFP1
ENDIF
ENDIF
IF _ZB[3] GOTOF _HLG3
N582 G91 G2 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=-_ZT IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I4-1
GOTOF _HLKR
N583 _HLG3:G91 G3 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=-_ZT IP[_X]=AC(0) IP[_Y]=AC(0) TURN=_I4-1
N584 _HLKR:G91 AX[_X]=0 AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N585 G1 G90 AX[_X]=0
ELSE
IF NOT(_ZSD[3])
F=_FFD
ELSE
IF _ZB[8]
G94 F=_FFD
ELSE
G95 F=_FFD
ENDIF
ENDIF
N586 G1 CFTCP AX[_Z]=_DP
N801 CFC
ENDIF
_ZB[6]=1
GOTOB _SEB1
N900 _FINE:
SBLON
N902 G0 G90 AX[_Z]=_RTP
N903 G40 AX[_X]=_CRAD-_FAL-_H2 AX[_Y]=-_I3*_H2+(_WZR+0.001/_WZMF)*_I3
IF _SPIND==2
SBLOF
ST_CUST(_UMODE+1)
SBLON
ENDIF
IF ($P_SIM==1) AND ($P_TOOL==0)
MSG("")
ENDIF
WRTPR("TMP_BLK_DEL()",1)

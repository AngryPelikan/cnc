PROC POCKET1 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL LENG,REAL WID,REAL CRAD,REAL CPA,REAL CPO,REAL STA1,REAL FFD,REAL FFP1,REAL MID,INT CDIR,REAL FAL,INT VARI,REAL MIDF,REAL FFP2,REAL SSF) SAVE DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.15 Jun 30, 2003
;Rechtecktaschen, nur Stirnfraeser
N10 DEF AXIS _X,_Y,_Z
N12 DEF REAL HH1,HH2,HH3,HH4,HH5,HH6,WZR,HHS,HHF,HHF1,HHL,HHW,HHZ,HHG,HR,HK,HHA,HHO,_SDZI
N14 DEF INT HZ1,HZ2,HZ4,HZE,HZE1
N24 DEF BOOL SOWZ,_MDG
DEF INT _MIRR=0
N18 _X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 SDIS=ABS(SDIS) DPR=ABS(DPR) HHL=ABS(LENG) HHW=ABS(WID) HK=SQRT(1.8)
CRAD=ABS(CRAD) MID=ABS(MID) MIDF=ABS(MIDF) VARI=ABS(VARI) HH6=STA1
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF CDIR==2
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
IF(_ZSD[1]==0)
_SDZI=SDIS
ENDIF
IF ($P_TOOL==0) AND ($P_SIM==1)
SOWZ=TRUE
MSG("$80013")
_MDG=1
ELSE
SOWZ=FALSE
ENDIF
IF ($P_TOOL==0) AND ($P_SIM==0) GOTOF FEHL6 IF ($P_TOOLR==0) AND ($P_SIM==0) GOTOF FEHL6 IF VARI>2 GOTOF FEHL5
IF(CDIR==2)OR(CDIR==3) GOTOF _MM00
N20 MSG("$80001")
CDIR=3 _MDG=1
_MM00:IF FFP2 GOTOF _MM01
FFP2=FFP1
_MM01:IF SSF<0 GOTOF _M01
HHS=$P_S[0]
_M01:IF SSF>0 GOTOF _MM02
SSF=HHS
_MM02:IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1A
N30 MSG("$80000")
_MDG=1
_MM0:DP=HH2
GOTOF _MM1A
_MM1:DPR=ABS(RFP-DP)
_MM1A:HH2=RTP-RFP
IF RFP==DP GOTOF _MM8 IF HH2==0 GOTOF _MM2 IF HH2/ABS(HH2) <> (RFP-DP)/DPR GOTOF FEHL1
_MM2:HH2=(RFP-DP)/DPR HHF=$P_F
IF SOWZ==TRUE
WZR=0
T0
VARI=2
ELSE
WZR=$P_TOOLR
ENDIF
HZ1=$MN_SCALING_SYSTEM_IS_METRIC HZ2=$P_GG[13]
IF(HZ2>2) GOTOF _MM2B
IF ((HZ1) AND (HZ2==2)) OR ((HZ1==0) AND (HZ2 <> 2)) GOTOF _MM2B IF HZ1 GOTOF _MM2A
WZR=WZR*$MN_SCALING_VALUE_INCH
GOTOF _MM2B
_MM2A:WZR=WZR/$MN_SCALING_VALUE_INCH
_MM2B:WZR=WZR/$P_ACTFRAME[_X,SC]
IF MIDF GOTOF _MM2C
MIDF=_SDZI+DPR
N100 _MM2C:ATRANS AX[_X]=CPA AX[_Y]=CPO
IF HHL>=HHW GOTOF _MM3
HHL=HHW HHW=ABS(LENG) HH6=HH6+90
_MM3:IF CRAD<=HHW/2 GOTOF _MM3B
CRAD=HHW/2
_MM3B:HH3=HHW/2-FAL
N110 AROT AX[_Z]=HH6
IF WZR>=HHW/2 GOTOF FEHL4 IF HH3>WZR GOTOF _MM3A
FAL=HHW/2-WZR-1/$MN_INT_INCR_PER_MM HH3=HHW/2-FAL
_MM3A:IF FAL<WZR*2 GOTOF _MMA
IF SOWZ==TRUE GOTOF _MMA
N115 MSG("$80003")
_MDG=1
_MMA:HHF1=FFP1 HH4=(HHL-HHW)/2
IF SOWZ==TRUE GOTOF VS2
HZE=(HH3-WZR*(1+0.5*HK))/WZR/HK+0.4999 HK=(HH3/WZR-1)/(0.5+HZE) HZE=HZE+1 HHZ=HK*WZR HHG=HHZ/2+WZR HZE1=HZE
VS2:
IF MID GOTOF _MM4
MID=_SDZI+DPR
_MM4:HZ1=(_SDZI+DPR)/MID+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1
N120 G0 G40 G64 G90 CDOF AX[_X]=0 AX[_Y]=0
IF (VARI==2)
N130 G60 AX[_X]=HH4+HHG-WZR AX[_Y]=0
ENDIF
N140 G64 AX[_Z]=RFP+SDIS*HH2
IF CDIR==2 GOTOF _MG0
N150 AMIRROR AX[_Y]=0
_MG0:IF VARI==2 GOTOF _MS1
_MM5:
IF HZ1>1
IF(HZ2==1)
WRTPR("TMP_BLK_BEG()",1)
ENDIF
IF(HZ2==HZ1)
WRTPR("TMP_BLK_END()",1)
ENDIF
ENDIF
N160 G1 G90 G60 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
IF NOT( (VARI==2) )
N165 G60 F=FFP1 AX[_X]=HH4+HHG-WZR AX[_Y]=0
ENDIF
IF HZ4 GOTOF _MM3C
HH5=CRAD-FAL HR=HH5+HHG-HH3
_MM3C:
N200 G1 G42 NORM G64 AX[_X]=HH4+HHG AX[_Y]=0 F=HHF1
_MG1:IF HR>WZR GOTOF _MM3D
N202 G1 AX[_Y]=-HHG
N204 AX[_X]=-(HH4+HHG)
N206 AX[_Y]=HHG
GOTOF _MM3E
N208 _MM3D: G1 AX[_Y]=-HHG+HR
N210 G2 AX[_X]=HH4+HHG-HR AX[_Y]=-HHG CR=HR
N220 G1 AX[_X]=-(HH4+HHG-HR)
N230 G2 AX[_X]=-(HH4+HHG) AX[_Y]=HR-HHG CR=HR
N240 G1 AX[_Y]=HHG-HR
N250 G2 AX[_X]=-(HH4+HHG-HR) AX[_Y]=HHG CR=HR
_MM3E:IF HZ4 GOTOF _MG2
HZE1=HZE1-1 HR=HH5-HH3+HHZ+HHG HHG=HHG+HHZ
IF HZE1 GOTOF _MG1A
HHZ=0
_MG1A:IF HZE1>1 GOTOF _MG2
HHG=HH3 HR=CRAD-FAL
_MG2:IF HR>WZR GOTOF _MG2A
N260 G1 AX[_X]=HH4+HHG AX[_Y]=HHG-HHZ
GOTOF _MG2C
_MG2A:HHA=HR
IF HR<=HHG-HHZ GOTOF _MG2B
HR=HHG-HHZ
N262 _MG2B:G1 AX[_X]=HH4+HHG-HR AX[_Y]=HHG-HHZ
N270 G2 AX[_X]=HH4+HHG AX[_Y]=HHG-HHZ-HR CR=HR
HR=HHA
_MG2C:IF HZE1>1 GOTOB _MG1 IF HZE1==0 GOTOF _MG2D
HH5=HK*WZR HHZ=0
GOTOB _MG1
N280 _MG2D:G1 AX[_X]=HH4+HHG AX[_Y]=0
N290 G2 AX[_X]=HH4+HHG*COS(45) AX[_Y]=-HHG*SIN(45) IP[_X]=AC(HH4) IP[_Y]=AC(0)
IF (NOT(VARI==2))
N292 G40 G1 F=FFP1 AX[_X]=0 AX[_Y]=0
ELSE
N292 G40 G1 F=FFP1 AX[_X]=HH4+HK*WZR/2*COS(45) AX[_Y]=0
ENDIF
IF HZ4 GOTOF _MM7B
HZ2=HZ2+1 HHZ=HK*WZR HZE1=HZE HHG=HHZ/2+WZR
IF HZ2>HZ1 GOTOF _MS0
GOTOB _MM5
_MS0:IF HZ4 GOTOF _MM7B IF (VARI==1) OR (FAL==0) GOTOF _MM7C
_MS1: HZ4=1 HZ1=(_SDZI+DPR)/MIDF+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1 HHF1=FFP2 HH3=HHW/2 HR=CRAD HHG=HH3 HHZ=0 HZE1=0
IF SSF<0 GOTOF _MS4
N294 S=SSF G60
_MS4:
IF SOWZ==TRUE
HZ2=HZ1
ENDIF
N300 G60 G90 G1 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
N305 G1 G64 G42 NORM AX[_X]=HH4+HHG*COS(45) AX[_Y]=HHG*SIN(45) F=HHF1
N310 G2 AX[_X]=HH4+HHG AX[_Y]=0 IP[_X]=AC(HH4) IP[_Y]=AC(0)
GOTOB _MG1
_MM7B:HZ2=HZ2+1 HHA=HH3-FAL
IF SOWZ==TRUE GOTOF VS1
IF HZ2<=HZ1 GOTOB _MS4
VS1:
N350 _MM7C:G0 G90 AX[_Z]=RTP
N360 AX[_X]=0 AX[_Y]=0
HZ2=1 HZ4=0
IF HHF GOTOF _MM7D
HHF=HHF1
_MM7D: F=HHF
IF SSF<0 GOTOF _MM8
S=HHS
N370 _MM8:
IF _MDG==1
MSG("")
ENDIF
WRTPR("TMP_BLK_DEL()",1)
RET
N382 FEHL1:STOPRE
SETAL(61101)
RET
N384 FEHL4:STOPRE
SETAL(61105)
RET
N386 FEHL5:STOPRE
SETAL(61002)
RET
N388 FEHL6:STOPRE
SETAL(61000)
RET

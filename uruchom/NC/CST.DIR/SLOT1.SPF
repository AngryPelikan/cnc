PROC SLOT1 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,INT NUM,REAL LENG,REAL WID,REAL CPA,REAL CPO,REAL RAD,REAL STA1,REAL INDA,REAL FFD,REAL FFP1,REAL MID,INT CDIR,REAL FAL,INT VARI,REAL MIDF,REAL FFP2,REAL SSF,REAL _FALD,REAL _STA2,REAL _DP1,INT _UMODE) SAVE SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.17 Sep 08, 2003
;Nut
DEF AXIS _X,_Y,_Z
DEF REAL HH1,HH2,HH3,HH4,HH5,HH6,HH7,HH8,HH9,WZR,HHS,HHF,HHF1,_SDZI,_DPT
DEF INT HZ1,HZ2,HZ3,HZ4
DEF INT _HH1,_HH2,_HH4,_I1,_I3,_I4,_I4MERK,_I14,_SPIND,_H8
DEF REAL _H1,_H4,_H5,_LINT,_WINT,_ZT,_GT,_RT,_AZ,_HH3,_ZTSDIS,_THE,_H15,_ZTP
DEF REAL _H6, _H7
DEF BOOL SOWZ,_H9,_H10,_H11
DEF BOOL _MDG
DEF INT _MIRR=0
DEF INT _SLGR=0
DEF INT _ZB[9]
_X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 SDIS=ABS(SDIS) DPR=ABS(DPR) LENG=ABS(LENG) WID=ABS(WID)
RAD=ABS(RAD) NUM=ABS(NUM) MID=ABS(MID) MIDF=ABS(MIDF) VARI=ABS(VARI) HH6=STA1 FAL=ABS(FAL) _FALD=ABS(_FALD)
IF(LENG==WID) GOTOF _FEHL9
IF SUBSTR($P_PROG[$P_STACK-1],3,7)=="POCKET3"
IF ((MIDF==0) AND ((VARI==2) OR (VARI==12)))
MIDF=MID
ENDIF
ENDIF
IF ((VARI==0) OR (VARI==1) OR (VARI==2))
IF (($P_SUBPAR[23]==FALSE) AND ($P_SUBPAR[24]==FALSE))
VARI=VARI + 10
ENDIF
ENDIF
_SPIND=ABS(VARI) DIV 100 VARI=VARI MOD 100
IF _SPIND>2 GOTOF FEHL5
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
_HH2=VARI MOD 10 _HH1=(VARI MOD 100) DIV 10
IF (_HH1<0) OR (_HH1>3) GOTOF FEHL5
IF (_HH2<0) OR (_HH2>2) GOTOF FEHL5
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF FEHL5
IF((_SPIND==1)AND(_HH1>1)AND(_HH2<2)) GOTOF FEHL5
IF CDIR==2 GOTOF _MY3 IF CDIR<>3 GOTOF _MY2
_ZB[3]=1
GOTOF _MY3
_MY2:
IF $P_SMODE[0]==1
_H1=$P_SDIR[$P_MSNUM]
ELSE
_ZB[3]=1
SETAL(62101)
GOTOF _MY3
ENDIF
IF (_H1<3) OR (_H1>4) GOTOF _FEHL10
IF (CDIR==0)AND(_H1==4) GOTOF _MY3 IF (CDIR==1)AND(_H1==3) GOTOF _MY3
_ZB[3]=1
_MY3:
IF (_ZSD[3]) AND ($P_GG[15]==3)
_ZB[8]=1
ENDIF
IF (CDIR==0) OR (CDIR==1)
IF CDIR==0
IF _H1==4
CDIR=CDIR+2
ELSE
CDIR=CDIR+3
ENDIF
ELSE
IF _H1==4
CDIR=CDIR+2
ELSE
CDIR=CDIR+1
ENDIF
ENDIF
ENDIF
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF CDIR==2
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
IF _HH2==2
_FALD=0
GOTOF _MAR1
ENDIF
IF _FALD>0
IF DPR>0
DPR=DPR-_FALD
ELSE
DP=DP+_FALD
ENDIF
ENDIF
IF (_HH1==3) OR (_HH1==2)
MIDF=0
ENDIF
_MAR1:
IF(_ZSD[1]==0)
_SDZI=SDIS
ENDIF
IF ($P_TOOL==0) AND ($P_SIM==1)
SOWZ=TRUE
MSG("$80013")
_MDG=1
T0
_HH2=2
ELSE
SOWZ=FALSE
ENDIF
IF ($P_TOOL==0) AND ($P_SIM==0) GOTOF FEHL6
IF VARI>32 GOTOF FEHL5 IF NUM==0 GOTOF FEHL2
IF _HH2<2 GOTOF _MMA IF FAL GOTOF _MMA
FAL=WID
_MMA:IF(CDIR==2)OR(CDIR==3) GOTOF _MM00
MSG("$80001")
CDIR=3 _MDG=1
_MM00:IF FFP2 GOTOF _MM01
FFP2=FFP1
_MM01:IF SSF<0 GOTOF _M01
HHS=$P_S[0]
_M01:IF SSF>0 GOTOF _MM02
SSF=HHS
_MM02:IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1 IF VARI > 32 GOTOF FEHL5
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1A
N10 MSG("$80000")
_MDG=1
_MM0: DP=HH2
GOTOF _MM1A
_MM1:DPR=ABS(RFP-DP)
_MM1A:HH2=RTP-RFP
IF RFP==DP GOTOF _MM8
IF HH2==0 GOTOF _MM2 IF HH2/ABS(HH2) <> (RFP-DP)/DPR GOTOF FEHL1
_MM2:HH1=INDA*(NUM-1) HH2=(RFP-DP)/DPR WZR=$P_TOOLR HHF=$P_F
HZ1=$MN_SCALING_SYSTEM_IS_METRIC HZ2=$P_GG[13]
IF(HZ2>2) GOTOF _MM2B
IF ((HZ1) AND (HZ2==2)) OR ((HZ1==0) AND (HZ2 <> 2)) GOTOF _MM2B
IF HZ1 GOTOF _MM2A
WZR=WZR*$MN_SCALING_VALUE_INCH
GOTOF _MM2B
_MM2A:WZR=WZR/$MN_SCALING_VALUE_INCH
_MM2B:WZR=WZR/$P_ACTFRAME[_X,SC]
IF MIDF GOTOF _MM2C
MIDF=_SDZI+DPR
_MM2C:IF WZR > WID/2 GOTOF FEHL4 IF NUM==1 GOTOF _MM14 IF INDA GOTOF _MM3
INDA=360/NUM
GOTOF _MM4
_MM3: IF ABS(HH1) >= 360 GOTOF FEHL2 IF (HH1<=180) GOTOF _MM4
IF ABS((RAD+WID/2)*SIN(HH1/2)) <=WID/2 GOTOF FEHL3
_MM4:IF (HH1>180) GOTOF _MM14 IF ABS((RAD+WID/2)*SIN(INDA/2)) <=WID/2 GOTOF FEHL3
_MM14:
IF ((_SPIND==2)AND(_H11==0))
ST_CUST(_UMODE)
_H11=1
ENDIF
ATRANS AX[_X]=CPA AX[_Y]=CPO
HH4=RAD+WID/2 HH5=RAD+LENG-WID/2
IF HH5<HH4 GOTOF FEHL3
IF MID GOTOF _MM4A
MID=_SDZI+DPR
_MM4A:
IF _ZSD[1]==0
HZ1=(SDIS+DPR)/MID+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(SDIS+DPR)/HZ1 HH7=1 HZ2=1 HH3=WID/2-FAL
ELSE
HZ1=DPR/MID+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=DPR/HZ1 HH7=1 HZ2=1 HH3=WID/2-FAL
ENDIF
IF HH3>WZR GOTOF _MM5
FAL=WID/2-WZR HH3=WZR
_MM5:HH8=HH3 HH9=0 HHF1=FFP1
_MM6:
IF SOWZ==TRUE GOTOF VS1
MSG("$80007")
_MDG=1
VS1:
AROT AX[_Z]=HH6
SBLON
N11G0 G40 G60 G90 CFTCP AX[_X]=HH4 AX[_Y]=0
IF ((_SPIND==1)AND(_HH2<2))
SBLOF
ST_CUST(_UMODE)
SBLON
_H9=1
ENDIF
_HH3=RFP+SDIS*HH2
N50 G64 AX[_Z]=_HH3
SBLOF
IF _HH2==2 GOTOF _MS1
_MM7:
IF HZ1>1
IF(HZ2==1)
WRTPR("TMP_BLK_BEG()",1)
ENDIF
IF(HZ2==HZ1)
WRTPR("TMP_BLK_END()",1)
ENDIF
ENDIF
IF SOWZ==TRUE
HZ2=HZ1
ENDIF
_SLGR=0
CASE _HH1 OF 0 GOTOF _TG0 1 GOTOF _TG1 2 GOTOF _TG2 3 GOTOF _TG3
_TG3:
IF((VARI MOD 10)==1)
_GT=ABS(DPR)-_FALD
ELSE
_GT=ABS(DPR)
ENDIF
IF _ZSD[1]==0
_GT=_GT+ABS(SDIS)
ENDIF
_AZ=TRUNC(_GT/MID)
IF MID*_AZ==_GT GOTOF _MQ2
_AZ=_AZ+1
_MQ2:HZ1=_AZ
_ZT=_GT/_AZ
_LINT=ABS(LENG)/2 _WINT=ABS(WID)/2
_LINT=_LINT-FAL _WINT=_WINT-FAL
_I3=1 _H4=_LINT-_WINT
IF NOT(_STA2==0)
_H5=ABS(TAN(_STA2))*2*_H4
ELSE
GOTOF _FEHL7
ENDIF
IF ABS(_ZT)>ABS(_H5) GOTOF _ZP05
_I4=1
GOTOF _ZP10
_ZP05:_I4=TRUNC(ABS(_ZT)/_H5)
IF _H5*_I4==ABS(_ZT) GOTOF _ZP10
_I4=_I4+1
_ZP10:_H5=(_ZT/_I4) _I4MERK=_I4
IF (HH3==WZR)
IF (_I4 MOD 2 ==1)
_H4=_H4*HH7
ENDIF
ENDIF
IF (_I4 MOD 2)<>1
IF NOT(SDIS==0)
IF ( ABS($P_EP[_Z]-_HH3)>SDIS )
SBLON
N149 G0 G91 AX[_Z]=HH2*SDIS
SBLOF
N150 G0 G90 AX[_X]=HH4
N151 G1 G91 AX[_Z]=-HH2*SDIS
ELSE
N152 G0 G90 AX[_X]=HH4
ENDIF
ELSE
N153 G1 G90 AX[_X]=HH4
ENDIF
ELSE
IF NOT(SDIS==0)
IF ( ABS($P_EP[_Z]-_HH3)>SDIS )
SBLON
N154 G0 G91 AX[_Z]=HH2*SDIS
SBLOF
N155 G0 G91 AX[_X]=_H4*2
N156 G1 G91 AX[_Z]=-HH2*SDIS
ELSE
N157 G0 G91 AX[_X]=_H4*2
ENDIF
ELSE
N158 G1 G91 AX[_X]=_H4*2
ENDIF
_I3=-_I3
ENDIF
IF NOT(_ZSD[3])
F=FFD
ELSE
IF _ZB[8]
G94 F=FFD
ELSE
G95 F=FFD
ENDIF
ENDIF
IF((_ZSD[1]==1) AND (HZ2==1))
_H15=ABS(TAN(_STA2))*2*_H4
_ZTP=_ZT+SDIS
IF ABS(_ZTP)>ABS(_H15) GOTOF _ZPP05
_I14=1
GOTOF _ZPP10
_ZPP05:_I14=TRUNC(ABS(_ZTP)/_H15)
IF _H15*_I14==ABS(_ZT) GOTOF _ZPP10
_I14=_I14+1
_ZPP10:_H15=_ZTP/_I14
_ZPPNEXT:
N1161 G1 G91 F=FFD AX[_X]=_I3*_H4*2 AX[_Z]=-_H15
_I3=-_I3 _I14=_I14-1
IF _I14>0 GOTOB _ZPPNEXT
ENDIF
IF((_ZSD[1]==1) AND (HZ2==1)) GOTOF _M6201
_ZPNEXT: _H6=DP+(HZ1-HZ2)*_ZT*HH2+_H5*(_I4-1) _H7=$P_EP[_X]+_I3*_H4*2
IF(HZ2==HZ1) AND (_I4==1) AND ((VARI MOD 10)==1)
N161 G1 G90 AX[_X]=_H7 AX[_Z]=_H6
ELSE
N161 G1 G90 AX[_X]=_H7 AX[_Z]=_H6
ENDIF
_I3=-_I3 _I4=_I4-1
IF _I4>0 GOTOB _ZPNEXT
_M6201:
IF NOT ((_HH1==3) AND (HH3==WZR))
N162 G1 G60 G90 CFTCP AX[_X]=HH4 AX[_Y]=0
ENDIF
GOTOF _TG4
_TG2:
_WINT=ABS(WID)/2
_WINT=_WINT-FAL
_DPT=DP-RFP-(SDIS*HH2)
_FALD=_FALD*HH2
IF(_HH2==0) OR (_HH2==2)
IF(HH2==1)
_ZT=_DPT+(HZ1-HZ2)*HH1*HH2
ELSE
_ZT=(_DPT+_FALD*2)+(HZ1-HZ2)*HH1*HH2
ENDIF
ELSE
_ZT=(_DPT+_FALD)+(HZ1-HZ2)*HH1*HH2
ENDIF
IF (_ZSD[1]==0)
_ZTSDIS=ABS(_ZT)
ELSE
_ZTSDIS=ABS(_ZT)+SDIS
ENDIF
IF(HZ2>1)
_ZTSDIS=HH1
ENDIF
IF (_STA2<=0) GOTOF _FEHL8 IF (_DP1<=0) GOTOF _FEHL8 IF ABS(_ZTSDIS)>=ABS(_DP1) GOTOF _MQ34
_I4=1
GOTOF _HELRAD
_MQ34:_I4=TRUNC(ABS(_ZTSDIS)/_DP1)
IF _DP1*_I4==_ZTSDIS GOTOF _HELRAD
_I4=_I4+1
_HELRAD:_H4=_STA2
IF(_STA2<=WZR)
_H4=WZR+0.2*WZR
ENDIF
IF _H4>_WINT
_H4=_WINT
ENDIF
IF _H4==0 GOTOF FEHL4
GOTOF _HELBAHN
_FALL3: IF _H4==_STA2 GOTOF _HELBAHN
_FALL3NEU: IF ABS(_ZTSDIS)/_I4/_H4<=_DP1/_STA2 GOTOF _HELBAHN
_I4=_I4+1
GOTOB _FALL3NEU
_HELBAHN:
N150 G0 G40 G91 AX[_X]=_H4-WZR
IF NOT(_ZSD[3])
F=FFD
ELSE
IF _ZB[8]
G94 F=FFD
ELSE
G95 F=FFD
ENDIF
ENDIF
_THE=_ZT
IF(HZ2>1)
_THE=(-HH1)*HH2
ENDIF
IF NOT(_ZSD[3])
F=FFP1
ELSE
IF _ZB[8]
G95 F=FFP1
ELSE
G94 F=FFP1
ENDIF
ENDIF
IF(HZ2<HZ1) OR NOT ((VARI MOD 10)==1)
ENDIF
IF NOT(_ZB[3])
N170 G91 G2 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=_THE IP[_X]=-(_H4-WZR) IP[_Y]=AC(0) TURN=_I4-1
ELSE
N170 G91 G3 G64 AX[_X]=0 AX[_Y]=0 AX[_Z]=_THE IP[_X]=-(_H4-WZR) IP[_Y]=AC(0) TURN=_I4-1
ENDIF
IF(HZ2<HZ1) OR NOT ((VARI MOD 10)==1)
ENDIF
N190 G91 AX[_X]=0 AX[_Y]=0 IP[_X]=-(_H4-WZR) IP[_Y]=AC(0)
N195 G1 G91 AX[_X]=-(_H4-WZR)
G90
GOTOF _TG4
_TG0:
IF ((_H9==0)AND(_H10==0))
IF ((_SPIND==1)AND(_HH2<2))
ST_CUST(_UMODE)
ENDIF
ENDIF
_H9=0
IF(HZ2<HZ1) OR NOT ((VARI MOD 10)==1)
SBLON
ENDIF
N20 G0 G90 G60 AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
IF(HZ2<HZ1) OR NOT ((VARI MOD 10)==1)
SBLOF
ENDIF
GOTOF _TG4
_TG1:
IF ((_H9==0)AND(_H10==0))
IF ((_SPIND==1)AND(_HH2<2))
ST_CUST(_UMODE)
ENDIF
ENDIF
_H9=0
IF NOT(_ZSD[3])
F=FFD
ELSE
IF _ZB[8]
G94 F=FFD
ELSE
G95 F=FFD
ENDIF
ENDIF
IF(HZ2<HZ1) OR NOT ((VARI MOD 10)==1)
SBLON
ENDIF
N21 G1 G90 G60 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
IF(HZ2<HZ1) OR NOT ((VARI MOD 10)==1)
SBLOF
ENDIF
_TG4:
IF _H10==0
IF ((_SPIND==1)AND(_HH2<2))
ST_CUST(_UMODE+1)
ENDIF
ENDIF
IF HH3 > WZR GOTOF _MG0
IF NOT(_ZSD[3])
F=HHF1
ELSE
IF _ZB[8]
G95 F=HHF1
ELSE
G94 F=HHF1
ENDIF
ENDIF
IF ((_I4MERK MOD 2 == 0) AND (VARI DIV 10 >1) )
N100 G91 AX[_X]=(HH5-HH4) AX[_Y]=0 F=HHF1
ELSE
N101 G91 AX[_X]=(HH5-HH4)*HH7 AX[_Y]=0 F=HHF1
ENDIF
HH7=-HH7
_MM7A:HZ2=HZ2+1
IF SOWZ==TRUE GOTOF _MS0
IF HZ2 <= HZ1 GOTOB _MM7
GOTOF _MS0
_MG0:
IF NOT(_ZSD[3])
F=HHF1
ELSE
IF _ZB[8]
G95 F=HHF1
ELSE
G94 F=HHF1
ENDIF
ENDIF
IF CDIR==2 GOTOF _MG2
_MG1:
G1 G41 NORM G64 AX[_X]=HH4+HH8*HH7 AX[_Y]=HH9*HH7
N310G3 AX[_X]=HH4 AX[_Y]=-HH3*HH7 CR=-HH3
N320G1 AX[_X]=HH5
N330G3 AX[_X]=HH5 AX[_Y]=HH3*HH7 CR=HH3
N340G1 AX[_X]=HH4
N350G3 AX[_X]=HH4-(WZR+4*HH3)/5*HH7 AX[_Y]=(HH3-(WZR+4*HH3)/5)*HH7 CR=(WZR+4*HH3)/5
IF(HZ2<HZ1)
ENDIF
N360G1 G40 G60 AX[_X]=HH4 AX[_Y]=0
IF(HZ2<HZ1)
ENDIF
GOTOB _MM7A
N200_MG2:
G1 G42 NORM G64 AX[_X]=HH4+HH8*HH7 AX[_Y]=-HH9*HH7
N210G2 AX[_X]=HH4 AX[_Y]=HH3*HH7 CR=-HH3
N220G1 AX[_X]=HH5
N230G2 AX[_X]=HH5 AX[_Y]=-HH3*HH7 CR=HH3
N240G1 AX[_X]=HH4
N250G2 AX[_X]=HH4-(WZR+4*HH3)/5*HH7 AX[_Y]=-(HH3-(WZR+4*HH3)/5)*HH7 CR=(WZR+4*HH3)/5
IF(HZ2<HZ1)
ENDIF
N260G1 G40 G60 AX[_X]=HH4 AX[_Y]=0
IF(HZ2<HZ1)
ENDIF
GOTOB _MM7A
_MS0:
IF (VARI==30)
N400 G0 AX[_Z]=RFP+SDIS*HH2
N401 G0 G90 AX[_X]=HH4 AX[_Y]=0
ENDIF
IF HZ4 GOTOF _MM7B IF (_HH2==1) OR (FAL==0) GOTOF _MM7C
N261 _MS1:CFC
IF WZR==WID/2 GOTOF _MS2
HH9=WID/2*(HH3-WZR)/(WID/2-WZR) HH8=SQRT(POT(WID/2)-POT(HH9))
_MS2:HH3=WID/2 HZ4=1 HZ1=(_SDZI+DPR)/MIDF+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1 HHF1=FFP2 _H10=1
IF HH7>0 GOTOF _MS3
HH7=HH4 HH4=HH5 HH5=HH7 HH7=-1
_MS3:
IF _HH1<2 GOTOF _MMAR1
IF _HH2>0 GOTOF _MMAR1
GOTOB _TG4
_MMAR1:IF SSF<0 GOTOB _MM7
S=SSF G60
GOTOB _MM7
_MM7B:IF HH3<=WZR GOTOF _MM7C IF HH7>0 GOTOF _MM7C
HH7=HH4 HH4=HH5 HH5=HH7 HH7=1
_MM7C:
IF _HH2==1 GOTOF _MM7D
IF _FALD==0 GOTOF _MM7D
IF _SLGR==1 GOTOF _MM7D
IF NOT(_ZSD[3])
F=FFD
ELSE
IF _ZB[8]
G94 F=FFD
ELSE
G95 F=FFD
ENDIF
ENDIF
G0 G90 AX[_X]=HH4 AX[_Y]=0
N880 G1 G91 G64 AX[_Z]=-_FALD
_SLGR=1
G90
GOTOB _MG0
_MM7D:SBLON
G0 G90 AX[_Z]=RTP
AX[_X]=HH4 AX[_Y]=0
HZ2=1 HH6=INDA HZ3=HZ3+1 HZ4=0 _H10=0
IF HZ3>=NUM GOTOF _M7D
IF SSF<0 GOTOB _MM4A
S=HHS
GOTOB _MM4A
_M7D:
IF _SPIND==2
ST_CUST(_UMODE+1)
_H11=0
ENDIF
IF HHF GOTOF _MM7E
HHF=HHF1
_MM7E: F=HHF
IF SSF<0 GOTOF _MM8
S=HHS
_MM8:
IF _MDG==1
MSG("")
ENDIF
SBLON
WRTPR("TMP_BLK_DEL()",1)
RET
FEHL1:STOPRE
SETAL(61101)
RET
FEHL2:STOPRE
SETAL(61106)
RET
FEHL3:STOPRE
SETAL(61104)
RET
FEHL4:STOPRE
SETAL(61105)
RET
FEHL5:STOPRE
SETAL(61002)
RET
FEHL6:STOPRE
SETAL(61000)
RET
_FEHL7:STOPRE
SETAL(61128)
RET
_FEHL8:STOPRE
SETAL(61108)
RET
_FEHL9:STOPRE
SETAL(61609)
RET
_FEHL10:STOPRE
N720 SETAL(61102)
RET
_FEHL12:STOPRE
N711 SETAL(61002)
RET

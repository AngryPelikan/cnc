N101 PROC WECHSEL (INT TNR, INT DRR, INT DRZ)



;WECHSELPROGRAMM FUER V I S I O N - S P R I N T mit Werkzeugerkennung
;GEAENDERTE VERSION FUER VISION MIT FESTSTEHENDEM WECHSLER
;STAND 28.02.02

N102 DEF INT INFO_ABLEGENABHOLEN=0
N103 DEF INT INFO_ABHOLEN=0
N104 DEF INT INFO_NURABHOLEN=0
N105 DEF INT INFO_NURHOLEN=0
N106 DEF INT INFO_NURABLEGEN=0
N107 DEF REAL Z_ACHSE_HUB=630.0       ;Oberste Z-Position
N108 DEF REAL Z_ACHSE_ZANGENMASS=561.8;562 ;Wechselposition Z-Achse
N109 DEF REAL Y_ACHSE_ZANGENMASS=1584 ;WechselpositionY-Achse
N110 DEF REAL Y_ACHSE_ZANGEFREI=1180  ;Aus Wechselposition fahren
N111 DEF REAL Y_SCHMIERPOS=1570       ;Y- LUBE position

N112 T=TNR ; --> Ausgabe T-wort an NC/SPS

N113 IF $P_SIM==1 GOTOF OHNE_SIM
N114 IF $P_SEARCH==1 GOTOF OHNE_SIM
N115 G64 G602 G53 H90
N116 H76;     ;Unterprogramm aktiv
;N116 MSG("WERKZEUGWECHSEL AKTIV")
;N215 MSG("TOOL CHANGING IS ACTIV")
;N215 MSG("CHANGEMENT OUTIL ACTIF")
;N215 MSG("WERKTUIG WISSELING ACTIV")
;N215 MSG("CAMBIO DE HERRAMIENTA ACTIVIO")
N118 MSG("AKTYWNA WYMIANA NARZEDZIA")
N119 TRANS

N120 AUSWAHL:
N121 IF $A_IN[40]==1 GOTOF ABLEGENABHOLEN
N122 IF $A_IN[34]==1 GOTOF SOLLISTGLEICH
N123 IF $A_IN[38]==1 GOTOF NURABHOLEN
N124 IF $A_IN[33]==1 GOTOF NURABLEGEN
N125 IF $A_IN[39]==1 GOTOF ENTNEHMEN   ;Fehler: WZ in Spindel
N126 GOTOB AUSWAHL


N127 NURABHOLEN:
N128 G0 G90  G153 D0 Z=Z_ACHSE_HUB S0 
N129 G153 B0 C0

N130 IF $AA_IM[Y]<(Y_ACHSE_ZANGENMASS-450) GOTOF FREI_10
N131 G153 Y=Y_ACHSE_ZANGENMASS-450
N132 STOPRE
N133 M98
N134 GOTOF FREI_20
N135 ENDIF

N136 FREI_10:
N137 G153 Y=Y_ACHSE_ZANGENMASS-450 M98
N138 STOPRE

N139 FREI_20:
N140 M86
N141 STOPRE
;N129 MSG("WERKZEUG WIRD ABGEHOLT")
;N142 MSG("PICK UP A TOOL")
;N330 MSG("OUTIL VAT ETRE PRIS")
;N330 MSG("WERKTUIG WORDT AFGEHAALD")
;N330 MSG("RECOGER HERRAMIENTA")
N330 MSG("NARZEDZIE ZOSTAJE POBRANE Z MAGAZYNKA")
N143  G153 Y=Y_ACHSE_ZANGENMASS M98
N144  WHILE $A_IN[30]==0 
N145   G4F1
N146  ENDWHILE
N147 STOPRE
N148 H85         ;Drehen auf Position neues Werkzeug
N149 STOPRE
N150 G4 F0.1

N151 LS_BELEGT3:
N152 H71          ;Abfrage Werkzeugplatz frei
N153 IF $A_IN[37]==1 GOTOF LS_FREI3
N154 GOTOB LS_BELEGT3

N155 LS_FREI3:
N156 STOPRE
N157 H72          ;Futter oeffnen
N158 STOPRE
N159 M74          ;WZ abblasen ein
N160 WZLOESEN:
N161 IF $A_IN[36]==1 GOTOF GELOEST
N162 GOTOB WZLOESEN

N163 GELOEST:
N164 G153 D0 Z=Z_ACHSE_ZANGENMASS+6
N165 M75          ;WZ abblasen aus
N166 STOPRE
N167 G153 D0 Z=Z_ACHSE_ZANGENMASS-0.1
N168 STOPRE
N169 H73          ;Werkzeug spannen
N170 STOPRE

N171 WZSPANNEN:
N172 IF $A_IN[35]==1 GOTOF GESPANNT
N173 GOTOB WZSPANNEN

N174 GESPANNT:
N175  G153 Y=Y_ACHSE_ZANGENMASS-600
N176 STOPRE
N177 M97
N178 GOTOF MOTORANLASSEN
;----------------------------------------------------------------

N179 ABLEGENABHOLEN:
N180 G0 G90 G153 D0 Z=Z_ACHSE_HUB S0 M86
N181 G153 B0 C0 
;N169 MSG("WERKZEUG WIRD ABGELEGT")
;N182 MSG("BRING BACK A TOOL")
;N610 MSG("OUTIL VAT ETRE DEPOSE")
;N610 MSG("WERKTUIG WORDT WEGGEZET")
;N610 MSG("DEPONER HERRAMIENTA")
N610 MSG("NARZEDZIE ZOSTAJE ODDANE DO MAGAZYNKA")
N183 H84              ;Drehen auf Ablegeposition
N184 STOPRE 

N185 IF $AA_IM[Y]<(Y_ACHSE_ZANGENMASS-450) GOTOF FREI_1
N186 G153 Y=Y_ACHSE_ZANGENMASS-450
N187 STOPRE
N188 M98
N189 GOTOF FREI_2
N190 ENDIF

N191 FREI_1:
N192 G153 Y=Y_ACHSE_ZANGENMASS-450 M98
N193 STOPRE

N194 FREI_2:

N195  WHILE $A_IN[30]==0 
N196   G4F1
N197  ENDWHILE
N198 STOPRE
N199 G153 Z=Z_Achse_ZANGENMASS

N200 LS_BELEGT1:
N201 H71             ;Abfrage Werkzeugplatz frei
N202 IF $A_IN[37]==1 GOTOF LS_FREI1
N203 GOTOB LS_BELEGT1

N204 LS_FREI1:
N205 STOPRE
N206 G153 Y=Y_ACHSE_ZANGENMASS
N207 H72            ;Werkzeug loesen
N208 STOPRE

N209 WZLOESEN1:
N210 IF $A_IN[36]==1 GOTOF GELOEST1
N211 GOTOB WZLOESEN1

N212 GELOEST1:
N213 G153 Z=Z_ACHSE_ZANGENMASS+2

N214 WZLOESEN11:
N215 IF $A_IN[36]==1 GOTOF GELOEST11
N216 GOTOB WZLOESEN11

N217 GELOEST11:
N218 G153 Z=Z_ACHSE_ZANGENMASS+10 
N219 M74           ;WZ abblasen ein
N220 G153 Z=Z_ACHSE_HUB
;N208 MSG("WERKZEUG WIRD ABGEHOLT")
N221 MSG("PICK UP A TOOL")
;N830 MSG("OUTIL VAT ETRE PRIS")
;N830 MSG("WERKTUIG WORDT AFGEHAALD")
;N830 MSG("BUSCAR HERRAMIENTA")
;N830 MSG ("NARZEDZIE ZOSTAJE POBRANE Z MAGAZYNKA")
N222 H85           ;Drehen auf Position neues Werkzeug
N223 STOPRE
;N850 G4 F0.1
N224 G153 D0 Z=Z_ACHSE_ZANGENMASS+6
N225 M75           ;WZ abblasen aus
N226 STOPRE
N227 G153 D0 Z=Z_ACHSE_ZANGENMASS-0.1
N228 STOPRE
N229 H73           ;Werkzeug spannen
N230 STOPRE

N231 WZSPANNEN1:
N232 IF $A_IN[35]==1 GOTOF GESPANNT1
N233 GOTOB WZSPANNEN1

N234 GESPANNT1:
N235  G153 Y=Y_ACHSE_ZANGENMASS-600
N236 STOPRE
N237 M97
N238 GOTOF MOTORANLASSEN
;----------------------------------------------------------------

N239 NURABLEGEN:
N240 G0 G90 G153 D0 Z=Z_ACHSE_HUB S0 M86
N241 G153 B0 C0
;N229 MSG("WERKZEUG WIRD ABGELEGT")
N242 MSG("BRING BACK A TOOL")
;N1010 MSG("OUTIL VAT ETRE DEPOSE")
;N1010 MSG("WERKTUIG WORDT WEGGEZET")
;N1010 MSG("NARZEDZIE ZOSTAJE ODDANE DO MAGAZYNKA")
;N1010 MSG("DEPONER HERRAMIENTA")
N243 H84        ;Drehen auf Ablegeposition
N244 STOPRE
N245 G4 F0.1

N246 LS_BELEGT2:
N247 H71        ;Abfrage Werkzeugplatz frei
N248 IF $A_IN[37]==1 GOTOF LS_FREI2
N249 GOTOB LS_BELEGT2

N250 LS_FREI2:
N251 STOPRE

N252 IF $AA_IM[Y]<(Y_ACHSE_ZANGENMASS-450) GOTOF FREI_3
N253 G153 Y=Y_ACHSE_ZANGENMASS-450
N254 STOPRE
N255 M98
N256 GOTOF FREI_4
N257 ENDIF

N258 FREI_3:
N259 G153 Y=Y_ACHSE_ZANGENMASS-450 M98
N260 STOPRE

N261 FREI_4:

N262  WHILE $A_IN[30]==0 
N263   G4F1
N264  ENDWHILE
N265 STOPRE


N266 G153  Z=Z_ACHSE_ZANGENMASS
N267  G153 Y=Y_ACHSE_ZANGENMASS
N268 STOPRE
N269 H72         ;Werkzeug loesen

N270 WZLOESEN2:
N271 IF $A_IN[36]==1 GOTOF GELOEST2
N272 GOTOB WZLOESEN2

N273 GELOEST2:
N274  G153 Z=Z_ACHSE_ZANGENMASS+2

N275 WZLOESEN12:
N276 IF $A_IN[36]==1 GOTOF GELOEST12
N277 GOTOB WZLOESEN12

N278 GELOEST12:
N279 G153 Z=Z_ACHSE_HUB
N280 H73          ;Futter schliessen
N281 STOPRE
N282  G153 Y=Y_ACHSE_ZANGEFREI-200
N283 M97
N284 GOTOF ENDE
;----------------------------------------------------------------

N285 MOTORANLASSEN:
N286 IF (DRR==0) AND (DRZ==0)
N287 GOTOF ENDE
N288 ELSE
N289    IF (DRR<>3) AND (DRR<>4)
N290     GOTOF FEHLER
N291     ELSE
N292      GOTOF OK1
N293         ENDIF
N294 ENDIF

N295 OK1:
N296 M=DRR S=DRZ
N297 DRR=0  DRZ=0
;N1360 G153 Y=Y_ACHSE_ZANGEFREI
;N1370 G4 F.1
N298 G153 Z=Z_ACHSE_HUB
N299 R959=R959+1
N300 GOTOF ENDE
;----------------------------------------------------------------

N301 SOLLISTGLEICH:
N302 IF (DRR==0) AND (DRZ==0)
N303 GOTOF ENDE_SOLLIST
N304 ELSE
N305    IF (DRR<>3) AND (DRR<>4)
N306 GOTOF FEHLER
N307    ELSE
N308       GOTOF OK2
N309    ENDIF
N310 ENDIF

N311 OK2:
N312 M=DRR S=DRZ
N313 DRR=0 DRZ=0
N314 GOTOF ENDE_SOLLIST

N315 ENDE_SOLLIST:
N316 H77            ;Unterprogramm beendet
N317 G153 G0 D0 Z=Z_ACHSE_HUB
N318 MSG("")
N319 STOPRE
N320 T=TNR
N321 M17

N322 FEHLER:
;N310 MSG("DRR<>3 oder 4, Taste RESET druecken")
N323 MSG("DRR<>3 or 4, press button RESET")
;N1600 MSG("DRR<>3 ou 4, appuyer le bouton RESET")
;N1600 MSG("DRR<>3 of 4, toets RESET drukken")
;N1600 MSG("DRR<>3 o 4, pulsar button RESET")
;N1600 MSG("DRR<>3 o 4, przycisk RESET nacisnac")
N324 G4 F2
N325 GOTOB FEHLER

N326 ENTNEHMEN:
;N314 MSG("WERKZEUG AUS SPINDEL NEHMEN - ABBRUCH")
N327 MSG("REMOVE TOOL - CANCEL")
;N1630 MSG("SORTIR OUTIL DE LA BROCHE - INTERROMPRE")
;N1630 MSG("WERKTUIG UIT SPINDEL NEMEN - ONDERBROKE")
;N1630 MSG("SACAR HERRAMIENTA DEL MOTOR DE FRESAR-INTERRUPCION")
;N1630 MSG("NARZEDZIE Z WRZECIONA WYAC - PRZERWIG")
N328 STOPRE
N329 GOTOB ENTNEHMEN

N330 ENDE:

;Bei Bedarf Schmieren:
N331 IF $A_IN[1]==0 GOTOF NSCHMIER
N332  G153 Z=Z_ACHSE_HUB
N333  G153 Y=Y_SCHMIERPOS
N334  MSG("Please wait, Lubrication active !!")
N335  G4F10
N336  STOPRE
N337  WHILE $A_IN[2]==1 
N338   G4F1
N339  ENDWHILE
N340  G153 Y=Y_ACHSE_ZANGEFREI
N341 ENDIF
N342 NSCHMIER:

N343 H77            ;Unterprogramm beendet
N344 G153 G0 D0 Z=Z_ACHSE_HUB
N345 R990=R990+1
N346 MSG("")
N347 STOPRE
N348 T=TNR
N349 M17

N350 OHNE_SIM:
N351 STOPRE
N352 T=TNR
N353 M17


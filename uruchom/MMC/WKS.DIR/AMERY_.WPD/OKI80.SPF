N5 if r2==14 gotof bulaj
N10 if r2==0 gotof liv80
N15 if r2==4 gotof liv80
N20 if r3==4 gotof oki90

;Parametry
N25 r51=290+2 ; odleglosc od krawedzi do szpr. w osi x
N30 r52=344+5; wysokosc szprosu bez luku
N35 r53=392+5 ;szerokosc wzoru
N40 r50=(r6-r53)/2; odleglosc od krawedzi do szpr. w osi y
N45 r54=-45; glebokosc robocza
N50 r55=132; odstep gornej od dolnej
N55 r57=r52+r55
N60 r58=r57+r56
N65 r59=r51-48
N70 r61=133; odstep miedzy wzorkami
N75 r60=(r6-r61-(2*r50))/2; szerokosc jednego pola
N80 r61=133; odstep miedzy wzorkami

;Program
N85 g53 g40 g0 g90 d0 z340

;Narzedzie
N90 wechsel(1,3,180)

;Pozycja start wlaczona korekcja zjazd nad materjal
N95 g0 g41 d1 x=r51 y=r50 z50
N100 m21
N105 g1 x=ic(100) z=r54 f6000
N110 x=r51+r52
N115 y=r50+r53
N120 x=r51
N125 g3 y=r50 cr=295
N130 g1 x=ic(100)
N135 x=ic(100) z20

;narozniki
;N120 g0 g40 x=r51+r52-10+2 y=r50+10-2
;N125 g1 z=r54 f4000
;N130 g0 z20
;N135 g0 y=r50+r53-10+2
;N140 g1 z=r54 f4000
;N145 g0 z50
N140 koniec:
;zakonczenie
N145 g53 g0 g40 d0 z340
N150 m17

N155 liv80:
N160 oki80L
N165 m17

N170 oki90:   ; windsor

;Parametry
N175 r51=290+2+10 ; odleglosc od krawedzi do szpr. w osi x
N180 r52=340; wysokosc szprosu bez luku
N185 r53=494 ;szerokosc wzoru
N190 r50=(r6-r53)/2; odleglosc od krawedzi do szpr. w osi y
N195 r54=-45; glebokosc robocza
N200 r55=132; odstep gornej od dolnej
N205 r57=r52+r55
N210 r58=r57+r56
N215 r59=r51-48
N220 r61=133; odstep miedzy wzorkami
N225 r60=(r6-r61-(2*r50))/2; szerokosc jednego pola
N230 r61=133; odstep miedzy wzorkami

;Program
N235 g53 g40 g0 g90 d0 z340

;Narzedzie
N240 wechsel(1,3,180)

;Pozycja start wlaczona korekcja zjazd nad materjal
N245 g0 g41 d1 x=r51 y=r50 z50
N250 m21
N255 g1 x=ic(100) z=r54 f6000
N260 x=r51+r52
N265 y=r50+r53
N270 x=r51
N275 g3 y=r50 cr=405
N280 g1 x=ic(100)
N285 x=ic(100) z20

;zakonczenie
N290 g53 g0 g40 d0 z340
N295 m17

N300 bulaj:

IF R4==1 GOTOF BULAJ_MDF
IF R4==4 GOTOF BULAJ_METALOWY
MSG("BRAK OPCJI DLA PARAMETRU R4")
M0
M30


BULAJ_MDF:

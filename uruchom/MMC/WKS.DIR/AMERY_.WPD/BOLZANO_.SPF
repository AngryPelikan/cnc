N5 BOLZANO:
;-----------

N10 R55=1 ; FREZOWANIE 1-ZGRUBNE  2-DOKLADNE
N15 R56=1 ; LICZNIK OKIENEK

; UWAGA! SPRAWDZ PARAMETR OD GRUBOSCI SKRZYDLA W PN

N20 CURYK:
;---------

N25 IF R3==1 GOTOF B_OVAL_60
N30 IF R3==2 GOTOF B_OVAL_70
N35 IF R3==3 GOTOF B_OVAL_80
N40 IF R3==4 GOTOF B_OVAL_90
N45 MSG("BRAK OPCJI DLA PARAMETRU R3")
N50 M0
N55 M30


N60 B_OVAL_80:
;--------------
N65 IF R55==1 GOTOF B_OVAL_80_ZGR
N70 IF R55==2 GOTOF B_OVAL_80_DOK
N75 M30

N80 B_OVAL_80_DOK:
;-----------------
N85 R50=450 ; SZEROKOSC PROSTOKATU
N90 R51=135 ; WYSOKOSC PROSTOKATU
N95 R52=468.8 ; PROMIEN DUZEGO LUKU
N100 R53=76.9  ; PROMIEN MALEGO LUKU
N105 GOTOF UKLAD_OTWOROW

N110 B_OVAL_80_ZGR:
;------------------
N115 R50=449 ; SZEROKOSC PROSTOKATU
N120 R51=133.2 ; WYSOKOSC PROSTOKATU
N125 R52=467.8 ; PROMIEN DUZEGO LUKU
N130 R53=75.9  ; PROMIEN MALEGO LUKU
N135 GOTOF UKLAD_OTWOROW







N140 UKLAD_OTWOROW:
;-----------------

N145 R71=335+7.5        ; WYS PIERWSZEGO OKIENKA
N150 R72=1007.5+7.5     ; WYS DRUGIEGO OKIENKA
N155 R73=1680+7.5       ; WYS TRZECIEGO OKIENKA

;---------
N160 IF R4==2 GOTOF BOLZANO_2
N165 IF R4==3 GOTOF BOLZANO_3
N170 MSG("ZLE USTAWIONY PARAMETR R4")
N175 M0
N180 M17

N185 BOLZANO_2:
;---------
N190 R81=R71
N195 R82=R73
N200 GOTOF WYB_OKIENKA

N205 BOLZANO_3:
;---------
N210 R81=R71
N215 R82=R72
N220 R83=R73
N225 GOTOF WYB_OKIENKA

;------------------------
N230 WYB_OKIENKA:
;-------------
N235 IF R56>R4 GOTOF END_BOLZANO

N240 IF R56==1
N245 	R70=R81
N250 ENDIF

N255 IF R56==2
N260 	R70=R82
N265 ENDIF

N270 IF R56==3
N275 	R70=R83
N280 ENDIF


N285 BOLZANO_PROG:
;--------------

N290 IF R55==1 ; FREZOWANIE ZGRUBNE
N295 WECHSEL(1,3,180)
N300 D1
N305 CPRECON
N310 ENDIF

N315 IF R55==2 ; FREZOWANIE DOKLADNE
N320 WECHSEL(10,3,180)
N325 D1
N330 CPRECON
N335 ENDIF

N340 ATRANS X=R70  Y=R6/2

N345 G0 X=-(R51/2)+50 Y=(R50/2)-50 G42
N350 G0 Z=-37+R15+5 ;M21
N355 G1 Z=-37-3 F1000
N360 G2 X=-(R51/2) Y=R50/2 CR=50 F4000
N365 G2 X=IC(R51) CR=R53
N370 G2 Y=IC(-R50) CR=R52
N375 G2 X=IC(-R51) CR=R53
N380 G2 Y=IC(R50) CR=R52
N385 G2 X=IC(R51) CR=R53
N390 G2 X=IC(-50) Y=IC(-50) CR=50
N395 G0 Z=-37+R15+50 G40

N400 ATRANS X=-R70  Y=-(R6/2)

N405 R56=R56+1

N410 IF R56>R4
N415 R56=1
N420 R55=R55+1
N425 ENDIF

N430 IF R55==3 GOTOF END_BOLZANO

N435 GOTOB CURYK



N440 END_BOLZANO:
;----------------
N445 G0 G90 G53 G40 D0 Z340
N450 ROT
N455 M17

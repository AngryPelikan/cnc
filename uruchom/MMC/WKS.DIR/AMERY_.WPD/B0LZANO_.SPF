N10 BOLZANO:
;-----------

; UWAGA! SPRAWDZ PARAMETR OD GRUBOSCI SKRZYDLA W PN

N20 R50=(R3*100)+230 ; SZEROKOSC OKIENKA
N30 R51=100  ; WYSOKOSC OKIENKA
N40 R52=98   ; ODLEGLOSC MIEDZY OKIENKAMI
N50 R53=1    ; LICZNIK OKIENEK
N60 R54=130  ; ODLEGLOSC DO PIERWSZEGO OKIENKA W X
N70 R55=1    ; LICZNIK OPERACJI 1-FREZ ZGRUBNY 2-DOKLADN 3-FAZKA
N80 R56=25   ; PROMIEN OKIENKA
N90 R57=50   ; PROMIEN WEJSCIA FREZU FAZKA
N100 R71=R54                 ; WYS PIERWSZEGO OKIENKA
N110 R72=R54+(R51*1)+(R52*1) ; WYS DRUGIEGO OKIENKA
N120 R73=R54+(R51*2)+(R52*2) ; WYS TRZECIEGO OKIENKA
N130 R74=R54+(R51*3)+(R52*3) ; WYS CZWARTEGO OKIENKA
N140 R75=R54+(R51*4)+(R52*4) ; WYS PIATEGO OKIENKA
N150 R76=R54+(R51*5)+(R52*5) ; WYS SZUSTEGO OKIENKA
N160 R77=R54+(R51*6)+(R52*6) ; WYS SIUDMEGO OKIENKA
N170 R78=R54+(R51*7)+(R52*7) ; WYS OSMEGO OKIENKA
N180 R79=R54+(R51*8)+(R52*8) ; WYS DZIEWIATEGO OKIENKA

;---------
N190 IF R4==1 GOTOF BOLZANO_1
N200 IF R4==2 GOTOF BOLZANO_2
N210 IF R4==3 GOTOF BOLZANO_3
N220 IF R4==4 GOTOF BOLZANO_4
N230 IF R4==5 GOTOF BOLZANO_5
N240 IF R4==9 GOTOF BOLZANO_9
N250 MSG("ZLE USTAWIONY PARAMETR R4")
N260 M0
N270 M17

N280 BOLZANO_1:
;---------
N290 R81=300
N300 GOTOF WYB_OKIENKA

N310 BOLZANO_2:
;---------
N320 R81=R72
N330 R82=R78
N340 GOTOF WYB_OKIENKA

N350 BOLZANO_3:
;---------
N360 R81=R72
N370 R82=R75
N380 R83=R78
N390 GOTOF WYB_OKIENKA

N400 BOLZANO_4:
;--------------
N410 R81=R72
N420 R82=R74
N430 R83=R76
N440 R84=R78
N450 GOTOF WYB_OKIENKA

N460 BOLZANO_5:
;---------

N470 R81=R71
N480 R82=R73
N490 R83=R75
N500 R84=R77
N510 R85=R79
N520 GOTOF WYB_OKIENKA

N530 BOLZANO_9:
;---------
N540 R81=R71
N550 R82=R72
N560 R83=R73
N570 R84=R74
N580 R85=R75
N590 R86=R76
N600 R87=R77
N610 R88=R78
N620 R89=R79
N630 GOTOF WYB_OKIENKA

N640 WYB_OKIENKA:
;-------------

N650 IF R53>R4 GOTOF END_BOLZANO

N660 IF R53==1
N670 	R70=R81
N680 ENDIF

N690 IF R53==2
N700 	R70=R82
N710 ENDIF

N720 IF R53==3
N730 	R70=R83
N740 ENDIF

N750 IF R53==4
N760 	R70=R84
N770 ENDIF

N780 IF R53==5
N790 	R70=R85
N800 ENDIF

N810 IF R53==6
N820 	R70=R86
N830 ENDIF

N840 IF R53==7
N850 	R70=R87
N860 ENDIF

N870 IF R53==8
N880 	R70=R88
N890 ENDIF

N900 IF R53==9
N910 	R70=R89
N920 ENDIF



N930 BOLZANO_PROG:
;--------------

N940 IF R55==1 GOTOF FREZOWANIE_ZGRUBNE
N950 IF R55==2 GOTOF FREZOWANIE_DOKLADNE
N960 IF R55==3 GOTOF FAZKA
N970 M30

N980 FREZOWANIE_ZGRUBNE:
;------------------
N990 WECHSEL(1,3,180) ; FREZOWANIE ZGRUBNE
N1000 CPRECON

N1010 G0 X=R70+R51-16 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N1020 G0 Z=-37+R15+50 M21
N1030 G0 Z=-37+R15+10
N1040 G1 Z=-37-10 F1000 
N1050 G3 X=IC(15) Y=IC(15) CR=15 F4000
N1060 G1 Y=((R6-R50)/2)+R50-1 RND=R56-1
N1070 G1 X=R70+1 RND=R56-1
N1080 G1 Y=((R6-R50)/2)+1 RND=R56-1
N1090 G1 X=R70+R51-1 RND=R56-1
N1100 G1 Y=((R6-R50)/2)+(R50/2)+15
N1110 G3 X=IC(-15) Y=IC(15) CR=15
N1120 G0 Z=-37+R15+50 G40

N1130 R53=R53+1

N1140 IF R53>R4
N1150 R53=1
N1160 R55=R55+1
N1170 ENDIF

N1180 GOTOB WYB_OKIENKA

; - - - - - - - - - - - - - - - - - - 

N1190 FREZOWANIE_DOKLADNE:
;-------------------

N1200 WECHSEL(10,3,180) ; FREZOWANIE DOKLADNE
N1210 CPRECON

N1220 G0 X=R70+R51-15 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N1230 G0 Z=-37+R15+50 M21
N1240 G0 Z=-37+R15+10
N1250 G1 Z=-37-10 F1000 
N1260 G3 X=IC(15) Y=IC(15) CR=15 F4000
N1270 G1 Y=((R6-R50)/2)+R50 RND=R56
N1280 G1 X=R70 RND=R56
N1290 G1 Y=((R6-R50)/2) RND=R56
N1300 G1 X=R70+R51 RND=R56
N1310 G1 Y=((R6-R50)/2)+(R50/2)+15
N1320 G3 X=IC(-15) Y=IC(15) CR=15
N1330 G0 Z=-37+R15+50 G40

N1340 R53=R53+1

N1350 IF R53>R4
N1360 R53=1
N1370 R55=R55+1
N1380 ENDIF

N1390 GOTOB WYB_OKIENKA

;--------------------------------

N1400 FAZKA:
;--------
N1410 WECHSEL(5,3,180) ; FREZOWANIE DOKLADNE
N1420 CPRECON

N1430 G0 X=R70+R51-R57 Y=((R6-R50)/2)+(R50/2)-R57 G41 D2
N1440 G0 Z=-37+R15+50 M21
N1450 G1 Z=-37+(R15/2) F1000
N1460 G3 X=IC(R57) Y=IC(R57) CR=R57 F4000
N1470 G1 Y=((R6-R50)/2)+R50 RND=R56
N1480 G1 X=R70 RND=R56
N1490 G1 Y=((R6-R50)/2) RND=R56
N1500 G1 X=R70+R51 RND=R56
N1510 G1 Y=((R6-R50)/2)+(R50/2)+15
N1520 G3 X=IC(-R57) Y=IC(R57) CR=R57
N1530 G0 Z=-37+R15+80 G40

N1540 R53=R53+1
N1550 GOTOB WYB_OKIENKA

;--------------------------------

N1560 END_BOLZANO:
;----------------
N1570 G0 G90 G53 G40 D0 Z340
N1580 ROT
N1590 M17

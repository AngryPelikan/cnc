WZOR_FRESA:
;-----------



;~~~~~~~~~~~~
N255 WZOR_CLASSIC_6:
;~~~~~~~~~~~~

;Parametry
N260 r51=125+2 ; odleglosc od krawedzi do szpr. w osi x
N265 r52=1089; wysokosc szprosu bez luku
N270 r53=266+(R3*100) ;szerokosc wzoru
N275 r50=(r6-r53)/2; odleglosc od krawedzi do szpr. w osi y
N280 r54=-3; glebokosc robocza
N285 r55=132; odstep gornej od dolnej
N290 r56=470; wysokosc dolnego wzoru
N295 r57=r52+r55
N300 r58=r57+r56
N305 r59=r51-48
N310 r61=133; odstep miedzy wzorkami
N315 r60=(r6-r61-(2*r50))/2; szerokosc jednego pola
N320 r61=133; odstep miedzy wzorkami

;Program
N325 g53 g40 g0 g90 d0 z340

;Narzedzie
N330 wechsel(5,3,180)

;Pozycja start wlaczona korekcja zjazd nad materjal
N335 g0 g41 d1 x=r51 y=r50 z50 m21
N340 z2

;pierwsze pole
N345 g1 x=r51+200 z=r54 f15000
N350 x=r51+r52 
N355 y=r50+r60
N360 x=r51 
N365 y=r50
N370 x=r51+250
N375 x=r51+400 z2
N380 z10

;drugie pole
N385 g0 x=r51 y=r50+r53-r60 G41
N390 z2
N395 g1 x=r51+200 z=r54 f15000
N400 x=r51+r52
N405 y=r50+r53
N410 x=r51
N415 y=r50+r53-r60
N420 x=r51+250
N425 x=r51+400 z2
N430 z10

;trzecie pole
N435 g0 x=r51+r57 y=r50 G41
N440 z2
N445 g1 x=r51+r57+200 z=r54 f15000
N450 x=r51+r58
N455 y=r50+r53
N460 x=r51+r57
N465 y=r50
N470 x=r51+r57+250
N475 x=r51+r57+400 z2
N480 z10

;zakonczenie
N485 g53 g0 g40 d0 z340 S0
N490 m17


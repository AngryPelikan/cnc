N495 WZOR_CLASSIC_7:
;--------------

;Parametry
N500 r51=125+2 ; odleglosc od krawedzi do szpr. w osi x
N505 r53=266+(R3*100) ;szerokosc wzoru
N510 r50=(r6-r53)/2; odleglosc od krawedzi do szpr. w osi y

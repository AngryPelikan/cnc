N520 r55=80 ; odstep gornej od dolnej
N525 r56=200; wysokosc srodkowego pola
N530 r61=80 ; odstep miedzy wzorkami
N535 r60=(r6-r61-(2*r50))/2; szerokosc jednego pola
N540 r52=(r7-r51-(r55*2)-r56-218)/2 ;665.5; wysokosc gornego i dolnego pola


;Program
N545 g53 g40 g0 g90 d0 z340

;Narzedzie
N550 wechsel(5,3,180)


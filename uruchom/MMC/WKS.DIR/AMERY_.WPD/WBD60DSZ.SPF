N5 if r11==1 gotof nowy
;Parametry
N10 r51=125+2 ; odleglosc od krawedzi do szpr. w osi x
N15 r52=1720+5; wysokosc szprosu bez luku
N20 r53=361+5 ;szerokosc wzoru
N25 r50=(r6-r53)/2; odleglosc od krawedzi do szpr. w osi y
N30 r54=-53; glebokosc robocza
N35 r55=132; odstep gornej od dolnej
N40 r56=470; wysokosc dolnego wzoru
N45 r57=r52+r55
N50 r58=r57+r56
N55 r59=r51-48
N60 r61=133; odstep miedzy wzorkami
N65 r60=(r6-r61-(2*r50))/2; szerokosc jednego pola
N70 r61=133; odstep miedzy wzorkami
N75 r65=736+4
N80 r66=380-8
;Program
N85 g53 g40 g0 g90 d0 z340

;Narzedzie
N90 wechsel(1,3,180)

;Pozycja start wlaczona korekcja zjazd nad materjal
N95 g0 g41 d1 x=r51 y=r50 z50
N100 z20 m21

;pierwsze pole

N105 g1 x=r51+100 z=r54 f6000
N110 x=r51+r52 
N115 y=r50+r53
N120 x=r51+r65+r66
N125 x=r51+r65+(r66/2) y=r50+r53-108
N130 x=r51+r65 y=r50+r53
N135 g1 x=r51
N140 y=r50
N145 x=r51+100
N150 x=r51+200 z20

;zakonczenie
N155 g53 g0 g40 d0 z340
N160 m17

N165 nowy: ;*********************

N170 r51=125+2 ; odleglosc od krawedzi do szpr. w osi x
N175 r52=1720+5; wysokosc szprosu bez luku
N180 r53=361+5 ;szerokosc wzoru
N185 r50=(r6-r53)/2; odleglosc od krawedzi do szpr. w osi y
N190 r54=-53; glebokosc robocza
N195 r55=132; odstep gornej od dolnej
N200 r56=470; wysokosc dolnego wzoru
N205 r57=r52+r55
N210 r58=r57+r56
N215 r59=r51-48
N220 r61=133; odstep miedzy wzorkami
N225 r60=(r6-r61-(2*r50))/2; szerokosc jednego pola
N230 r61=133; odstep miedzy wzorkami
N235 r65=736+4-120
N240 r66=380-8
;Program
N245 g53 g40 g0 g90 d0 z340

N255 IF R4==1 GOTOF WIM_FREZ ; WIMBLEDON FREZOWANY
N260 if r4==3 gotof szpros
N265 m17

N270 szpros:

IF R0==2 GOTOF END

;Narzedzie
N250 wechsel(1,3,180)

;Pozycja start wlaczona korekcja zjazd nad materjal
N255 g0 g41 d1 x=r51 y=r50 z50
N260 z20 m21

;pierwsze pole

N265 g1 x=r51+100 z=r54 f6000
N270 x=r51+r52 
N275 y=r50+r53
N280 x=r51+r65+r66
N285 x=r51+r65+(r66/2) y=r50+r53-108
N290 x=r51+r65 y=r50+r53
N295 g1 x=r51
N300 y=r50
N305 x=r51+100
N310 x=r51+200 z20

;zakonczenie
N315 g53 g0 g40 d0 z340
N320 m17

; wimbledon frezowany

N355 wim_frez:

N360 wechsel(5,3,180)

N365 IF R0==1 GOTOF STR1
N370 IF R0==2 GOTOF STR2
N375 M17

N380 STR2:

N385 ATRANS Y=R6
N390 AMIRROR Y=0

N395 STR1:

N400 CPRECON

N405 G0 X=R51+R52-150 Y=R50+R53 G41 D1
N410 Z=2 m21
N415 G1 Z=-3 F1000
N420 G1 x=r51+r65+r66 f15000
N425 x=r51+r65+(r66/2) y=r50+r53-108
N430 x=r51+r65 y=r50+r53
N435 x=r51+15
N440 G0 Z=20

N445 CPRECOF

N450 ROT

END:

;zakonczenie
N455 g53 g0 g40 d0 z340
N460 m17


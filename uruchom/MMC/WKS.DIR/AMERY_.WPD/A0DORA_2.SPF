N5 ANDORA:
;----------

N10 R55=1 ; FREZOWANIE 1-ZGRUBNE  2-DOKLADNE
N15 R56=3 ; LICZNIK OKIENEK

; UWAGA! SPRAWDZ PARAMETR OD GRUBOSCI SKRZYDLA W PN

N20 CURYK:
;---------

N25 IF R55==1 GOTOF B_OVAL_80_ZGR
N30 IF R55==2 GOTOF B_OVAL_80_DOK
N35 M30

N40 B_OVAL_80_DOK:
;-----------------
N45 R50=(R3*100)+230 ; SZEROKOSC ELIPSY
N50 R51=250 ; WYSOKOSC ELIPSY
N55 GOTOF UKLAD_OTWOROW

N60 B_OVAL_80_ZGR:
;------------------
N65 R50=(R3*100)+230-5 ; SZEROKOSC ELIPSY
N70 R51=250-5 ; WYSOKOSC ELIPSY
N75 GOTOF UKLAD_OTWOROW

N80 UKLAD_OTWOROW:
;-----------------
N85 R71=335+7.5        ; WYS PIERWSZEGO OKIENKA
N90 R72=1007.5+7.5     ; WYS DRUGIEGO OKIENKA
N95 R73=530        ; WYS TRZECIEGO OKIENKA

;---------
N100 IF R4==2 GOTOF ANDORA_2
N105 IF R4==3 GOTOF ANDORA_3
N110 MSG("ZLE USTAWIONY PARAMETR R4")
N115 M0
N120 M17

N125 ANDORA_2:
;---------
N130 R81=R71
N135 R82=R73
N140 GOTOF WYB_OKIENKA

N145 ANDORA_3:
;---------
N150 R81=R71
N155 R82=R72
N160 R83=R73
N165 GOTOF WYB_OKIENKA

;------------------------
N170 WYB_OKIENKA:
;-------------
N175 IF R56>R4 GOTOF END_ANDORA

N180 IF R56==1
N185 	R70=R81
N190 ENDIF

N195 IF R56==2
N200 	R70=R82
N205 ENDIF

N210 IF R56==3
N215 	R70=R83
N220 ENDIF


N225 ANDORA_PROG:
;--------------

N230 IF R55==1 ; FREZOWANIE ZGRUBNE
N235 WECHSEL(1,3,180)
N240 D1
N245 CPRECON
N250 ENDIF

N255 IF R55==2 ; FREZOWANIE DOKLADNE
N260 WECHSEL(10,3,180)
N265 D1
N270 CPRECON
N275 ENDIF

N280 ATRANS X=R70  Y=R6/2

N285 ASCALE X=R51/R50

N290 G0 X=-R50/2+60 Y=0+60 G41
N295 G0 Z=-37+R15+10
N300 G1 Z=-37-3 F2000
N305 G3 X=-R50/2 Y=0 CR=60
N310 G3 X=0 Y=-R50/2 CR=R50/2 F4000
N315 G3 X=0 Y=R50/2 CR=R50/2
N320 G3 X=0 Y=-R50/2 CR=R50/2
N325 G3 X=IC(60) Y=IC(60) CR=60
N330 G0 Z=-37+R15+50
N335 G0 X=IC(1) G40

N340 ASCALE X=R50/R51

N345 ATRANS X=-R70  Y=-(R6/2)

N350 R56=R56+1

N355 IF R56>R4
N360 R56=3
N365 R55=R55+1
N370 ENDIF

N375 IF R55==3 GOTOF END_ANDORA

N380 GOTOB CURYK

N385 END_ANDORA:
;----------------
N390 G0 G90 G53 G40 D0 Z340
N395 ROT
N400 M17

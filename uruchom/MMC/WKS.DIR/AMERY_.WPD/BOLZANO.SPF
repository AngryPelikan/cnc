N5 BOLZANO:
;-----------

; UWAGA! SPRAWDZ PARAMETR OD GRUBOSCI SKRZYDLA W PN

N10 R50=(R3*100)+230 ; SZEROKOSC OKIENKA
N15 R51=100          ; WYSOKOSC OKIENKA
N20 R52=98           ; ODLEGLOSC MIEDZY OKIENKAMI
N25 R53=1            ; LICZNIK OKIENEK
N30 R54=130          ; ODLEGLOSC DO PIERWSZEGO OKIENKA W X 130sT
N35 R55=1            ; LICZNIK OPERACJI 1-FREZ ZGRUBNY 2-DOKLADNY                                                                
N40 R71=R54                 ; WYS PIERWSZEGO OKIENKA
N45 R72=R54+(R51*1)+(R52*1) ; WYS DRUGIEGO OKIENKA
N50 R73=R54+(R51*2)+(R52*2) ; WYS TRZECIEGO OKIENKA
N55 R74=R54+(R51*3)+(R52*3) ; WYS CZWARTEGO OKIENKA
N60 R75=R54+(R51*4)+(R52*4) ; WYS PIATEGO OKIENKA
N65 R76=R54+(R51*5)+(R52*5) ; WYS SZUSTEGO OKIENKA
N70 R77=R54+(R51*6)+(R52*6) ; WYS SIUDMEGO OKIENKA
N75 R78=R54+(R51*7)+(R52*7) ; WYS OSMEGO OKIENKA
N80 R79=R54+(R51*8)+(R52*8) ; WYS DZIEWIATEGO OKIENKA

;---------
N85 IF R4==2 GOTOF BOLZANO_2
N90 IF R4==3 GOTOF BOLZANO_3
N95 IF R4==4 GOTOF BOLZANO_4
N100 IF R4==5 GOTOF BOLZANO_5
N105 IF R4==9 GOTOF BOLZANO_9
N115 MSG("ZLE USTAWIONY PARAMETR R4")
N120 M0
N125 M17

N160 BOLZANO_2:
;---------
N165 R81=R72
N170 R82=R78
N175 GOTOF WYB_OKIENKA

N180 BOLZANO_3:
;---------
N185 R81=R72
N190 R82=R75
N195 R83=R78
N200 GOTOF WYB_OKIENKA

N205 BOLZANO_4:
;--------------
N210 R81=R72
N215 R82=R74
N220 R83=R76
N225 R84=R78
N230 GOTOF WYB_OKIENKA

N235 BOLZANO_5:
;---------

N240 R81=R71
N245 R82=R73
N250 R83=R75
N255 R84=R77
N260 R85=R79
N265 GOTOF WYB_OKIENKA

N270 BOLZANO_9:
;---------
N275 R81=R71
N280 R82=R72
N285 R83=R73
N290 R84=R74
N295 R85=R75
N300 R86=R76
N305 R87=R77
N310 R88=R78
N315 R89=R79
N320 GOTOF WYB_OKIENKA

N325 WYB_OKIENKA:
;-------------

N330 IF R53>R4 GOTOF END_BOLZANO

N335 IF R53==1
N340 	R70=R81
N345 ENDIF

N350 IF R53==2
N355 	R70=R82
N360 ENDIF

N365 IF R53==3
N370 	R70=R83
N375 ENDIF

N380 IF R53==4
N385 	R70=R84
N390 ENDIF

N395 IF R53==5
N400 	R70=R85
N405 ENDIF

N410 IF R53==6
N415 	R70=R86
N420 ENDIF

N425 IF R53==7
N430 	R70=R87
N435 ENDIF

N440 IF R53==8
N445 	R70=R88
N450 ENDIF

N455 IF R53==9
N460 	R70=R89
N465 ENDIF



N470 BOLZANO_PROG:
;--------------

N475 IF R55==1 GOTOF FREZOWANIE_ZGRUBNE
N480 IF R55==2 GOTOF FREZOWANIE_DOKLADNE
N485 M30

N490 FREZOWANIE_ZGRUBNE:
;------------------
N495 WECHSEL(1,3,180) ; FREZOWANIE ZGRUBNE
N500 CPRECON

N505 G0 X=R70+R51-16 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N510 G0 Z=-37+R15+50 M21
N515 G0 Z=-37+R15+10
N520 G1 Z=-37-5 F1000 
N525 G3 X=IC(15) Y=IC(15) CR=15 F4000
N530 G1 Y=((R6-R50)/2)+R50-1 RND=15
N535 G1 X=R70+1 RND=15
N540 G1 Y=((R6-R50)/2)+1 RND=15
N545 G1 X=R70+R51-1 RND=15
N550 G1 Y=((R6-R50)/2)+(R50/2)+15
N555 G3 X=IC(-15) Y=IC(15) CR=15
N560 G0 Z=-37+R15+50 G40

N565 R53=R53+1

N570 IF R53>R4
N575 R53=1
N580 R55=2
N585 ENDIF

N590 GOTOB WYB_OKIENKA

; - - - - - - - - - - - - - - - - - - 

N595 FREZOWANIE_DOKLADNE:
;-------------------

N600 WECHSEL(10,3,180) ; FREZOWANIE DOKLADNE
N605 CPRECON

N610 G0 X=R70+R51-15 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N615 G0 Z=-37+R15+50 M21
N620 G0 Z=-37+R15+10
N625 G1 Z=-37-5 F1000 
N630 G3 X=IC(15) Y=IC(15) CR=15 F4000
N635 G1 Y=((R6-R50)/2)+R50 RND=15
N640 G1 X=R70 RND=15
N645 G1 Y=((R6-R50)/2) RND=15
N650 G1 X=R70+R51 RND=15
N655 G1 Y=((R6-R50)/2)+(R50/2)+15
N660 G3 X=IC(-15) Y=IC(15) CR=15
N665 G0 Z=-37+R15+50 G40

N670 R53=R53+1
N675 GOTOB WYB_OKIENKA

N680 END_BOLZANO:
;----------------
N685 G0 G90 G53 G40 D0 Z340
N690 ROT
N695 M17

N153     ATRANS X=R7-R70
N154   ENDIF

N155   IF R0==2
N156     ATRANS Y=R75
N157     ATRANS X=R7-R70
N158   ENDIF

N159   OTWOR
N160   ROT
N161 ENDIF

N162 IF R9==2
N163   IF R0==1
N164     ATRANS Y=R6-R75
N165     ATRANS X=R7-R70
N166   ENDIF

N167   IF R0==2

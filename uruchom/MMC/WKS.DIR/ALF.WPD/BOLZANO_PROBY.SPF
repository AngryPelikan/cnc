N5 BOLZANO:
;-----------

R4=4
R6=812 ; SZEROKOSC SKRZYDLA
R15=42 ; GRUBOSC MATERIALU

N575 m70 h11 g54 m51 g64
N580 g53 g40 g0 g90 d0 z340

; UWAGA! SPRAWDZ PARAMETR OD GRUBOSCI SKRZYDLA W PN

N10 R50=530 ; SZEROKOSC OKIENKA
N15 R51=100          ; WYSOKOSC OKIENKA
N20 R52=100     ; ODLEGLOSC MIEDZY OKIENKAMI
N25 R53=1            ; LICZNIK OKIENEK
N30 R54=100     ; ODLEGLOSC DO PIERWSZEGO OKIENKA W X
N35 R55=1            ; LICZNIK OPERACJI 1-FREZ ZGRUBNY 2-DOKLADNY

N40 R71=R54                 ; WYS PIERWSZEGO OKIENKA
N45 R72=300                 ; WYS DRUGIEGO OKIENKA
N50 R73=500                 ; WYS TRZECIEGO OKIENKA
N55 R74=700                 ; WYS CZWARTEGO OKIENKA
N60 R75=R54+(R51*4)+(R52*4) ; WYS PIATEGO OKIENKA
N65 R76=R54+(R51*5)+(R52*5) ; WYS SZUSTEGO OKIENKA
N70 R77=R54+(R51*6)+(R52*6) ; WYS SIUDMEGO OKIENKA
N75 R78=R54+(R51*7)+(R52*7) ; WYS OSMEGO OKIENKA
N80 R79=R54+(R51*8)+(R52*8) ; WYS DZIEWIATEGO OKIENKA

;---------
N85 GOTOF BOLZANO_2

N90 IF R4==3 GOTOF BOLZANO_3
N95 IF R4==4 GOTOF BOLZANO_4
N100 IF R4==5 GOTOF BOLZANO_5
N105 IF R4==9 GOTOF BOLZANO_9
N110 MSG("ZLE USTAWIONY PARAMETR R4")
N115 M0
N120 M17

N125 BOLZANO_2:
;---------
N130 R81=R71
N135 R82=R72
N140 R83=R73
N145 R84=R74

N150 GOTOF WYB_OKIENKA

N155 BOLZANO_3:
;---------
N160 R81=R72
N165 R82=R75
N170 R83=R78
N175 GOTOF WYB_OKIENKA

N180 BOLZANO_4:
;--------------
N185 R81=R72
N190 R82=R74
N195 R83=R76
N200 R84=R78
N205 GOTOF WYB_OKIENKA

N210 BOLZANO_5:
;---------

N215 R81=R71
N220 R82=R73
N225 R83=R75
N230 R84=R77
N235 R85=R79
N240 GOTOF WYB_OKIENKA

N245 BOLZANO_9:
;---------
N250 R81=R71
N255 R82=R72
N260 R83=R73
N265 R84=R74
N270 R85=R75
N275 R86=R76
N280 R87=R77
N285 R88=R78
N290 R89=R79
N295 GOTOF WYB_OKIENKA

N300 WYB_OKIENKA:
;-------------

N305 IF R53>R4 GOTOF END_BOLZANO

N310 IF R53==1
N315 	R70=R81
N320 ENDIF

N325 IF R53==2
N330 	R70=R82
N335 ENDIF

N340 IF R53==3
N345 	R70=R83
N350 ENDIF

N355 IF R53==4
N360 	R70=R84
N365 ENDIF

N370 IF R53==5
N375 	R70=R85
N380 ENDIF

N385 IF R53==6
N390 	R70=R86
N395 ENDIF

N400 IF R53==7
N405 	R70=R87
N410 ENDIF

N415 IF R53==8
N420 	R70=R88
N425 ENDIF

N430 IF R53==9
N435 	R70=R89
N440 ENDIF



N445 BOLZANO_PROG:
;--------------

N450 IF R55==1 GOTOF FREZOWANIE_ZGRUBNE
N455 IF R55==2 GOTOF FREZOWANIE_DOKLADNE
N460 M30

N465 FREZOWANIE_ZGRUBNE:
;------------------
N470 WECHSEL(1,3,180) ; FREZOWANIE ZGRUBNE
N475 CPRECON

N480 G0 X=R70+R51-16 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N485 G0 Z=-37+R15+50 M21
N490 G0 Z=-37+R15+10
N495 G1 Z=-37-5 F1000 
N500 G3 X=IC(15) Y=IC(15) CR=15 F4000
N505 G1 Y=((R6-R50)/2)+R50-1 RND=15
N510 G1 X=R70+1 RND=15
N515 G1 Y=((R6-R50)/2)+1 RND=15
N520 G1 X=R70+R51-1 RND=15
N525 G1 Y=((R6-R50)/2)+(R50/2)+15
N530 G3 X=IC(-15) Y=IC(15) CR=15
N535 G0 Z=-37+R15+50 G40

N540 R53=R53+1

N545 IF R53>R4
N550 R53=1
N555 R55=2
N560 ENDIF

N565 GOTOB WYB_OKIENKA

; - - - - - - - - - - - - - - - - - - 

N570 FREZOWANIE_DOKLADNE:
;-------------------

N575 WECHSEL(10,3,180) ; FREZOWANIE DOKLADNE
N580 CPRECON

N585 G0 X=R70+R51-15 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N590 G0 Z=-37+R15+50 M21
N595 G0 Z=-37+R15+10
N600 G1 Z=-37-5 F1000 
N605 G3 X=IC(15) Y=IC(15) CR=15 F4000
N610 G1 Y=((R6-R50)/2)+R50 RND=15
N615 G1 X=R70 RND=15
N620 G1 Y=((R6-R50)/2) RND=15
N625 G1 X=R70+R51 RND=15
N630 G1 Y=((R6-R50)/2)+(R50/2)+15
N635 G3 X=IC(-15) Y=IC(15) CR=15
N640 G0 Z=-37+R15+50 G40

N645 R53=R53+1
N650 GOTOB WYB_OKIENKA

N655 END_BOLZANO:
;----------------
N660 G0 G90 G53 G40 D0 Z340
N665 ROT
N670 M17

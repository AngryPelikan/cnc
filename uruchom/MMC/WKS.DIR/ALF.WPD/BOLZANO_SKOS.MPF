N5 R3=3      ; SZEROKOSC WZORU
N10 R4=9     ; MODEL
N15 R6=812   ; SZEROKOSC SKRZYDLA
N20 R7=2030  ; DLUGOSC SKRZYDLA

N25 R20=41 ; GRUBOSC MATERIALU
N30 R21=0  ; GLEBOKOSC FREZOWANIA

N35 m70 h11 g54 m51 g64
N40 g53 g40 g0 g90 d0 z340

N45 BOLZANO:
;-----------

; UWAGA! SPRAWDZ PARAMETR OD GRUBOSCI SKRZYDLA W PN

N50 R50=(R3*100)+230 ; SZEROKOSC OKIENKA
N55 R51=100          ; WYSOKOSC OKIENKA
N60 R52=98           ; ODLEGLOSC MIEDZY OKIENKAMI
N65 R53=1            ; LICZNIK OKIENEK
N70 R54=130          ; ODLEGLOSC DO PIERWSZEGO OKIENKA W X
N75 R55=2            ; LICZNIK OPERACJI 1-FREZ ZGRUBNY 2-DOKLADNY

N80 R71=R54                 ; WYS PIERWSZEGO OKIENKA
N85 R72=R54+(R51*1)+(R52*1) ; WYS DRUGIEGO OKIENKA
N90 R73=R54+(R51*2)+(R52*2) ; WYS TRZECIEGO OKIENKA
N95 R74=R54+(R51*3)+(R52*3) ; WYS CZWARTEGO OKIENKA
N100 R75=R54+(R51*4)+(R52*4) ; WYS PIATEGO OKIENKA
N105 R76=R54+(R51*5)+(R52*5) ; WYS SZUSTEGO OKIENKA
N110 R77=R54+(R51*6)+(R52*6) ; WYS SIUDMEGO OKIENKA
N115 R78=R54+(R51*7)+(R52*7) ; WYS OSMEGO OKIENKA
N120 R79=R54+(R51*8)+(R52*8) ; WYS DZIEWIATEGO OKIENKA

;N1755 ATRANS X=13

;---------
N125 IF R4==2 GOTOF BOLZANO_2
N130 IF R4==3 GOTOF BOLZANO_3
N135 IF R4==4 GOTOF BOLZANO_4
N140 IF R4==5 GOTOF BOLZANO_5
N145 IF R4==9 GOTOF BOLZANO_9
N150 MSG("ZLE USTAWIONY PARAMETR R4")
N155 M0
N160 M17

N165 BOLZANO_2:
;---------
N170 R81=R72
N175 R82=R78
N180 GOTOF WYB_OKIENKA

N185 BOLZANO_3:
;---------
N190 R81=R72
N195 R82=R75
N200 R83=R78
N205 GOTOF WYB_OKIENKA

N210 BOLZANO_4:
;--------------
N215 R81=R72
N220 R82=R74
N225 R83=R76
N230 R84=R78
N235 GOTOF WYB_OKIENKA

N240 BOLZANO_5:
;---------

N245 R81=R71
N250 R82=R73
N255 R83=R75
N260 R84=R77
N265 R85=R79
N270 GOTOF WYB_OKIENKA

N275 BOLZANO_9:
;---------
N280 R81=R71
N285 R82=R72
N290 R83=R73
N295 R84=R74
N300 R85=R75
N305 R86=R76
N310 R87=R77
N315 R88=R78
N320 R89=R79
N325 GOTOF WYB_OKIENKA

N330 WYB_OKIENKA:
;-------------

N335 IF R53>R4 GOTOF END_BOLZANO

N340 IF R53==1
N345 	R70=R81
N350 ENDIF

N355 IF R53==2
N360 	R70=R82
N365 ENDIF

N370 IF R53==3
N375 	R70=R83
N380 ENDIF

N385 IF R53==4
N390 	R70=R84
N395 ENDIF

N400 IF R53==5
N405 	R70=R85
N410 ENDIF

N415 IF R53==6
N420 	R70=R86
N425 ENDIF

N430 IF R53==7
N435 	R70=R87
N440 ENDIF

N445 IF R53==8
N450 	R70=R88
N455 ENDIF

N460 IF R53==9
N465 	R70=R89
N470 ENDIF



N475 BOLZANO_PROG:
;--------------
N480 R55=2
N485 IF R55==1 GOTOF FREZOWANIE_ZGRUBNE
N490 IF R55==2 GOTOF FREZOWANIE_DOKLADNE
N495 M30

N500 FREZOWANIE_ZGRUBNE:
;------------------
N505 WECHSEL(10,3,180) ; FREZOWANIE ZGRUBNE
N510 CPRECON

N515 G0 X=R70+R51-16 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N520 G0 Z=-37+R20+50 M21
N525 G0 Z=-37+R20+10
;N530 G1 Z=-37-5 F200 
N535 G3 X=IC(15) Y=IC(15) Z=-37-5 CR=15 F1000
N540 G1 Y=((R6-R50)/2)+R50-1 RND=15 F4000
N545 G1 X=R70+1 RND=15
N550 G1 Y=((R6-R50)/2)+1 RND=15
N555 G1 X=R70+R51-1 RND=15
N560 G1 Y=((R6-R50)/2)+(R50/2)+15
N565 G3 X=IC(-15) Y=IC(15) CR=15
N570 G0 Z=-37+R20+50 G40

N575 R53=R53+1

N580 IF R53>R4
N585 R53=1
N590 R55=2
N595 ENDIF

N600 GOTOB WYB_OKIENKA

; - - - - - - - - - - - - - - - - - - 

N605 FREZOWANIE_DOKLADNE:
;-------------------

N610 WECHSEL(10,3,180) ; FREZOWANIE DOKLADNE
N615 CPRECON

N620 G0 X=R70+R51-15 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N625 G0 Z=-37+R20+50 M21
N630 G0 Z=-37+R20+2
N635 G1 Z=-37+R20-R21 F1000 
N640 G3 X=IC(15) Y=IC(15) CR=15 F4000
N645 G1 Y=((R6-R50)/2)+R50 RND=15
N650 G1 X=R70 RND=15
N655 G1 Y=((R6-R50)/2) RND=15
N660 G1 X=R70+R51 RND=15
N665 G1 Y=((R6-R50)/2)+(R50/2)+15
N670 G3 X=IC(-15) Y=IC(15) CR=15

N675 R22=10 ; WARTOSC POCZATKLOWA WYBIERANIA
N680 R23=1  ; LICZNIK
N685 WYBIERANIE:
N690 G1 X=R70+R51-R22 Y=((R6-R50)/2)+(R50/2) G40 D1
N695 G1 Y=((R6-R50)/2)+R50-R22
N700 G1 X=R70+R22
N705 G1 Y=((R6-R50)/2)+R22
N710 G1 X=R70+R51-R22
N715 G1 Y=((R6-R50)/2)+(R50/2)
N720 G1 X=R70+R51-R22
N725 R22=R22+10 ; KOLEJNA WARTOSC SKOKU WYBIERANIA
N730 IF R23==5 GOTOF KONIEC_WYBIERANIA
N735 R23=R23+1
N740 GOTOB WYBIERANIE

N745 KONIEC_WYBIERANIA:
N750 G0 Z=-37+R20+50 G40

N755 R53=R53+1
N760 GOTOB WYB_OKIENKA

;----

N765 END_BOLZANO:
;----------------
N770 G0 G90 G53 G40 D0 Z340
N775 ROT
N780 M17

;------------------------------------


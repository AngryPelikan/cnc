
;------ANTYWLAMY DO FUTRYNY METALOWEJ--------------

N5  r0=1 ; wybor stolu
N10 r6=915 ; szerokosc skrz.
N15 r16=123
N20 r101=1 ; 1-lewe  2-prawe

;   Uwaga !!!!!!!!      wywalic punkty zerowe
; program do bolcow przeciwwywazeniowych PN lewe i prawe
; r16-ilosc bolcow 123-wszystkie trzy; 13-pierwszy i trzeci
;                  12- pierwszy i drugi; 23 drugi i trzeci
;                  1-pierwszy; 2-drugi; 3-trzeci
; program bez funkcji frame   w G18

;Program

N25 if r0==1 gotof stol1
N30 if r0==2 gotof stol2
N35 m30

N40 stol1:
N45 m70 h11 g54 m51 g64; pierwszy stol
N50 gotof prog

N55 stol2:
N60 m70 h11 g56 m52 g64; drugi stol
N65 gotof prog

N70 prog:
N75 g53 g40 g0 g90 d0 z340


N85 r120=200;326;282 ;wysokosc w x (1)/(-1 rysiek 21.08)
N90 r121=75.2 ;dlugosc elementu
N95 r122=-17.7 ;wysokosc w z
N100 r123=17-.2 ;szerokosc elementu
N105 r124=863;820 ;wysokosc w x (2)
N110 r125=1804;1762 ;wysokosc w x (3)/(-3 rysiek 21.08)
N115 r126=2 ;glebokosc
;lewe czy prawe
N120 if r101==1 gotof lewe
N125 if r101==2 gotof prawe
N130 m17

N135 lewe:

;parametry 
N140 if r16==0 gotof end
N145 if r16==1 gotof anty1
N150 if r16==2 gotof anty2
N155 if r16==3 gotof anty3
N160 if r16==123 gotof anty1
N165 if r16==12 gotof anty1
N170 if r16==13 gotof anty1
N175 if r16==23 gotof anty2
N180 if r16==3 gotof anty3

N185 m17

N190 anty1:
;Program

;Narzedzie
N195 wechsel(4,3,30)
N200 c0
N205 g18
N210 cprecon

N215 x=r120+30 y=-20 g41 d1
N220 z=r122 
;N65 g1 y=2 f3000
N225 g1 x=r120+r121-(r123/2) y=r126 f3000
N230 g3 z=r122-r123 cr=r123/2
N235 g1 x=r120+(r123/2)
N240 g3 z=r122 cr=r123/2
N245 g1 x=r120+r121-(r123/2)
N250 g0 y=-20
N255 x=ic(1) g40 d1
N260 x=r120+22+2.5 y=-2 z=r122-(r123/2)
N265 g1 y=6 f2000
N270 g0 y=-2
N275 x=ic(25.5)
N280 g1 y=6 f2000
N285 g0 y=-20
N290 z50


N295 cprecof
N300 g17
N305 if r16==1 gotof end
N310 if r16==13 gotof anty3


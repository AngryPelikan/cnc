N380 x=r124+22+2.5 y=-2 z=r122-(r123/2)
N385 g1 y=6 f2000
N390 g0 y=-2
N395 x=ic(25.5)
N400 g1 y=6 f2000
N405 g0 y=-20
N410 z50


N415 cprecof

N5 BOLZANO:
;-----------

N10 R4=4
N15 R6=812 ; SZEROKOSC SKRZYDLA
N20 R15=42 ; GRUBOSC MATERIALU

N25 m70 h11 g54 m51 g64
N30 g53 g40 g0 g90 d0 z340

; UWAGA! SPRAWDZ PARAMETR OD GRUBOSCI SKRZYDLA W PN

N35 R50=530 ; SZEROKOSC OKIENKA
N40 R51=100          ; WYSOKOSC OKIENKA
N45 R52=100     ; ODLEGLOSC MIEDZY OKIENKAMI
N50 R53=1            ; LICZNIK OKIENEK
N55 R54=100     ; ODLEGLOSC DO PIERWSZEGO OKIENKA W X
N60 R55=1            ; LICZNIK OPERACJI 1-FREZ ZGRUBNY 2-DOKLADNY

N65 R71=R54                 ; WYS PIERWSZEGO OKIENKA
N70 R72=300                 ; WYS DRUGIEGO OKIENKA
N75 R73=500                 ; WYS TRZECIEGO OKIENKA
N80 R74=700                 ; WYS CZWARTEGO OKIENKA
N85 R75=R54+(R51*4)+(R52*4) ; WYS PIATEGO OKIENKA
N90 R76=R54+(R51*5)+(R52*5) ; WYS SZUSTEGO OKIENKA
N95 R77=R54+(R51*6)+(R52*6) ; WYS SIUDMEGO OKIENKA
N100 R78=R54+(R51*7)+(R52*7) ; WYS OSMEGO OKIENKA
N105 R79=R54+(R51*8)+(R52*8) ; WYS DZIEWIATEGO OKIENKA

N110 R90=0   ; PROMIEN
N115 R91=15  ; PROMIEN PIERWSZEGO OKIENKA
N120 R92=15  ; PROMIEN DRUGIEGO OKIENKA
N125 R93=20 ; PROMIEN TRZECIEGO OKIENKA
N130 R94=20 ; PROMIEN CZWARTEGO OKIENKA

;---------
N135 GOTOF BOLZANO_2

N140 IF R4==3 GOTOF BOLZANO_3
N145 IF R4==4 GOTOF BOLZANO_4
N150 IF R4==5 GOTOF BOLZANO_5
N155 IF R4==9 GOTOF BOLZANO_9
N160 MSG("ZLE USTAWIONY PARAMETR R4")
N165 M0
N170 M17

N175 BOLZANO_2:
;---------
N180 R81=R71
N185 R82=R72
N190 R83=R73
N195 R84=R74

N200 GOTOF WYB_OKIENKA

N205 BOLZANO_3:
;---------
N210 R81=R72
N215 R82=R75
N220 R83=R78
N225 GOTOF WYB_OKIENKA

N230 BOLZANO_4:
;--------------
N235 R81=R72
N240 R82=R74
N245 R83=R76
N250 R84=R78
N255 GOTOF WYB_OKIENKA

N260 BOLZANO_5:
;---------

N265 R81=R71
N270 R82=R73
N275 R83=R75
N280 R84=R77
N285 R85=R79
N290 GOTOF WYB_OKIENKA

N295 BOLZANO_9:
;---------
N300 R81=R71
N305 R82=R72
N310 R83=R73
N315 R84=R74
N320 R85=R75
N325 R86=R76
N330 R87=R77
N335 R88=R78
N340 R89=R79
N345 GOTOF WYB_OKIENKA

N350 WYB_OKIENKA:
;-------------

N355 IF R53>R4 GOTOF END_BOLZANO

N360 IF R53==1
N365 	R70=R81
N370 R90=R91
N375 ENDIF

N380 IF R53==2
N385 	R70=R82
N390 R90=R92
N395 ENDIF

N400 IF R53==3
N405 	R70=R83
N410 R90=R93
N415 ENDIF

N420 IF R53==4
N425 	R70=R84
N430 R90=R94
N435 ENDIF

N440 IF R53==5
N445 	R70=R85
N450 ENDIF

N455 IF R53==6
N460 	R70=R86
N465 ENDIF

N470 IF R53==7
N475 	R70=R87
N480 ENDIF

N485 IF R53==8
N490 	R70=R88
N495 ENDIF

N500 IF R53==9
N505 	R70=R89
N510 ENDIF



N515 BOLZANO_PROG:
;--------------

N520 IF R55==1 GOTOF FREZOWANIE_ZGRUBNE
N525 IF R55==2 GOTOF FREZOWANIE_DOKLADNE
N530 M30

N535 FREZOWANIE_ZGRUBNE:
;------------------
N540 WECHSEL(1,3,180) ; FREZOWANIE ZGRUBNE
N545 CPRECON

N550 G0 X=R70+R51-16 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N555 G0 Z=-37+R15+50 M21
N560 G0 Z=-37+R15+10
N565 G1 Z=-37-5 F1000 
N570 G3 X=IC(15) Y=IC(15) CR=15 F4000
N575 G1 Y=((R6-R50)/2)+R50-1 RND=R90
N580 G1 X=R70+1 RND=R90
N585 G1 Y=((R6-R50)/2)+1 RND=R90
N590 G1 X=R70+R51-1 RND=R90
N595 G1 Y=((R6-R50)/2)+(R50/2)+15
N600 G3 X=IC(-15) Y=IC(15) CR=15
N605 G0 Z=-37+R15+50 G40

N610 R53=R53+1

N615 IF R53>R4
N620 R53=1
N625 R55=2
N630 ENDIF

N635 GOTOB WYB_OKIENKA

; - - - - - - - - - - - - - - - - - - 

N640 FREZOWANIE_DOKLADNE:
;-------------------

N645 WECHSEL(10,3,180) ; FREZOWANIE DOKLADNE
N650 CPRECON

N655 G0 X=R70+R51-15 Y=((R6-R50)/2)+(R50/2)-15 G41 D1
N660 G0 Z=-37+R15+50 M21
N665 G0 Z=-37+R15+10
N670 G1 Z=-37-5 F1000 
N675 G3 X=IC(15) Y=IC(15) CR=15 F4000
N680 G1 Y=((R6-R50)/2)+R50 RND=R90
N685 G1 X=R70 RND=R90
N690 G1 Y=((R6-R50)/2) RND=R90
N695 G1 X=R70+R51 RND=R90
N700 G1 Y=((R6-R50)/2)+(R50/2)+15
N705 G3 X=IC(-15) Y=IC(15) CR=15
N710 G0 Z=-37+R15+50 G40

N715 R53=R53+1
N720 GOTOB WYB_OKIENKA

N725 END_BOLZANO:
;----------------
N730 G0 G90 G53 G40 D0 Z340
N735 ROT
N740 M17

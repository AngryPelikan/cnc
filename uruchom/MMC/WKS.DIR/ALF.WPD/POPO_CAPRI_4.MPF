PARAMETRY

IF R100==1 GOTOF STOL1
IF R100==2 GOTOF STOL2
m30

STOL1:
;-----
N60 m70 h11 g54 m51 g64
N65 g53 g40 g0 g90 d0 z340
GOTOF CDN

STOL2:
;-----
N60 m70 h11 g56 m52 g64
N65 g53 g40 g0 g90 d0 z340
GOTOF CDN

CDN:
;----

N70 IF R3==1 GOTOF AMERYKA
N75 IF R3==2 GOTOF PN
N80 M30

N85 AMERYKA:
N90 R18=0
N95 GOTOF PR_CAPRI

N100 PN:
N105 R18=13
N110 GOTOF PR_CAPRI

N115 PR_CAPRI:
;--------

N118 IF R1==1 GOTOF CAPRI1
N120 IF R1==2 GOTOF CAPRI2
N125 IF R1==5 GOTOF CAPRI5
N130 IF R1==6 GOTOF CAPRI6
N135 IF R1==9 GOTOF CAPRI9
N140 M30


N145 CAPRI2:
;------
N150 R50=3         ; ILOSC POL
N155 R54=30        ; SZEROKOSC SZYBY
N160 R51=385+R18   ; DLUGOSC PIERWSZEGO POLA
N165 R52=1200      ; DLUGOSC SRODKOWEGO POLA
N170 R53=R7+R18-R51-(R52*(R50-2))-((R50-1)*R54)+R5 ; TRZECIE POLE
N175 GOTOF P_CAPRI

N180 CAPRI5:
;------
N185 R50=6         ; ILOSC POL
N190 R54=30        ; SZEROKOSC SZYBY
N195 R51=200+R18   ; DLUGOSC PIERWSZEGO POLA
N200 R52=370       ; DLUGOSC SRODKOWEGO POLA
N205 R53=R7+R18-R51-(R52*(R50-2))-((R50-1)*R54)+R5 ; TRZECIE POLE
N210 GOTOF P_CAPRI

N215 CAPRI6:
;------
N220 R50=7         ; ILOSC POL
N225 R54=105       ; SZEROKOSC SZYBY
N230 R51=200+R18   ; DLUGOSC PIERWSZEGO POLA
N235 R52=200       ; DLUGOSC SRODKOWEGO POLA
N240 R53=R7+R18-R51-(R52*(R50-2))-((R50-1)*R54)+R5 ; TRZECIE POLE
N245 GOTOF P_CAPRI

N250 CAPRI9:
;------
N255 R50=10        ; ILOSC POL
N260 R54=30        ; SZEROKOSC SZYBY
N265 R51=200+R18   ; DLUGOSC PIERWSZEGO POLA
N270 R52=170       ; DLUGOSC SRODKOWEGO POLA
N275 R53=R7+R18-R51-(R52*(R50-2))-((R50-1)*R54)+R5 ; TRZECIE POLE
N280 GOTOF P_CAPRI

N285 P_CAPRI:
;-------

N290 ATRANS X=30 Y=5

N295 R60=-90
N300 WECHSEL(9,3,50)
N305 CPRECON
N310 D1
N315 R61=COS(R60)*$TC_DP5[$P_TOOLNO,1] ; X
N320 R62=SIN(R60)*$TC_DP5[$P_TOOLNO,1] ; Y
N325 D9
N330 ATRANS X=R61 Y=R62 ;***

N335 PROGRAM:
;-------

N340 IF R2==1 GOTOF LAM1
N345 IF R2==2 GOTOF FOR1
N350 M30

N355 FOR1:
N360 G0 X=R51+(R52*(R50-2))+(R55*(R50-1))+R53 Y=0 C=R60
N365 G0 Z=-37+R15+R16+5
N370 G1 Z=-37+R16+R15-R17 F1000
N375 G1 X=0 F10000
N380 G0 Z=-37+R15+R16+50

N385 LAM1:
N390 G0 X=0 Y=0 C=R60
N395 G0 Z=-37+R15+R16+5
N400 G1 Z=-37+R16-2 F1000
N405 G1 X=R51+(R52*(R50-2))+(R55*(R50-1))+R53 F5000
N410 G0 Z=-37+R15+R16+50

N415 ATRANS X=-R61 Y=-R62 ;***
N420 CPRECOF

N425 R60=90
N430 WECHSEL(9,3,50)
N435 CPRECON
N440 D1
N445 R61=COS(R60)*$TC_DP5[$P_TOOLNO,1] ; X
N450 R62=SIN(R60)*$TC_DP5[$P_TOOLNO,1] ; Y
N455 D9
N460 ATRANS X=R61 Y=R62 ;***

N465 PROGRAM:
;-------

N470 IF R2==1 GOTOF LAM2
N475 IF R2==2 GOTOF FOR2
N480 M30

N485 FOR2:
N490 G0 X=0 Y=R6-(R8*2) C=R60
N495 G0 Z=-37+R15+R16+5
N500 G1 Z=-37+R16+R15-R17 F1000
N505 G1 X=R51+(R52*(R50-2))+(R55*(R50-1))+R53 F10000
N510 G0 Z=-37+R15+R16+50

N515 LAM2:
N520 G0 X=R51+(R52*(R50-2))+(R55*(R50-1))+R53 F3000 Y=R6-(R8*2) C=R60
N525 G0 Z=-37+R15+R16+5
N530 G1 Z=-37+R16-2 F1000
N535 G1 X=0 F5000
N540 G0 Z=-37+R15+R16+50

N545 ATRANS X=-R61 Y=-R62 ;***
N550 CPRECOF

N555 R60=0
N560 WECHSEL(9,3,50)
N565 CPRECON
N570 D1
N575 R61=COS(R60)*$TC_DP5[$P_TOOLNO,1] ; X
N580 R62=SIN(R60)*$TC_DP5[$P_TOOLNO,1] ; Y
N585 D9
N590 ATRANS X=R61 Y=R62 ;***

N595 PROGRAM:
;-------

;4
N600 IF R2==1 GOTOF LAM3
N605 IF R2==2 GOTOF FOR3
N610 M30

N615 FOR3:
N620 G0 X=R51+((R50-2)*R52)+((R50-1)*R55)+R53 Y=R6-(R8*2) C=R60
N625 G0 Z=-37+R15+R16+5
N630 G1 Z=-37+R16+R15-R17 F1000
N635 G1 Y=0 F10000
N640 G0 Z=-37+R15+R16+50

N645 LAM3:
N650 G0 X=R51+((R50-2)*R52)+((R50-1)*R55)+R53 Y=0 C=R60
N655 G0 Z=-37+R15+R16+5
N660 G1 Z=-37+R16-2 F1000
N665 G1 Y=R6-(R8*2) F5000
N670 G0 Z=-37+R15+R16+50

;--------------------------
;3
N675 R56=R50-2
N680 R57=R51+((R50-2)*R52)+((R50-2)*R55)
N685 XXX:
;---

N690 IF R2==1 GOTOF LAM4
N695 IF R2==2 GOTOF FOR4
N700 M30

N705 FOR4:
N710 G0 X=R57 Y=R6-(R8*2) C=R60
N715 G0 Z=-37+R15+R16+5
N720 G1 Z=-37+R16+R15-R17 F1000
N725 G1 Y=0 F10000
N730 G0 Z=-37+R15+R16+50

N735 LAM4:
N740 G0 X=R57 Y=0 C=R60
N745 G0 Z=-37+R15+R16+5
N750 G1 Z=-37+R16-2 F1000
N755 G1 Y=R6-(R8*2) F5000
N760 G0 Z=-37+R15+R16+50

N765 R56=R56-1
N770 R57=R57-R52-R55
N775 IF R56==0 GOTOF RESZTA
N780 GOTOB XXX

N785 RESZTA:

;--------------------------
;2

N790 IF R2==1 GOTOF LAM5
N795 IF R2==2 GOTOF FOR5
N800 M30

N805 FOR5:
N810 G0 X=R51 Y=R6-(R8*2) C=R60
N815 G0 Z=-37+R15+R16+5
N820 G1 Z=-37+R16+R15-R17 F1000
N825 G1 Y=0 F10000
N830 G0 Z=-37+R15+R16+50

N835 LAM5:
N840 G0 X=R51 Y=0 C=R60
N845 G0 Z=-37+R15+R16+5
N850 G1 Z=-37+R16-2 F1000
N855 G1 Y=R6-(R8*2) F5000
N860 G0 Z=-37+R15+R16+50

;----

N865 IF R2==1 GOTOF LAM6
N870 IF R2==2 GOTOF FOR6
N875 M30

N880 FOR6:
N885 G0 X=-R55 Y=R6-(R8*2) C=R60
N890 G0 Z=-37+R15+R16+5
N895 G1 Z=-37+R16+R15-R17 F1000
N900 G1 Y=0 F10000
N905 G0 Z=-37+R15+R16+50

N910 LAM6:
;1
N915 G0 X=-R55 Y=0 C=R60
N920 G0 Z=-37+R15+R16+5
N925 G1 Z=-37+R16-2 F1000
N930 G1 Y=R6-(R8*2) F5000
N935 G0 Z=-37+R15+R16+50

N940 ATRANS X=-R61 Y=-R62 ;***
N945 CPRECOF

N950 G0 G90 G53 G40 D0 Z340 S0
N955 gotof koniec

koniec:
if r100==1 gotof plus
if r100==2 gotof minus
m30

plus:
r100=r100+1
m30

minus:
r100=r100-1
m30


CAPRI1:
;------

ATRANS X=30 Y=10

R60=-90
WECHSEL(9,3,50)
CPRECON
D1
R61=COS(R60)*$TC_DP5[$P_TOOLNO,1] ; X
R62=SIN(R60)*$TC_DP5[$P_TOOLNO,1] ; Y
D9
ATRANS X=R61 Y=R62 ;***

PROGRAM:
;-------
G0 X=0 Y=0 C=R60
G0 Z=-37+R15+16+5
G1 Z=-37+R16-2 F1000
G1 X=R70 F5000
G0 Z=-37+R15+R16+50

ATRANS X=-R61 Y=-R62 ;***
CPRECOF


R60=0
WECHSEL(9,3,50)
CPRECON
D1
R61=COS(R60)*$TC_DP5[$P_TOOLNO,1] ; X
R62=SIN(R60)*$TC_DP5[$P_TOOLNO,1] ; Y
D9
ATRANS X=R61 Y=R62 ;***

PROGRAM:
;-------
G0 X=R70 Y=0 C=R60
G0 Z=-37+R15+16+5
G1 Z=-37+R16-2 F1000
G1 Y=R71 F5000
G0 Z=-37+R15+R16+50

ATRANS X=-R61 Y=-R62 ;***
CPRECOF

R60=90
WECHSEL(9,3,50)
CPRECON
D1
R61=COS(R60)*$TC_DP5[$P_TOOLNO,1] ; X
R62=SIN(R60)*$TC_DP5[$P_TOOLNO,1] ; Y
D9
ATRANS X=R61 Y=R62 ;***

PROGRAM:
;-------
G0 X=R70 Y=R71 C=R60
G0 Z=-37+R15+16+5
G1 Z=-37+R16-2 F1000
G1 X=0 F5000
G0 Z=-37+R15+R16+50

ATRANS X=-R61 Y=-R62 ;***
CPRECOF

R60=180
WECHSEL(9,3,50)
CPRECON
D1
R61=COS(R60)*$TC_DP5[$P_TOOLNO,1] ; X
R62=SIN(R60)*$TC_DP5[$P_TOOLNO,1] ; Y
D9
ATRANS X=R61 Y=R62 ;***

PROGRAM:
;-------
G0 X=0 Y=R71 C=R60
G0 Z=-37+R15+16+5
G1 Z=-37+R16-2 F1000
G1 Y=0 F5000
G0 Z=-37+R15+R16+50

ATRANS X=-R61 Y=-R62 ;***
CPRECOF

N950 G0 G90 G53 G40 D0 Z340 S0
GOTOB KONIEC


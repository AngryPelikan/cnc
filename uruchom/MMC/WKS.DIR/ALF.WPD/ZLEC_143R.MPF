N5 R50=4    ; WYBOR PLYTKI
N10 R15=25.4  ; GRUBOSC MATERIALU
N15 R16=22.2  ; GRUBOSC SZABLONU
N20 R17=15.5  ; GLEBOKOSC FREZOWANIA

N25 R58=1       ; LICZNIK FREZOWAN

N30 M70 H11 G54 M51 G64
N35 G53 G40 G0 G90 D0 Z340

N40 ATRANS X=50 Y=50

N45 IF R50==1
N50 R51=290    ; WYMIAR A
N55 R52=44.5   ; WYMIAR B
N60 R53=79     ; WYMIAR C
N65 R54=264    ; WYMIAR D
N70 R55=1      ; ILOSC LACZNIKOW
N75 ENDIF

N80 IF R50==2
N85 R51=294    ; WYMIAR A
N90 R52=100.5  ; WYMIAR B
N95 R53=135    ; WYMIAR C
N100 R54=268    ; WYMIAR D
N105 R55=2      ; ILOSC LACZNIKOW
N110 ENDIF

N115 IF R50==3
N120 R51=294    ; WYMIAR A
N125 R52=44.5   ; WYMIAR B
N130 R53=79     ; WYMIAR C
N135 R54=268    ; WYMIAR D
N140 R55=1      ; ILOSC LACZNIKOW
N145 ENDIF

N150 IF R50==4
N155 R51=290    ; WYMIAR A
N160 R52=100.5  ; WYMIAR B
N165 R53=135    ; WYMIAR C
N170 R54=264    ; WYMIAR D
N175 R55=2      ; ILOSC LACZNIKOW
N180 ENDIF

N185 IF R55==1
N190 R56=22.5   ; WYMIAR DO OSI PIERWSZEGO OTWORU
N195 R57=0      ; WYMIAR DO OSI PIERWSZEGO OTWORU
N200 ENDIF

N205 IF R55==2
N210 R56=27.5   ; WYMIAR DO OSI PIERWSZEGO OTWORU
N215 R57=77.5   ; WYMIAR DO OSI PIERWSZEGO OTWORU
N220 ENDIF

N225 FREZ_1:
;-------

N230 IF R58==1 GOTOF PIERWSZY
N235 IF R58==2 GOTOF DRUGI
N240 IF R58==3 GOTOF TRZECI
N245 IF R58==4 GOTOF CZWARTY
N250 IF R58==5 GOTOF WYCIN_FREZ
N255 M30

N260 PIERWSZY:
;------------
N265 ATRANS Y=R53-R56
N270 GOTOF PROG_RAM

N275 DRUGI:
;-----
N280 ATRANS X=R51 Y=R53-R56
N285 AROT Z=180
N290 GOTOF PROG_RAM

N295 TRZECI:
;-------
N300 ATRANS Y=R53-R57
N305 GOTOF PROG_RAM

N310 CZWARTY:
;--------
N315 ATRANS X=R51 Y=R53-R57
N320 AROT Z=180
N325 GOTOF PROG_RAM


N330 PROG_RAM:
;--------

N335 WECHSEL(2,3,180)
N340 CPRECOF
N345 G0 X=-30 Y=5 G42 D2
N350 G0 Z=-37+R15+R16+10
N355 G1 Z=-37+R16+R15-R17 F1000
N360 G1 X=38.229 F2000
N365 G2 X=38.229 Y=-5 CR=-17.5
N370 G1 X=-30
N375 G1 X=-20 Y=0 G40
N380 G1 X=55+3
N385 G2 X=55-3 CR=3
N390 G2 X=55+3 CR=3
N395 G1 X=55+9
N400 G2 X=55-9 CR=9
N405 G2 X=55+9 CR=9
N410 G0 Z=-37+R15+R16+30 G40

N415 IF R58==1 GOTOF PIERWSZY_END
N420 IF R58==2 GOTOF DRUGI_END
N425 IF R58==3 GOTOF TRZECI_END
N430 IF R58==4 GOTOF CZWARTY_END
N435 M30

N440 PIERWSZY_END:
;------------
N445 ATRANS Y=-(R53-R56)
N450 R58=R58+1
N455 GOTOB FREZ_1

N460 DRUGI_END:
;---------
N465 AROT Z=-180
N470 ATRANS X=-R51 Y=-(R53-R56)
N475 R58=R58+1
N480 IF R55==1 GOTOF WYCIN_FREZ
N485 GOTOB FREZ_1

N490 TRZECI_END:
;----------
N495 ATRANS Y=-(R53-R57)
N500 R58=R58+1
N505 GOTOB FREZ_1

N510 CZWARTY_END:
;-----------
N515 AROT Z=-180
N520 ATRANS X=-R51 Y=-(R53-R57)
N525 R58=R58+1
N530 GOTOB FREZ_1




N535 WYCIN_FREZ:
;----------
N540 CPRECOF
N545 WECHSEL(10,3,180)
N550 CPRECON

N555 G0 X=0 Y=R53+30 G42 D1
N560 G0 Z=-37+R15+R16+10
N565 G1 Z=-37+R16-3 F1000
N570 G1 X=0 Y=R53-R52 F3000
N575 G1 X=13
N580 G1 Y=0
N585 G1 X=R51-13
N590 G1 Y=R53-R52
N595 G1 X=R51
N600 G1 Y=R53+30
N605 G0 G90 G53 G40 D0 Z340 S0

N610 PILA:
;-----
N615 R60=90
N620 CPRECOF
N625 WECHSEL(9,3,50)
N630 CPRECON
N635 D1
N640 R61=COS(R60)*$TC_DP5[$P_TOOLNO,1] ; X
N645 R62=SIN(R60)*$TC_DP5[$P_TOOLNO,1] ; Y
N650 D9
N655 ATRANS X=R61 Y=R62 ;***

N660 PROGRAM:
;-------
N665 G0 X=R51 Y=R53 C=R60
N670 G0 Z=-37+R16+R15+10
N675 G1 Z=-37+R16-3 F1000
N680 G1 X=0 F3000
N685 G0 Z=-37+R15+50

N690 ATRANS X=-R61 Y=-R62 ;***
N695 CPRECOF

N700 G0 G90 G53 G40 D0 Z340 S0
N705 M30


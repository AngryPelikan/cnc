N167 R89=7 ; PROMIEN DOLNEGO LUKU

N168 GOTOF OTWORY

;--------------------------------


N169 OTWORY:

N170 WECHSEL(2,3,18000)
N171 B0 C0
N172 IF R9==1
N173   IF R0==1
N174     ATRANS Y=R6-R75
N175     ATRANS X=R7-R70
N176   ENDIF

N177   IF R0==2
N178     ATRANS Y=R75
N179     ATRANS X=R7-R70
N180   ENDIF

N181   OTWOR
N182   ROT
N183 ENDIF

N184 IF R9==4 ;2
N185   IF R0==1
N186     ATRANS Y=R6-R75
N187     ATRANS X=R7-R70
N188   ENDIF

N189   IF R0==2
N190     ATRANS Y=R75
N191     ATRANS X=R7-R70
N192   ENDIF
N193   OTWOR
  
N194   ATRANS X=R71

N195   FASOLKA
N196   ROT
N197 ENDIF


N198 IF R9==2 ;3

N199   IF R0==1
N200     ATRANS Y=R6-R75
N201     ATRANS X=R7-R70
N202   ENDIF

N203   IF R0==2
N204     ATRANS Y=R75
N205     ATRANS X=R7-R70
N206   ENDIF

N207   OTWOR

N208   ATRANS X=R72
N209   R76=R83
N210   OTWOR
N211   ROT
N212 ENDIF

N213 IF R9==3 ;4

N214   IF R0==1
N215     ATRANS Y=R6-R75
N216     ATRANS X=R7-R70
N217   ENDIF

N218   IF R0==2
N219     ATRANS Y=R75
N220     ATRANS X=R7-R70
N221   ENDIF

N222   OTWOR
N223   ATRANS X=R73
N224   WKLADKA
N225   ROT
N226 ENDIF


;KASETA ZAMKA
;--------------
N227 WECHSEL(1,3,18000)

N228 IF R0==1 GOTOF LEWE
N229 IF R0==2 GOTOF PRAWE
N230 MSG("BRAK OPCJI DLA TAKIEJ WARTOSCI R0")
N231 M0
N232 GOTOF KONIEC

N233 LEWE:


N234 G0 X=R41 Y=R6+30
N235 GOTOF LEWY_ZAMEK

N236 PRAWE:
;----------
N237 G0 X=R41 Y=-30
N238 GOTOF PRAWY_ZAMEK


N239 LEWY_ZAMEK:

N240 TRAFAN
N241 B180 C-180

N242 TRANS X=R41 Y=R6 Z=R15-R64-R52/2
N243 AROT X=-90
N244 KASETA_ZAMKA
N245 TRAFO_OFF

N246 GOUP
N247 M17


N248 PRAWY_ZAMEK:
N249 TRAFAN
N250 B180 C0

N251 TRANS X=R41 Y=0 Z=R15-R64-R52/2
N252 AROT X=90
N253 KASETA_ZAMKA
N254 TRAFO_OFF

N255 zakonczenie:
N256 GOUP
N257 M17
 

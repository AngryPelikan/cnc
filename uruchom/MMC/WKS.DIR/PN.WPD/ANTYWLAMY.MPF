IF R19==1 GOTOF ANTYWLAMY
MSG("BRAK OPCJI DLA R19")
GOTOF KONIEC

ANTYWLAMY:
N101 R71=76.3 ;DLUGOSC
N102 R72=17.6 ;SZEROKOSC
N103 R73=2.3 ;GLEBOKOSC
N104 R74=15 ;PODFREZOWANIE POD BOLEC (W OSI X OD SRODKA)
N105 R75=2 ;GLEBOKOSC PODFREZOWANIA POD BOLEC



R41=325.5 ; 1 OD GORY ANTYWLAM
R42=863.5 ; 2 OD GORYANTYWLAM
R43=210.5 ; DOLNY


IF R0==1 GOTOF LEWE
IF R0==2 GOTOF PRAWE


LEWE:
WECHSEL(2,3,18000)
G0 X=R41 Y=-30

GOTOF LEWE_ANTY

PRAWE:
WECHSEL(2,3,18000)
G0 X=R41 Y=R6+50

GOTOF PRAWE_ANTY

LEWE_ANTY:
TRAFAN
B180 C0

TRANS X=R41+(R71/2)+R21 Y=R21 Z=(R72/2)+2
AROT X=90
ANTYWLAM

TRANS X=R42+(R71/2)+R21 Y=R21 Z=(R72/2)+2
AROT X=90
ANTYWLAM

TRANS X=R7-R43+(R71/2)+R21 Y=R21 Z=(R72/2)+2
AROT X=90
ANTYWLAM
TRAFO_OFF

GOTOF KONIEC

PRAWE_ANTY:
TRAFAN
B=180 C=-180

TRANS X=R41+(R71/2)+R21 Y=R6+R21 Z=(R72/2)+2
AROT X=-90
ANTYWLAM

TRANS X=R42+(R71/2)+R21 Y=R6+R21 Z=(R72/2)+2
AROT X=-90
ANTYWLAM

TRANS X=R7-R43+(R71/2)+R21 Y=R6+R21 Z=(R72/2)+2
AROT X=-90
ANTYWLAM
TRAFO_OFF


GOTOF KONIEC


KONIEC:
GOUP
M17


N106 ZAWIASY:

N107 R46=0 ; LICZNIK
N108 R55=30 ; FELC
N109 R66=R15-R55 ; PRZYLGA
N110 R67=70.6 ; ROZSTAW ZAWIASOW




N111 IF R10==2
  N112 R40=2
  N113 R41=228 ; 1 ZAWIAS OD GORY
  N114 R42=308 ; DOLNY ZAWIAS

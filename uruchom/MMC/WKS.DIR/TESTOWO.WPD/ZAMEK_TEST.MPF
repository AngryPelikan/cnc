N170 OTWORY:

N171 WECHSEL(2,3,18000)
N172 B0 C0
N173 IF R9==1
N174   IF R0==1
N175     ATRANS Y=R6-R75
N176     ATRANS X=R7-R70
N177   ENDIF

N178   IF R0==2
N179     ATRANS Y=R75
N180     ATRANS X=R7-R70
N181   ENDIF

N182   OTWOR
N183   ROT
N184 ENDIF

N185 IF R9==4 ;2
N186   IF R0==1
N187     ATRANS Y=R6-R75
N188     ATRANS X=R7-R70
N189   ENDIF

N190   IF R0==2
N191     ATRANS Y=R75
N192     ATRANS X=R7-R70
N193   ENDIF
N194   OTWOR
  
N195   ATRANS X=R71

N196   FASOLKA
N197   ROT
N198 ENDIF


N199 IF R9==2 ;3

N200   IF R0==1
N201     ATRANS Y=R6-R75
N202     ATRANS X=R7-R70
N203   ENDIF

N204   IF R0==2

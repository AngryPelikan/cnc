;TOOL=5, NAME=T05 - 18MM REVERSABLE KNIFE, DIAMETER=18
;STORAGEBOX - 30 NOV 11 - 12:18
;TEST
;
;Machining Time = 5mins 59secs
R202=630  ;G53 SAFE Z HOME
;
;########### EDIT AS REQUIRED ###########
R203=350 ;G53 SAFE Z DRILL CHANGE PLANE
R204=630 ;G53 SAFE Z CHANGE PLANE
R270=1 ;START AREA 1=LH BED / 3=RH BED
;########################################
;
G40 D0 S0 G64 G451 CFIN
IF R270==3 GOTOF RHBED
M0 ;PROGRAM STOP - PRESS NC START TO CONTINUE
G54 ;LH BED
M51 ;VACUUM REQUEST LH BED
M121 ;STOPS DOWN
GOTOF MACHST
RHBED:
M0 ;PROGRAM STOP - PRESS NC START TO CONTINUE
G55 ;RH BED
M52 ;VACUUM REQUEST RH BED
M122 ;STOPS DOWN
MACHST:
G64 G451 CFIN CUT2DF SOFT
G0 G53 G601 G90 Z=R202
B0 C0

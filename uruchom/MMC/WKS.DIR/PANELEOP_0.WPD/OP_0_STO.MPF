;G54
;M51
N101 IF R11==1 GOTOF GORNY
N102 IF R11==2 GOTOF B_LEWY
N103 IF R11==3 GOTOF B_PRAWY
N104 MSG("BLEDNY WYBOR")
N105 GOTOF KONIEC

N106 GORNY:

N107 WECHSEL(4,3,18000)
N108 D1 G41
N109 G0 X=R7-R9 Y=-30 G41
N110 G0 Z=R2-R10+15
N111 G1 Z=R2-R10 F5000
N112 G1 Y=R9+15
N113 G1 X=R7-R9-15 
N114 G1 Y=R9
N115 G1 X=R3-R6+R9+20
G1 Y=R9+20
N116 G1 X=R3-R6+R9 
N117 G1 Y=-30; G41
N118 G1 X=R3-R6+R9+R8
N119 G1 Y=R9+R8+10
N120 G1 X=R3-R6+R9
N121 G1 Y=R9+R8
N122 G1 X=R7-R9
N123 G1 Y=R9+R8+12
N124 G1 X=R7-R9-R8
N125 G1 Y=-30
N126 G1 X=R7-R9-6-13 G40
N127 G1 Y=R9+R8-6
N128 G1 X=R7-R9-6
N129 G1 Y=R9+2 X=R7-R9-8
N130 G1 Y=R9+R8/2
N131 G1 X=R3-R6+R9+13
N132 G1 Y=R9+R8-6
N133 G1 X=R3-R6+R9+13+8
N134 G1 Y-30
N135 G1 X=R3-R6+R9+7
N136 G1 Y=R9+R8
N137 G0 Z=300

;LACZNIKI;

N138 PANEL_LEWY:
N139 ATRANS X=R3-R6+R9+R8+10 Z=R1
N140 OTWOR_PANELE
N141 TRANS

N142 IF R6>=110
N143 ATRANS X=R3-15-10 Z=R1
N144 OTWOR_PANELE
N145 TRANS
N146 ENDIF

N147 IF (R6>=200) AND (R6<=500)
N148 ATRANS X=R3-R6/2 Z=R1
N149 OTWOR_PANELE
N150 TRANS
N151 ELSE 
N152 GOTOF CZTERY
N153 ENDIF

N154 CZTERY:
N155 IF R6>500
N156 ATRANS X=R3-R6/3 Z=R1
N157 OTWOR_PANELE
N158 TRANS
N159 ATRANS X=R3-R6+(R6/3) Z=R1
N160 OTWOR_PANELE
N161 TRANS
N162 ENDIF


N163 PANEL_PRAWY:
N164 ATRANS X=R7-R9-R8-10 Z=R1
N165 OTWOR_PANELE
N166 TRANS

N167 IF R7>=110
N168 ATRANS X=15+10 Z=R1
N169 OTWOR_PANELE
N170 TRANS
N171 ENDIF


N172 IF (R7>=200) AND (R7<=500)
N173 ATRANS X=R7/2 Z=R1
N174 OTWOR_PANELE
N175 TRANS
N176 ELSE 
N177 GOTOF CZTERY
N178 ENDIF

N179 CZTERY:
N180 IF R7>500
N181 ATRANS X=R7/3 Z=R1
N182 OTWOR_PANELE
N183 TRANS
N184 ATRANS X=R7-(R7/3) Z=R1
N185 OTWOR_PANELE
N186 TRANS
N187 ENDIF
N188 GOTOF KONIEC

N189 B_LEWY:
N190 WECHSEL(4,3,18000)
N191 D1
N192 G0 X=-20 Y=R9 Z=R2+50 G41
N193 G0 Z=R2-R10
N194 G1 X=R5+20 F6000
N195 G1 Y=R9+R8
N196 G1 X=-20
N197 G1 Y=R9+(R8/2) G40
N198 G1 X=R5+20
N199 G0 Z=200

N200 LACZNIKI:
N201 ATRANS Y=R9+R8+10 Z=R1
N202 AROT Z=-90
N203 OTWOR_PANELE
N204 ROT
N205 IF R6>=110
N206 ATRANS Y=R6-15-10 Z=R1
N207 AROT Z=-90
N208 OTWOR_PANELE
N209 ROT
N210 ENDIF

N211 IF (R6>=200) AND (R6<=500)
N212 ATRANS Y=R6/2 Z=R1
N213 AROT Z=-90
N214 OTWOR_PANELE
N215 ROT
N216 ELSE 
N217 GOTOF CZTERY
N218 ENDIF

N219 CZTERY:
N220 IF R6>500
N221 ATRANS Y=R6-R6/3 Z=R1
N222 AROT Z=-90
N223 OTWOR_PANELE
N224 ATRANS Y=(R6/3) Z=R1
N225 OTWOR_PANELE
N226 ROT
N227 ENDIF
N228 GOTOF KONIEC


N229 B_PRAWY:
N230 WECHSEL(4,3,18000)
N231 D1
N232 G0 X=-20 Y=R9 Z=R2+50 G41
N233 G0 Z=R2-R10
N234 G1 X=R5+20 F6000
N235 G1 Y=R9+R8
N236 G1 X=-20
N237 G1 Y=R9+(R8/2) G40
N238 G1 X=R5+20
N239 G0 Z=200

N240 LACZNIKI:
N241 ATRANS X=R5 Y=R9+R8+10 Z=R1
N242 AROT Z=90
N243 OTWOR_PANELE
N244 ROT
N245 IF R6>=110
N246 ATRANS X=R5 Y=R7-15-10 Z=R1
N247 AROT Z=90
N248 OTWOR_PANELE
N249 ROT
N250 ENDIF

N251 IF (R6>=200) AND (R6<=500)
N252 ATRANS X=R5 Y=R7/2 Z=R1
N253 AROT Z=90
N254 OTWOR_PANELE
N255 ROT
N256 ELSE 
N257 GOTOF CZTERY
N258 ENDIF

N259 CZTERY:
N260 IF R6>500
N261 ATRANS X=R5 Y=R7-R7/3 Z=R1
N262 AROT Z=90
N263 OTWOR_PANELE
N264 ATRANS X=R5 Y=(R7/3) Z=R1
N265 OTWOR_PANELE
N266 ROT
N267 ENDIF
N268 GOTOF KONIEC

N269 KONIEC:
N270 GOUP
N271 G0 X=5000
N272 S0
N273 M17


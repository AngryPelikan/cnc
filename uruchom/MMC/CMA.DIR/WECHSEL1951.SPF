N101 PROC WECHSEL (INT TNR, INT DRR, INT DRZ)



;WECHSELPROGRAMM FUER V I S I O N - S P R I N T mit Werkzeugerkennung
;GEAENDERTE VERSION FUER VISION MIT FESTSTEHENDEM WECHSLER
;STAND 28.02.02

N102 DEF INT INFO_ABLEGENABHOLEN=0
N103 DEF INT INFO_ABHOLEN=0
N104 DEF INT INFO_NURABHOLEN=0
N105 DEF INT INFO_NURHOLEN=0
N106 DEF INT INFO_NURABLEGEN=0
N107 DEF REAL Z_ACHSE_HUB=630.0       ;Oberste Z-Position
N108 DEF REAL Z_ACHSE_ZANGENMASS=562 ;Wechselposition Z-Achse
N109 DEF REAL Y_ACHSE_ZANGENMASS=1584 ;WechselpositionY-Achse
N110 DEF REAL Y_ACHSE_ZANGEFREI=1180  ;Aus Wechselposition fahren
N111 DEF REAL Y_SCHMIERPOS=1570       ;Y- Schmierposition

N112 T=TNR ; --> Ausgabe T-wort an NC/SPS

N113 IF $P_SIM==1 GOTOF OHNE_SIM
N114 IF $P_SEARCH==1 GOTOF OHNE_SIM

N115 H76 G642  SOFT     ;Unterprogramm aktiv
N116 MSG("WERKZEUGWECHSEL AKTIV")
;N215 MSG("TOOL CHANGING IS ACTIV")
;N215 MSG("CHANGEMENT OUTIL ACTIF")
;N215 MSG("WERKTUIG WISSELING ACTIV")
;N215 MSG("CAMBIO DE HERRAMIENTA ACTIVIO")
;N215 MSG("AKTYWNA WYMIANA NARZEDZIA")
N117 TRANS

N118 AUSWAHL:
N119 IF $A_IN[40]==1 GOTOF ABLEGENABHOLEN
N120 IF $A_IN[34]==1 GOTOF SOLLISTGLEICH
N121 IF $A_IN[38]==1 GOTOF NURABHOLEN
N122 IF $A_IN[33]==1 GOTOF NURABLEGEN
N123 IF $A_IN[39]==1 GOTOF ENTNEHMEN   ;Fehler: WZ in Spindel
N124 GOTOB AUSWAHL


N125 NURABHOLEN:
N126 G0 G90  G153 D0 Z=Z_ACHSE_HUB S0 M86
N127 G153 B0 C0 
N128 STOPRE
N129 MSG("WERKZEUG WIRD ABGEHOLT")
;N330 MSG("PICK UP A TOOL")
;N330 MSG("OUTIL VAT ETRE PRIS")
;N330 MSG("WERKTUIG WORDT AFGEHAALD")
;N330 MSG("RECOGER HERRAMIENTA")
;N330 MSG("NARZEDZIE ZOSTAJE POBRANE Z MAGAZYNKA")
N130  G153 Y=Y_ACHSE_ZANGENMASS M98
N131  WHILE $A_IN[30]==0 
N132   G4F1
N133  ENDWHILE
N134 STOPRE
N135 H85         ;Drehen auf Position neues Werkzeug
N136 STOPRE
N137 G4 F0.1

N138 LS_BELEGT3:
N139 H71          ;Abfrage Werkzeugplatz frei
N140 IF $A_IN[37]==1 GOTOF LS_FREI3
N141 GOTOB LS_BELEGT3

N142 LS_FREI3:
N143 STOPRE
N144 H72          ;Futter oeffnen
N145 STOPRE
N146 M74          ;WZ abblasen ein
N147 WZLOESEN:
N148 IF $A_IN[36]==1 GOTOF GELOEST
N149 GOTOB WZLOESEN

N150 GELOEST:
N151 G153 D0 Z=Z_ACHSE_ZANGENMASS+6
N152 M75          ;WZ abblasen aus
N153 STOPRE
N154 G153 D0 Z=Z_ACHSE_ZANGENMASS-0.1
N155 STOPRE
N156 H73          ;Werkzeug spannen
N157 STOPRE

N158 WZSPANNEN:
N159 IF $A_IN[35]==1 GOTOF GESPANNT
N160 GOTOB WZSPANNEN

N161 GESPANNT:
N162  G153 Y=Y_ACHSE_ZANGENMASS-600
N163 STOPRE
N164 M97
N165 GOTOF MOTORANLASSEN
;----------------------------------------------------------------

N166 ABLEGENABHOLEN:
N167 G0 G90 G153 D0 Z=Z_ACHSE_HUB S0 M86
N168 G153 B0 C0 
N169 MSG("WERKZEUG WIRD ABGELEGT")
;N610 MSG("BRING BACK A TOOL")
;N610 MSG("OUTIL VAT ETRE DEPOSE")
;N610 MSG("WERKTUIG WORDT WEGGEZET")
;N610 MSG("DEPONER HERRAMIENTA")
;N610 MSG("NARZEDZIE ZOSTAJE ODDANE DO MAGAZYNKA")
N170 H84              ;Drehen auf Ablegeposition
N171 STOPRE 

N172 IF $AA_IM[Y]<(Y_ACHSE_ZANGENMASS-450) GOTOF FREI_1
N173 G153 Y=Y_ACHSE_ZANGENMASS-450
N174 STOPRE
N175 M98
N176 GOTOF FREI_2
N177 ENDIF

N178 FREI_1:
N179 G153 Y=Y_ACHSE_ZANGENMASS-450 M98
N180 STOPRE

N181 FREI_2:

N182  WHILE $A_IN[30]==0 
N183   G4F1
N184  ENDWHILE
N185 STOPRE
N186 G153 Z=Z_Achse_ZANGENMASS

N187 LS_BELEGT1:
N188 H71             ;Abfrage Werkzeugplatz frei
N189 IF $A_IN[37]==1 GOTOF LS_FREI1
N190 GOTOB LS_BELEGT1

N191 LS_FREI1:
N192 STOPRE
N193 G153 Y=Y_ACHSE_ZANGENMASS
N194 H72            ;Werkzeug loesen
N195 STOPRE

N196 WZLOESEN1:
N197 IF $A_IN[36]==1 GOTOF GELOEST1
N198 GOTOB WZLOESEN1

N199 GELOEST1:
N200 G153 Z=Z_ACHSE_ZANGENMASS+2

N201 WZLOESEN11:
N202 IF $A_IN[36]==1 GOTOF GELOEST11
N203 GOTOB WZLOESEN11

N204 GELOEST11:
N205 G153 Z=Z_ACHSE_ZANGENMASS+10 
N206 M74           ;WZ abblasen ein
N207 G153 Z=Z_ACHSE_HUB
N208 MSG("WERKZEUG WIRD ABGEHOLT")
;N830 MSG("PICK UP A TOOL")
;N830 MSG("OUTIL VAT ETRE PRIS")
;N830 MSG("WERKTUIG WORDT AFGEHAALD")
;N830 MSG("BUSCAR HERRAMIENTA")
;N830 MSG ("NARZEDZIE ZOSTAJE POBRANE Z MAGAZYNKA")
N209 H85           ;Drehen auf Position neues Werkzeug
N210 STOPRE
;N850 G4 F0.1
N211 G153 D0 Z=Z_ACHSE_ZANGENMASS+6
N212 M75           ;WZ abblasen aus
N213 STOPRE
N214 G153 D0 Z=Z_ACHSE_ZANGENMASS-0.1
N215 STOPRE
N216 H73           ;Werkzeug spannen
N217 STOPRE

N218 WZSPANNEN1:
N219 IF $A_IN[35]==1 GOTOF GESPANNT1
N220 GOTOB WZSPANNEN1

N221 GESPANNT1:
N222  G153 Y=Y_ACHSE_ZANGENMASS-600
N223 STOPRE
N224 M97
N225 GOTOF MOTORANLASSEN
;----------------------------------------------------------------

N226 NURABLEGEN:
N227 G0 G90 G153 D0 Z=Z_ACHSE_HUB S0 M86
N228 G153 B0 C0
N229 MSG("WERKZEUG WIRD ABGELEGT")
;N1010 MSG("BRING BACK A TOOL")
;N1010 MSG("OUTIL VAT ETRE DEPOSE")
;N1010 MSG("WERKTUIG WORDT WEGGEZET")
;N1010 MSG("NARZEDZIE ZOSTAJE ODDANE DO MAGAZYNKA")
;N1010 MSG("DEPONER HERRAMIENTA")
N230 H84        ;Drehen auf Ablegeposition
N231 STOPRE
N232 G4 F0.1

N233 LS_BELEGT2:
N234 H71        ;Abfrage Werkzeugplatz frei
N235 IF $A_IN[37]==1 GOTOF LS_FREI2
N236 GOTOB LS_BELEGT2

N237 LS_FREI2:
N238 STOPRE

N239 IF $AA_IM[Y]<(Y_ACHSE_ZANGENMASS-450) GOTOF FREI_3
N240 G153 Y=Y_ACHSE_ZANGENMASS-450
N241 STOPRE
N242 M98
N243 GOTOF FREI_4
N244 ENDIF

N245 FREI_3:
N246 G153 Y=Y_ACHSE_ZANGENMASS-450 M98
N247 STOPRE

N248 FREI_4:

N249  WHILE $A_IN[30]==0 
N250   G4F1
N251  ENDWHILE
N252 STOPRE


N253 G153  Z=Z_ACHSE_ZANGENMASS
N254  G153 Y=Y_ACHSE_ZANGENMASS
N255 STOPRE
N256 H72         ;Werkzeug loesen

N257 WZLOESEN2:
N258 IF $A_IN[36]==1 GOTOF GELOEST2
N259 GOTOB WZLOESEN2

N260 GELOEST2:
N261  G153 Z=Z_ACHSE_ZANGENMASS+2

N262 WZLOESEN12:
N263 IF $A_IN[36]==1 GOTOF GELOEST12
N264 GOTOB WZLOESEN12

N265 GELOEST12:
N266 G153 Z=Z_ACHSE_HUB
N267 H73          ;Futter schliessen
N268 STOPRE
N269  G153 Y=Y_ACHSE_ZANGEFREI-200
N270 M97
N271 GOTOF ENDE
;----------------------------------------------------------------

N272 MOTORANLASSEN:
N273 IF (DRR==0) AND (DRZ==0)
N274 GOTOF ENDE
N275 ELSE
N276    IF (DRR<>3) AND (DRR<>4)
N277     GOTOF FEHLER
N278     ELSE
N279      GOTOF OK1
N280         ENDIF
N281 ENDIF

N282 OK1:
N283 M=DRR S=DRZ
N284 DRR=0  DRZ=0
;N1360 G153 Y=Y_ACHSE_ZANGEFREI
;N1370 G4 F.1
N285 G153 Z=Z_ACHSE_HUB
N286 R959=R959+1
N287 GOTOF ENDE
;----------------------------------------------------------------

N288 SOLLISTGLEICH:
N289 IF (DRR==0) AND (DRZ==0)
N290 GOTOF ENDE_SOLLIST
N291 ELSE
N292    IF (DRR<>3) AND (DRR<>4)
N293 GOTOF FEHLER
N294    ELSE
N295       GOTOF OK2
N296    ENDIF
N297 ENDIF

N298 OK2:
N299 M=DRR S=DRZ
N300 DRR=0 DRZ=0
N301 GOTOF ENDE_SOLLIST

N302 ENDE_SOLLIST:
N303 H77            ;Unterprogramm beendet
N304 G153 G0 D0 Z=Z_ACHSE_HUB
N305 MSG("")
N306 STOPRE
N307 T=TNR
N308 M17

N309 FEHLER:
N310 MSG("DRR<>3 oder 4, Taste RESET druecken")
;N1600 MSG("DRR<>3 or 4, press button RESET")
;N1600 MSG("DRR<>3 ou 4, appuyer le bouton RESET")
;N1600 MSG("DRR<>3 of 4, toets RESET drukken")
;N1600 MSG("DRR<>3 o 4, pulsar button RESET")
;N1600 MSG("DRR<>3 o 4, przycisk RESET nacisnac")
N311 G4 F2
N312 GOTOB FEHLER

N313 ENTNEHMEN:
N314 MSG("WERKZEUG AUS SPINDEL NEHMEN - ABBRUCH")
;N1630 MSG("REMOVE TOOL - CANCEL")
;N1630 MSG("SORTIR OUTIL DE LA BROCHE - INTERROMPRE")
;N1630 MSG("WERKTUIG UIT SPINDEL NEMEN - ONDERBROKE")
;N1630 MSG("SACAR HERRAMIENTA DEL MOTOR DE FRESAR-INTERRUPCION")
;N1630 MSG("NARZEDZIE Z WRZECIONA WYAC - PRZERWIG")
N315 STOPRE
N316 GOTOB ENTNEHMEN

N317 ENDE:

;Bei Bedarf Schmieren:
N318 IF $A_IN[1]==0 GOTOF NSCHMIER
N319  G153 Z=Z_ACHSE_HUB
N320  G153 Y=Y_SCHMIERPOS
N321  MSG("Bitte warten, Schmierung aktiv !!")
N322  G4F5
N323  STOPRE
N324  WHILE $A_IN[2]==1 
N325   G4F1
N326  ENDWHILE
N327  G153 Y=Y_ACHSE_ZANGEFREI
N328 ENDIF
N329 NSCHMIER:

N330 H77            ;Unterprogramm beendet
N331 G153 G0 D0 Z=Z_ACHSE_HUB
N332 R990=R990+1
N333 MSG("")
N334 STOPRE
N335 T=TNR
N336 M17

N337 OHNE_SIM:
N338 STOPRE
N339 T=TNR
N340 M17


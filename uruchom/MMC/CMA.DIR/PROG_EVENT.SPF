PROC PROG_EVENT SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.03.03 Sep 20, 2002
DEF INT _TCI,_G0
DEF AXIS _AX
DEF REAL _A1_S,_A2_S
IF($P_PROG_EVENT==5)
IF(ISFILE("/_N_CST_DIR/_N_E_S_ASUP_SPF"))
IF(E_MD9703)AND(E_MD9653==2)
_E_RETP[0]=$AC_RETPOINT[AXNAME($MC_AXCONF_CHANAX_NAME_TAB[E_MD9703-1])]
ENDIF
IF(E_MD9704)AND(E_MD9720==2)
_E_RETP[1]=$AC_RETPOINT[AXNAME($MC_AXCONF_CHANAX_NAME_TAB[E_MD9704-1])]
ENDIF
N10 E_S_ASUP
ENDIF
IF(ISFILE("/_N_CST_DIR/_N_F_S_ASUP_SPF"))
IF(E_MD9803)
_F_RETP[0]=$AC_RETPOINT[AXNAME($MC_AXCONF_CHANAX_NAME_TAB[E_MD9803-1])]
ENDIF
IF(E_MD9807)
_F_RETP[1]=$AC_RETPOINT[_F_S_AX[0]]
ENDIF
IF(_F_S_NR[2])
_F_RETP[2]=$AC_RETPOINT[_F_S_AX[2]]
ENDIF
N20 F_S_ASUP
ENDIF
IF(ISFILE("/_N_CST_DIR/_N_CYCPE_SC_SPF"))
_TCI=$P_TC
IF _TCI>0
_G0=$P_GG[1]
IF(_TC_ST==20)OR(_TC_ST==22)OR(_TC_ST==30)OR(_TC_ST==32)
_AX=AXNAME($TC_CARR35[_TCI])
_A1_S=$AC_RETPOINT[_AX]
IF($MA_ROT_IS_MODULO[_AX])
_A1_S=((_A1_S MOD $MA_MODULO_RANGE[_AX])+360) MOD $MA_MODULO_RANGE[_AX]
ENDIF
G0 AX[AXNAME($TC_CARR35[_TCI])]=AC(_A1_S)
ENDIF
IF(_TC_ST==20)OR(_TC_ST==21)OR(_TC_ST==25)
_AX=AXNAME($TC_CARR36[_TCI])
_A2_S=$AC_RETPOINT[_AX]
IF($MA_ROT_IS_MODULO[_AX])
_A1_S=((_A1_S MOD $MA_MODULO_RANGE[_AX])+360) MOD $MA_MODULO_RANGE[_AX]
ENDIF
G0 AX[AXNAME($TC_CARR36[_TCI])]=AC(_A2_S)
ENDIF
G[1]=_G0
ENDIF
N30 CYCPE_SC
ENDIF
ENDIF
;
;Call partial program CYCPE_US.SPF to PROG_EVENT.SPF for user.
;CYCPE_US.SPF must loaded be in directory CMA.DIR or CUS.DIR.
IF(ISFILE("/_N_CMA_DIR/_N_CYCPE_US_SPF"))OR(ISFILE("/_N_CUS_DIR/_N_CYCPE_US_SPF"))
N100 CYCPE_US
ENDIF
;
;
;Call partial program CYCPE_MA.SPF to PROG_EVENT.SPF for manufacturers.
;CYCPE_US.SPF must loaded be in directory CMA.DIR.
IF(ISFILE("/_N_CMA_DIR/_N_CYCPE_MA_SPF"))
N110 CYCPE_MA
ENDIF
;
IF($P_PROG_EVENT==5)
N200 REPOSA
ENDIF
M17

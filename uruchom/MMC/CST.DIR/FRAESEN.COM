SUB(VET_TOG)
REG[21]=0
CLRHTX(_V_ET)
IF _V_ET=="G0"
_V_ET="G1"
REG[28]=10
REG[21]=1
ADDHTX(_V_ET,"PGZ.pdf",294,"VARI=1X")
ENDIF
IF REG[21]==0
IF _V_ET=="G1"
_V_ET=$80451
REG[28]=30
REG[21]=1
ADDHTX(_V_ET,"PGZ.pdf",295,"VARI=3X")
ENDIF
ENDIF
IF REG[21]==0
IF _V_ET==$80451
_V_ET="G0"
REG[28]=0
ADDHTX(_V_ET,"PGZ.pdf",293,"VARI=0X")
ENDIF
ENDIF
CALL("AA_STA")
END_SUB
SUB(CDIR_LOAD)
IF CDIR.VLD==1
If CDIR ==0
V_CD=$80448
EndIf
If CDIR ==1
V_CD=$80449
EndIf
IF CDIR==2
V_CD="G2"
EndIf
If CDIR ==3
V_CD="G3"
ENDIF
ELSE
V_CD="G3"
ENDIF
END_SUB
SUB(TOG_CDIR)
REG[21]=0
If V_CD ==$80448
V_CD=$80449
REG[21]=1
EndIf
If REG[21] ==0
If V_CD ==$80449
V_CD="G2"
REG[21]=1
EndIf
Endif
If REG[21] ==0
If V_CD =="G2"
V_CD="G3"
REG[21]=1
EndIf
ENDIF
If REG[21] ==0
If V_CD =="G3"
V_CD=$80448
EndIf
EndIf
END_SUB
SUB(ERM_CDIR)
If V_CD ==$80448
CDIR=0
EndIf
If V_CD ==$80449
CDIR=1
EndIf
If V_CD =="G2"
CDIR=2
EndIf
If V_CD =="G3"
CDIR=3
EndIf
END_SUB

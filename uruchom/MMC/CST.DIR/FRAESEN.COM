_V_ET=$80450
REG[21]=1
ENDIF
ENDIF
IF REG[21]==0
IF _V_ET==$80450
_V_ET=$80451
REG[21]=1
ENDIF
ENDIF
IF REG[21]==0
IF _V_ET==$80451
_V_ET="G1"
REG[21]=1
ENDIF
ENDIF
REG[21]=0
CALL("V_ET")
CALL("P_EHLP")
END_SUB
SUB(AV_TOG)

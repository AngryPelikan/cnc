ELSE
HLP="CN253.bmp"
ENDIF
ELSE
REG[26]=0
_B_MW=$80444
_LENG.min=0
_WID.min=0
IF _V_AV==$80455
HLP="CN25.bmp"
ELSE
HLP="CN252.bmp"
ENDIF
ENDIF
END_SUB
SUB(ET_TOG)
REG[21]=0

SUB(AUSW_TECHNO)
If _TECHNO.VLD==1
If ISNUM(_TECHNO)==1
HM_TECH_ST1=_TECHNO MOD 10
HM_TECH_ST2=_TECHNO - HM_TECH_ST1
HM_TECH_ST2=HM_TECH_ST2 MOD 100
HM_TECH_ST3=_TECHNO - HM_TECH_ST1 - HM_TECH_ST2
HM_TECH_ST3=HM_TECH_ST3 MOD 1000
HM_TV=0
If ((HM_TECH_ST1 < 0) OR (HM_TECH_ST1 > 3))
HM_TECH_ST1=0
HM_TV=1
EndIf
If ((HM_TECH_ST2 < 0) OR (HM_TECH_ST2 > 20))
HM_TECH_ST2=0
HM_TV=1
EndIf
If ((HM_TECH_ST3 < 0) OR (HM_TECH_ST3 > 100))
HM_TECH_ST3=0
HM_TV=1
EndIf
If HM_TV ==1
ERROR=1
_TECHNO=HM_TECH_ST3 + HM_TECH_ST2 +HM_TECH_ST1
WNP("_SC_MASK[1]",_TECHNO)
EndIf
EndIf
Else
HM_TECH_ST1=0
HM_TECH_ST2=10
HM_TECH_ST3=0
EndIf
END_SUB

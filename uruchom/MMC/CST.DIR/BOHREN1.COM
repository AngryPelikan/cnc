SUB(TOG_PIT)
If FOC=="PIT"
HM_TV=0
If MA_A==1
MA_A=2
HM_TV=1
EndIf
If HM_TV==0
If MA_A==2
MA_A=3
HM_TV=1
EndIf
EndIf
If HM_TV==0
If MA_A==3
MA_A=1
EndIf
EndIf
CALL("TEXT_PIT")
If T_AK==0
If MA_A==2
PIT.gt="TPI"
If PIT.VLD==1
PIT=HM_UMI/PIT
EndIf
EndIf
If MA_A==3
If PIT.VLD==1
PIT=HM_UMI/(HM_UMI*PIT)
EndIf
EndIf
If MA_A==1
PIT.gt="PIT"
If PIT.VLD==1
PIT=PIT*HM_UMI
EndIf
EndIf
EndIf
EndIf
END_SUB

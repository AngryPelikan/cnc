PROC HOLES1 (REAL SPCA,REAL SPCO,REAL STA1,REAL FDIS,REAL DBH,INT NUM,INT _VARI,INT _UMODE) SAVE DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.17 Sep 08, 2003
;Lochreihe
DEF AXIS _X,_Y
DEF REAL HH1,HH2,HH3,HH4,HH5,HH6,HH7,_FAK1
DEF INT HZ1,HZ2,HMC,_SPIND,_H8
_X=$P_AXN1 _Y=$P_AXN2 HMC=$P_MC DBH=ABS(DBH) FDIS=ABS(FDIS) NUM=ABS(NUM) HZ1=NUM-1 HH1=COS(STA1) HH2=SIN(STA1)
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
_SPIND=ABS(_VARI) DIV 100
IF ((_SPIND<>2)AND(_SPIND<>0)) GOTOF _FEHL5
IF ((_VARI MOD 100)<>0) GOTOF _FEHL5
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF _FEHL5
IF NUM==0 GOTOF FEHL1 IF HMC==1 GOTOF _MM0
SETAL(62100)
STOPRE
M0
_MM0:HH3=SPCA+FDIS*HH1 HH4=SPCO+FDIS*HH2 HH5=SPCA+(FDIS+HZ1*DBH)*HH1
HH6=SPCO+(FDIS+HZ1*DBH)*HH2 HH7=1
IF SQRT(POT(HH3-$P_EP[_X]*_FAK1)+POT(HH4-$P_EP[_Y]*_FAK1)) <= SQRT(POT(HH5-$P_EP[_X]*_FAK1)+POT(HH6-$P_EP[_Y]*_FAK1)) GOTOF _MM1
HH3=HH5 HH4=HH6 HH7=-1
_MM1:HH5=HH3 HH6=HH4
IF _SPIND==2
SBLOF
ST_CUST(_UMODE)
SBLON
ENDIF
_MM2:G0 G60 AX[_X]=HH3 AX[_Y]=HH4
HZ2=HZ2+1 HH3=HH5+DBH*HZ2*HH7*HH1 HH4=HH6+DBH*HZ2*HH7*HH2
HH3=HH3 HH4=HH4
IF HZ2 < NUM GOTOB _MM2
IF _SPIND==2
SBLOF
ST_CUST(_UMODE+1)
SBLON
ENDIF
RET
FEHL1:STOPRE
SETAL(61103)
RET
_FEHL5:STOPRE
N710 SETAL(61002)
RET
_FEHL12:STOPRE
N711 SETAL(61002)
RET

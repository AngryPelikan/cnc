PROC CYCLE832(REAL _TOL,INT _TOLM) SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.19 Nov 10, 2003
DEF INT _FACTOR=8, _OVL_on=1, _G17_18_19, _GG, _FFW, _NV_akt, _OPC, _NCV, _OPT, _TTYPE[9], _TRAFO_1, _TRAFO_2, _T_run, _ASVS, _IS_C800, _IS_C832T
DEF REAL _OVL, _IPO, _TOLL, _TOLR
DEF AXIS _XX,_YY,_ZZ, _RAX1, _RAX2
_IS_C800=(ISFILE("/_N_CST_DIR/_N_CYCLE800_SPF"))OR(ISFILE("/_N_CUS_DIR/_N_CYCLE800_SPF"))OR(ISFILE("/_N_CMA_DIR/_N_CYCLE800_SPF"))
_IS_C832T=(ISFILE("/_N_CST_DIR/_N_CYC_832T_SPF"))OR(ISFILE("/_N_CUS_DIR/_N_CYC_832T_SPF"))OR(ISFILE("/_N_CMA_DIR/_N_CYC_832T_SPF"))
IF _IS_C832T
CYC_832T(4,_FACTOR,_OVL_on)
IF _FACTOR <=0
_FACTOR=8
ENDIF
IF _OVL_on <0
_OVL_on=1
ENDIF
ENDIF
_OPC=$ON_IPO_FUNCTION_MASK
_OPT=$ON_TRAFO_TYPE_MASK B_AND 'B1'
_NCV=$AN_NCK_VERSION
_G17_18_19=$P_GG[6]
_FFW=$P_GG[24]
_NV_akt=$P_GG[8]
IF(_G17_18_19==1)
_XX=$P_AXN1 _YY=$P_AXN2 _ZZ=$P_AXN3
ELSE
IF(_G17_18_19==2)
_XX=$P_AXN2 _YY=$P_AXN3 _ZZ=$P_AXN1
ELSE
_XX=$P_AXN3 _YY=$P_AXN1 _ZZ=$P_AXN2
ENDIF
ENDIF
_IPO=$MN_IPO_CYCLE_TIME
IF _IPO >= 0.012
_OVL=1.2
ELSE
_OVL=0.012/_IPO
_OVL=(0.2*_OVL)+1
_OVL=ROUND(_OVL*10)/10
ENDIF
IF (NOT $P_SIM) AND (NOT $P_ISTEST)
IF _OVL_on
IF AXSTRING(_XX)<>""
$MA_MAX_ACCEL_OVL_FACTOR[_XX]=_OVL
ENDIF
IF AXSTRING(_YY)<>""
$MA_MAX_ACCEL_OVL_FACTOR[_YY]=_OVL
ENDIF
IF AXSTRING(_ZZ)<>""
$MA_MAX_ACCEL_OVL_FACTOR[_ZZ]=_OVL
ENDIF
ENDIF
ENDIF
IF NOT (_TOLM MOD 10)
IF NOT $P_SUBPAR[1]
_GG=$MC_GCODE_RESET_VALUES[0]
G[1]=_GG
_GG=$MC_GCODE_RESET_VALUES[9]
G[10]=_GG
_GG=$MC_GCODE_RESET_VALUES[11]
G[12]=_GG
_GG=$MC_GCODE_RESET_VALUES[20]
G[21]=_GG
_GG=$MC_GCODE_RESET_VALUES[23]
G[24]=_GG
_GG=$MC_GCODE_RESET_VALUES[29]
IF(_OPC B_AND 'B100')
G[30]=_GG
ENDIF
_TOL=_TOLV[0]
$SC_CONTPREC=0.1
$SC_SMOOTH_CONTUR_TOL=0.05
$SC_COMPRESS_CONTUR_TOL=0.05
IF _OPT
$SC_SMOOTH_ORI_TOL=0.05
$SC_COMPRESS_ORI_TOL=0.05
ENDIF
ENDIF
ENDIF
_TOLL=ABS(_TOL)
_TOLR=ROUND(_TOLL*10000)/10000
IF _TOLR<0.0001
_TOLR=0.0001
ENDIF
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF ($P_GG[13] == 1) OR ($P_GG[13]==3)
_TOLL=_TOLL/$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
_TOLL=ROUND(_TOLL*10000)/10000
IF _TOLL<0.0001
_TOLL=0.0001
ENDIF
_TTYPE[1]=$MC_TRAFO_TYPE_1
_TTYPE[2]=$MC_TRAFO_TYPE_2
_TTYPE[3]=$MC_TRAFO_TYPE_3
_TTYPE[4]=$MC_TRAFO_TYPE_4
_TTYPE[5]=$MC_TRAFO_TYPE_5
_TTYPE[6]=$MC_TRAFO_TYPE_6
_TTYPE[7]=$MC_TRAFO_TYPE_7
_TTYPE[8]=$MC_TRAFO_TYPE_8
FOR _T_run=1 TO 8
IF _TRAFO_2==0
IF (_TTYPE[_T_run]>0) AND (_TTYPE[_T_run]<256) AND (_TRAFO_1>0)
_TRAFO_2=_T_run
ENDIF
IF (_TTYPE[_T_run]>0) AND (_TTYPE[_T_run]<256) AND (_TRAFO_1==0)
_TRAFO_1=_T_run
ENDIF
ENDIF
ENDFOR
CASE (_TRAFO_1) OF 1 GOTOF _mtrafo_1 2 GOTOF _mtrafo_2 3 GOTOF _mtrafo_3 4 GOTOF _mtrafo_4 5 GOTOF _mtrafo_5 6 GOTOF _mtrafo_6 7 GOTOF _mtrafo_7 8 GOTOF _mtrafo_8 DEFAULT GOTOF _mtrafoe
_mcase_2:
_TTYPE[0]=1
CASE (_TRAFO_2) OF 2 GOTOF _mtrafo_2 3 GOTOF _mtrafo_3 4 GOTOF _mtrafo_4 5 GOTOF _mtrafo_5 6 GOTOF _mtrafo_6 7 GOTOF _mtrafo_7 8 GOTOF _mtrafo_8 DEFAULT GOTOF _mtrafoe
_mtrafo_1:
_RAX1=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_1[3]-1])
_RAX2=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_1[4]-1])
GOTOF _mtrafo
_mtrafo_2:
_RAX1=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_2[3]-1])
_RAX2=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_2[4]-1])
GOTOF _mtrafo
_mtrafo_3:
_RAX1=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_3[3]-1])
_RAX2=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_3[4]-1])
GOTOF _mtrafo
_mtrafo_4:
_RAX1=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_4[3]-1])
_RAX2=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_4[4]-1])
GOTOF _mtrafo
_mtrafo_5:
_RAX1=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_5[3]-1])
_RAX2=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_5[4]-1])
GOTOF _mtrafo
_mtrafo_6:
_RAX1=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_6[3]-1])
_RAX2=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_6[4]-1])
GOTOF _mtrafo
_mtrafo_7:
_RAX1=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_7[3]-1])
_RAX2=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_7[4]-1])
GOTOF _mtrafo
_mtrafo_8:
_RAX1=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_8[3]-1])
_RAX2=AXNAME($MC_AXCONF_CHANAX_NAME_TAB[$MC_TRAFO_AXES_IN_8[4]-1])
_mtrafo:
IF (NOT $P_SIM) AND (NOT $P_ISTEST)
IF AXSTRING(_RAX1)<>""
$MA_COMPRESS_POS_TOL[_RAX1]=_TOLR*_FACTOR
ENDIF
IF AXSTRING(_RAX2)<>""
$MA_COMPRESS_POS_TOL[_RAX2]=_TOLR*_FACTOR
ENDIF
IF _OVL_on
$MA_MAX_ACCEL_OVL_FACTOR[_RAX1]=_OVL
$MA_MAX_ACCEL_OVL_FACTOR[_RAX2]=_OVL
ENDIF
ENDIF
IF _TTYPE[0]==0 GOTOB _mcase_2
_mtrafoe:
IF ($P_SUBPAR[1] AND (NOT $P_SUBPAR[2])) OR (NOT $P_SUBPAR[1])
IF (NOT $P_SIM) AND (NOT $P_ISTEST)
IF AXSTRING(_RAX1)<>""
$MA_COMPRESS_POS_TOL[_RAX1]=_TOLR*_FACTOR
ENDIF
IF AXSTRING(_RAX2)<>""
$MA_COMPRESS_POS_TOL[_RAX2]=_TOLR*_FACTOR
ENDIF
REPEAT _R1a _R1e
ENDIF
GOTOF _RET
ENDIF
CASE (_TOLM MOD 1000 DIV 100) OF 1 GOTOF _mt1 2 GOTOF _mt2 DEFAULT GOTOF _mt
_mt1:
IF (_TRAFO_1<>0) AND _OPT
IF $P_TC AND _IS_C800
TCARR=0
PAROTOF
ENDIF
UPATH
IF _TOLT2[0]==""
TRAORI(1)
ELSE
CALL _TOLT2[0]
ENDIF
ELSE
GOTOF _err1
ENDIF
GOTOF _me
_mt2:
IF (_TRAFO_2<>0) AND _OPT
UPATH
IF $P_TC AND _IS_C800
TCARR=0
PAROTOF
ENDIF
IF _TOLT2[1]==""
TRAORI(2)
ELSE
CALL _TOLT2[1]
ENDIF
ELSE
GOTOF _err2
ENDIF
GOTOF _me
_mt: TRAFOOF
_me: G[8]=_NV_akt
IF (_OPC B_AND 'B100')
CASE (_TOLM DIV 100000 MOD 10) OF 0 GOTOF _mc0 1 GOTOF _mc1 2 GOTOF _mc2 DEFAULT GOTOF _mc0
_mc0:
COMPOF
GOTOF _mce
_mc1:
REPEAT _R1a _R1e
COMPCAD
GOTOF _mce
_mc2:
REPEAT _R1a _R1e
COMPCURV
IF (_NCV >= 480000)
$SC_COMPRESS_CONTUR_TOL=_TOLL
IF _OPT
$SC_COMPRESS_ORI_TOL=_TOLR*_FACTOR
ENDIF
ENDIF
GOTOF _mce
_mce:
ELSE
IF (_TOLM DIV 100000 MOD 10)>0 GOTOF _err3
ENDIF
IF (_TOLM DIV 100000 MOD 10)==3
IF (_OPC B_AND 'B10')
IF(_OPC B_AND 'B100')
COMPOF
ENDIF
BSPLINE
ELSE
GOTOF _err4
ENDIF
ENDIF
CASE (_TOLM MOD 100000 DIV 10000) OF 0 GOTOF _mv0 1 GOTOF _mv1 2 GOTOF _mv2 DEFAULT GOTOF _mv0
_mv0:
SOFT
FFWOF
GOTOF _mve
_mv1:
SOFT
FFWON
GOTOF _mve
_mv2:
BRISK
FFWOF
GOTOF _mve
_mve:
CASE (_TOLM MOD 10000 DIV 1000) OF 0 GOTOF _mb0 1 GOTOF _mb1 2 GOTOF _mb2 3 GOTOF _mb3 DEFAULT GOTOF _mb0
_mb0: G64
IF _FFW==1
;CPRECON
$SC_CONTPREC=_TOLL
ELSE
;CPRECOF
ENDIF
GOTOF _mbe
_mb1:
G601 G641 ADIS=_TOLL
IF _FFW==1
;CPRECON
$SC_CONTPREC=_TOLL*3
ELSE
;CPRECOF
ENDIF
GOTOF _mbe
_mb2:
G601 G642 CPRECOF
$SC_SMOOTH_CONTUR_TOL=_TOLL
IF _OPT
$SC_SMOOTH_ORI_TOL=_TOLR*_FACTOR
ENDIF
REPEAT _R1a _R1e
GOTOF _mbe
_mb3:
G601 G643 CPRECOF
REPEAT _R1a _R1e
GOTOF _mbe
_mbe:
IF (NOT $P_SIM) AND (NOT $P_ISTEST)
IF (_NCV >= 200000)
$MC_IGNORE_OVL_FACTOR_FOR_ADIS=1
ENDIF
ENDIF
_RET:
IF _IS_C832T
_ASVS=_TOLM MOD 10
IF ((_ASVS>=0) AND (_ASVS<4))
CYC_832T(_ASVS,_FACTOR,_OVL_on)
ENDIF
ENDIF
STOPRE
NEWCONF
RET
_R1a:
IF (NOT $P_SIM) AND (NOT $P_ISTEST)
IF AXSTRING(_XX)<>""
$MA_COMPRESS_POS_TOL[_XX]=_TOLL
ELSE
GOTOF _err1
ENDIF
IF AXSTRING(_YY)<>""
$MA_COMPRESS_POS_TOL[_YY]=_TOLL
ENDIF
IF AXSTRING(_ZZ)<>""
$MA_COMPRESS_POS_TOL[_ZZ]=_TOLL
ENDIF
ENDIF
_R1e:
_err1: STOPRE
SETAL(61191)
RET
_err2: STOPRE
SETAL(61192)
RET
_err3: STOPRE
SETAL(61193)
RET
_err4: STOPRE
SETAL(61194)
RET

PROC CYCLE90(REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DIATH,REAL KDIAM,REAL PIT,REAL FFR,INT CDIR,INT TYPTH,REAL CPA,REAL CPO) SAVE SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.15 Jun 30, 2002
;Gewindefraesen
DEF REAL WR,ARAD,XWEG,YWEG,RDIF,HRD,HH1,HH2,HH3,HH4,HH5,HH50,HH6,_FAK1,HRDI,_EPS=0.002
DEF INT DNUM,ANZG,RFAK
DEF AXIS _X,_Y,_Z
DEF INT _MIRR=0
DEF BOOL _MDG
IF ($P_SIM==1) AND ($P_TOOL==0)
MSG("$80014")
_MDG=1
ENDIF
_X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 DNUM=$P_TOOL WR=$P_TOOLR DPR=ABS(DPR) SDIS=ABS(SDIS)
IF ((DNUM==0)OR(WR==0)) AND ($P_SIM==0) GOTOF FEHL1
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF CDIR==2
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
WR=WR*_FAK1
IF WR>=KDIAM/2 GOTOF FEHL2
IF(WR<0)GOTOF FEHL4
IF DPR==0 GOTOF _MB1 IF RTP==RFP GOTOF FEHL3
RFAK=(RTP-RFP)/ABS(RTP-RFP) HH2=RFP-RFAK*DPR
IF DP==0 GOTOF _MMA1
IF ABS(DP-HH2)<_EPS GOTOF _MB1
N10 MSG("$80000")
_MDG=1
_MMA1:DP=HH2
_MB1:HH2=RTP-RFP
IF RFP==DP GOTOF _MX8
RFAK=(RFP-DP)/ABS(RFP-DP)
IF ABS(HH2)<_EPS GOTOF _MD1
_MD1:
IF TYPTH==1
ARAD=ABS(DIATH)/2
ELSE
ARAD=ABS(KDIAM)/2
ENDIF
SDIS=SDIS*RFAK HH1=ABS(RFP+SDIS-DP) ANZG=TRUNC(HH1/PIT) HH2=ANZG*PIT
IF ABS(HH2-HH1)<_EPS GOTOF _MH1
ANZG=ANZG+1 SDIS=SDIS+(PIT*ANZG-HH1)*RFAK
_MH1:RDIF=ARAD+WR
IF TYPTH GOTOF _MJ1
RDIF=ARAD-WR
_MJ1:HH3=RDIF/ARAD*FFR HRD=RDIF/2 HH4=PIT/4*(WR+HRD)/ARAD
HH5=CPA+RDIF XWEG=HH5-HRD
IF(TYPTH==0)
HRDI=(RDIF/2+(DIATH-KDIAM)/2)/2
HH4=PIT/2*(WR+(DIATH/2))/DIATH
HH5=CPA+RDIF
XWEG=HH5-RDIF/2
IF(WR>=0.667*(DIATH/2))
HRDI=(2*RDIF+(DIATH-KDIAM)/2)/2
HH4=PIT/2*KDIAM/DIATH
XWEG=CPA-RDIF
ENDIF
HH50=HH5+(DIATH-KDIAM)/2
YWEG=0
RDIF=DIATH/2-WR
ENDIF
HH6=DP-HH4*RFAK
IF (CDIR==2)OR(CDIR==3) GOTOF _ML1
N11 MSG("$80001")
_MDG=1 CDIR=3
_ML1:IF CDIR==2 GOTOF _MN1
HRD=-HRD
_MN1:RDIF=-RDIF YWEG=CPO+HRD
IF(TYPTH==0) ;AND (WR>=(0.667*ARAD))
IF CDIR==2 GOTOF _ML10
HRDI=-HRDI
_ML10:
YWEG=CPO
ENDIF
IF TYPTH GOTOF _MA3
SBLON
N2 G0 G90 G60 G40 AX[_X]=CPA AX[_Y]=CPO
IF ABS($P_EP[_Z]*_FAK1-RTP)>ABS($P_EP[_Z]*_FAK1-RFP+SDIS) GOTOF _MY20
N20 AX[_Z]=RTP
N21 _MY20:G0 AX[_Z]=RFP+SDIS+RFAK*HH4
SBLOF
N22 G1 G64 F=HH3 AX[_X]=XWEG AX[_Y]=YWEG
IF CDIR==2
N23 G2 F=HH3 AX[_X]=HH50 AX[_Y]=CPO AX[_Z]=RFP+SDIS CR=ABS(HRDI)
ELSE
N23 G3 F=HH3 AX[_X]=HH50 AX[_Y]=CPO AX[_Z]=RFP+SDIS CR=ABS(HRDI)
ENDIF
_MB2:IF ANZG<1 GOTOF _MD2
N24 AX[_X]=HH50 AX[_Y]=CPO AX[_Z]=DP IP[_X]=RDIF IP[_Y]=0 TURN=ANZG-1
_MD2:
N25 AX[_X]=XWEG AX[_Y]=CPO AX[_Z]=HH6 CR=ABS(HRDI)
SBLON
N26 G0 G60 AX[_X]=CPA AX[_Y]=CPO
N27 AX[_Z]=RTP
IF _MDG==1
N28 MSG("")
ENDIF
RET
_MA3:HH2=ABS(HRD) HH1=HH5+HH2
SBLON
N3 G0 G90 G60 G40 AX[_X]=HH1 AX[_Y]=CPO+HRD
IF ABS($P_EP[_Z]*_FAK1-RTP)>ABS($P_EP[_Z]*_FAK1-RFP+SDIS) GOTOF _MY30
N30 AX[_Z]=RTP
N31 _MY30:G0 AX[_Z]=RFP+SDIS+RFAK*HH4
SBLOF
IF ANZG<1 GOTOF _MD3 IF CDIR==3 GOTOF _MB3
N33 G3 G64 F=HH3 AX[_X]=HH5 AX[_Y]=CPO AX[_Z]=RFP+SDIS CR=HH2
N34 G2 AX[_X]=HH5 AX[_Y]=CPO AX[_Z]=DP IP[_X]=RDIF IP[_Y]=0 TURN=ANZG-1
SBLON
N35 G3 G60 F=HH3 AX[_X]=HH1 AX[_Y]=CPO+HRD CR=HH2
GOTOF _MD3
N33 _MB3:G2 G64 F=HH3 AX[_X]=HH5 AX[_Y]=CPO AX[_Z]=RFP+SDIS CR=HH2
N34 G3 AX[_X]=HH5 AX[_Y]=CPO AX[_Z]=DP IP[_X]=RDIF IP[_Y]=0 TURN=ANZG-1
SBLON
N35 G2 G60 F=HH3 AX[_X]=HH1 AX[_Y]=CPO+HRD CR=HH2
N37 _MD3:G0 AX[_Z]=RTP
N38 _MX8:
IF _MDG==1
MSG("")
ENDIF
_MX9:RET
FEHLERBEHANDLUNG
FEHL1:STOPRE
SETAL(61000)
RET
FEHL2:STOPRE
SETAL(61105)
RET
FEHL3:STOPRE
SETAL(61101)
RET
FEHL4:STOPRE
SETAL(61112)
RET

PROC CYCLE77(REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _DPR,REAL _PRAD,REAL _PA,REAL _PO,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _CDIR,INT _VARI,REAL _AP1) SAVE SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.02.07 Nov 27, 2001
;Kreiszapfen
DEF STRING[70] _KNAME
DEF AXIS _XX,_YY,_ZZ
DEF INT _M3_5,_FRK,_AS1,_AS2,_BA1,_DIR,_PMZ,_INI=1,_ZSD3
DEF REAL _LP1,_LP2,_A0=0
DEF REAL _X0,_Y0
DEF REAL _MIRR=0
_XX=$P_AXN1 _YY=$P_AXN2 _ZZ=$P_AXN3
_X0=_PA
_Y0=_PO
IF(_DPR>0)
_DP=_RFP-_DPR
ENDIF
_MIRR=$P_ACTFRAME[_XX,MI]+$P_ACTFRAME[_YY,MI]
IF(_MIRR==1)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF(_RFP<_DP)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_ACTFRAME[_ZZ,MI])
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF(_PRAD<=0)OR(_AP1<0) GOTOF _FEHL3
IF((_AP1<>0) AND (_AP1<_PRAD)) GOTOF _FEHL4
IF($P_TOOLR<0) GOTOF _FEHL5
_BA1=0
IF(_VARI B_AND 'B00000001')
_BA1=1
ENDIF
IF(_VARI B_AND 'B00000010')
_BA1=_BA1+2
ENDIF
IF(_BA1<1)OR(_BA1>2) GOTOF _FEHL1
IF(_BA1==1)AND(_MID<0) GOTOF _FEHL6
_VARI=_BA1+300
_M3_5=$P_SDIR[$P_MSNUM]
IF(_CDIR==0)
IF(_M3_5==4)
_DIR=3 _FRK=42
ELSE
_DIR=2 _FRK=41
ENDIF
ENDIF
IF(_CDIR==1)
IF(_M3_5==4)
_DIR=2 _FRK=41
ELSE
_DIR=3 _FRK=42
ENDIF
ENDIF
IF(_CDIR==2)
_DIR=2 _FRK=41
ENDIF
IF(_CDIR==3)
_DIR=3 _FRK=42
ENDIF
_AS1=3 _AS2=3
IF(_BA1==1)
_LP1=((_AP1-_PRAD)/2-_FAL+_SDIS)/2
ELSE
_LP1=(_FAL+_SDIS)/2
ENDIF
_LP2=_LP1
IF _BA1==1
_PA=_PA+COS(_A0)*(_PRAD/2+_FAL) _PO=_PO+SIN(_A0)*(_PRAD/2+_FAL)
_FAL=0
ELSE
_PA=_PA+COS(_A0)*_PRAD/2 _PO=_PO+SIN(_A0)*_PRAD/2
ENDIF
_KNAME="_E_SP_CIR_ANF:_E_SP_CIR_END"
_CONT2[0]=_PA _CONT2[1]=_PO _CONT2[2]=_X0 _CONT2[3]=_Y0
_CONT2[4]=_DIR
N30 CYCLE72(_KNAME,_RTP,_RFP,_SDIS,_DP,_MID,_FAL,_FALD,_FFP1,_FFD,_VARI,_FRK,_AS1,_LP1,_FFD,_AS2,_LP2)
_RET:
RET
_FEHL1: STOPRE
SETAL(61002)
RET
_FEHL3: STOPRE
SETAL(61213)
RET
_FEHL4: STOPRE
SETAL(61215)
RET
_FEHL5: STOPRE
SETAL(61112)
RET
_FEHL6: STOPRE
SETAL(61610)
RET
_E_SP_CIR_ANF:
IF(_CONT2[4]==2)
N20 G01 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
N22 G02 IP[$P_AXN1]=AC(_CONT2[2]) IP[$P_AXN2]=AC(_CONT2[3])
ELSE
N30 G01 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
N32 G03 IP[$P_AXN1]=AC(_CONT2[2]) IP[$P_AXN2]=AC(_CONT2[3])
ENDIF
_E_SP_CIR_END:
RET

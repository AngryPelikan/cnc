REG[13] = 1
REG[14] = 0
EndIf
If HILF == 2
REG[13] = 1
REG[14] = 1
EndIf
HILF=(REG[2] / 10000) MOD 10
REG[15] = HILF
HILF=(REG[2] / 100000) MOD 10
REG[16] = HILF

REG[18] = 0
REG[19] = 0
EndIf
If HILF == 1
REG[18] = 1
REG[19] = 0
EndIf
If HILF == 2
REG[18] = 0
REG[19] = 1
EndIf
If HILF == 3
REG[18] = 1
REG[19] = 1
EndIf
END_SUB

SUB(AUSW_ST)
REG[2]=_ST
INDEX_TRANSSTAT = REG[2] MOD 10
If INDEX_TRANSSTAT == 0
TRANSSTAT = $82020
Else
TRANSSTAT = $82021
EndIf
INDEX_NACHWZ = (REG[2] / 10) MOD 10
If INDEX_NACHWZ == 0
NACHWZ = $82023
Else
NACHWZ = $82022
EndIf
If REG[25]==0
If REG[15]==0
NACHWZ.wr=0
NACHWZ.st=""
EndIf
EndIf
INDEX_ANSTWZ = (REG[2] / 100) MOD 10
If INDEX_ANSTWZ == 0
Else
EndIf
END_SUB
SUB(AUSW_MODE)
REG[2]=_MODE
INDEX_DREHW_A = (REG[2] BAND 'B00000011')-1
INDEX_DREHW_B = ((REG[2] BAND 'B00001100')/4)-1
INDEX_DREHW_C = ((REG[2] BAND 'B00110000')/16)-1
INDEX_SCHWMOD = (REG[2] BAND 'B11000000')/64
DEBUG("REG10:" <<REG[10])
If INDEX_SCHWMOD == 1
SCHWMOD = $82036
SCHWMOD.hlp = "cn800_10.bmp"
EndIf
If INDEX_SCHWMOD == 2
SCHWMOD = $82034
SCHWMOD.hlp = "cn800_11.bmp"
EndIf
If INDEX_SCHWMOD == 0
SCHWMOD = $82035
SCHWMOD.hlp = "cn800_9.bmp"
EndIf
If HLP <> SCHWMOD.hlp
HLP = SCHWMOD.hlp
EndIf
If INDEX_SCHWMOD == 0
BEZ_A.wr = 2
BEZ_B.wr = 2
_C.wr = 2
If INDEX_DREHW_A == 0
BEZ_A = $82100
EndIf
If INDEX_DREHW_A == 1
BEZ_A = $82099
EndIf
If INDEX_DREHW_A == 2
BEZ_A = $82101
EndIf
If INDEX_DREHW_B == 0
BEZ_B = $82100
EndIf
If INDEX_DREHW_B == 1
BEZ_B = $82099
EndIf
If INDEX_DREHW_B == 2
BEZ_B = $82101
EndIf
If INDEX_DREHW_C == 0
BEZ_C = $82100
EndIf
If INDEX_DREHW_C == 1
BEZ_C = $82099
EndIf
If INDEX_DREHW_C == 2
BEZ_C = $82101
EndIf
EndIf
If INDEX_SCHWMOD == 1
BEZ_A = $82029
BEZ_A.wr = 1
INDEX_DREHW_A = 0
BEZ_B = $82030
BEZ_B.wr = 1
INDEX_DREHW_B = 1
BEZ_C = ""
_C.wr = 0
DREH2.st=""
INDEX_DREHW_B = 2
EndIf
If INDEX_SCHWMOD == 2
BEZ_A.wr = 2
BEZ_B.wr = 2
_C.wr = 2
If INDEX_DREHW_A == 0
BEZ_A = $82027<<$82029
EndIf
If INDEX_DREHW_A == 1
BEZ_A = $82026<<$82029
EndIf
If INDEX_DREHW_A == 2
BEZ_A = $82028<<$82029
EndIf
If INDEX_DREHW_B == 0
BEZ_B = $82027<<$82029
EndIf
If INDEX_DREHW_B == 1
BEZ_B = $82026<<$82029
EndIf
If INDEX_DREHW_B == 2
BEZ_B = $82028<<$82029
EndIf
If INDEX_DREHW_C == 0
BEZ_C = $82027<<$82030
EndIf
If INDEX_DREHW_C == 1
BEZ_C = $82026<<$82030
EndIf
If INDEX_DREHW_C == 2
BEZ_C = $82028<<$82030
EndIf
EndIf
If REG[10] ==0
If REG[20] ==0
SCHWMOD.wr=1
EndIf
EndIf
END_SUB
SUB(AUSW_INDEX_FRMOD)
DEBUG("INDEX_FRMOD: "<<INDEX_FRMOD)
If INDEX_FRMOD == 0
FRMOD = $82023
EndIf
If INDEX_FRMOD == 1
FRMOD = $82031
EndIf
If INDEX_FRMOD == 2
FRMOD = $82032
EndIf
END_SUB
SUB(AUSW_INDEX_DIR)
If INDEX_DIR == 1
DIR = $82092
SCHW_JN=$82022
EndIf
If INDEX_DIR == -1
DIR = $82093
SCHW_JN=$82022
EndIf
If INDEX_DIR == 0
SCHW_JN=$82023
EndIf
If REG[23]==0
If REG[13]==0
DIR.wr=0
DIR.st=""
EndIf
EndIf
END_SUB
SUB(ANZ_RUECK)
If REG[13] == 0
DIR.wr=0
DIR.st=""
Else
DIR.wr=2
DIR.st=$82017
EndIf
If REG[15] == 0
NACHWZ.wr=0
NACHWZ.st=""
Else
NACHWZ.wr=2
NACHWZ.st=$82018
EndIf
END_SUB

Else
NRCH=NRCH-1
EndIf
EndIf
If NRCH==8
SWDSNAME=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
RETURN
Else
NRCH=NRCH-1
EndIf
EndIf
If NRCH==7
SWDSNAME=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
RETURN
Else
NRCH=NRCH-1
EndIf
EndIf
If NRCH==6
SWDSNAME=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
RETURN
Else
NRCH=NRCH-1
EndIf
EndIf
If NRCH==5
SWDSNAME=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
RETURN
Else
NRCH=NRCH-1
EndIf
EndIf
If NRCH==4
SWDSNAME=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
RETURN
Else
NRCH=NRCH-1
EndIf
EndIf
If NRCH==3
SWDSNAME=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
RETURN
Else
NRCH=NRCH-1
EndIf
EndIf
If NRCH==2
SWDSNAME=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
RETURN
Else
NRCH=NRCH-1
EndIf
EndIf
If NRCH==1
SWDSNAME=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
RETURN
Else
NRCH=NRCH
EndIf
EndIf
SUCH=0
END_SUB
SUB(ERM_ANZDATS)
HM_ADAT=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==1
If NRSDS==1
ANZ_DATS_PRO_CH=0
RETURN
Else
NRSDS=1
HM_ADAT=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==1
ANZ_DATS_PRO_CH=0
RETURN
EndIf
EndIf
Else
ANZ_DATS_PRO_CH=1
EndIf
NRSDS=NRSDS+1
HM_ADAT=RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
If ERR==0
ANZ_DATS_PRO_CH=2
EndIf
NRSDS=NRSDS-1
END_SUB
SUB(LOAD_NAME)
SWDSNAME = RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
IF SWDSNAME == ""
ENDIF
RETURN
END_SUB
SUB(ANZ_OPT_DECO)
REG[2]=0
REG[2] = RNP("/Tool/Toolcarrier/tcCarr37[u"<< NRCH <<"," << NRSDS << "]")
HILF.VLD=0
REG[6]=0
REG[10]=REG[2] MOD 10
If REG[10] < 0 OR REG[10] > 2
REG[10]=0
REG[6]=1
EndIf
HILF=(REG[2] / 10) MOD 10
REG[11] = HILF
If REG[11] < 0 OR REG[11] > 2
REG[11]=0
REG[6]=1
EndIf
HILF=(REG[2] / 100) MOD 10
REG[12] = HILF
If REG[12] < 0 OR REG[12] > 2
REG[12]=0
REG[6]=1
EndIf
HILF=(REG[2] / 1000) MOD 10
If HILF < 0 OR HILF > 2
HILF=0
REG[6]=1
EndIf
IF HILF == 0
REG[13] = 0
REG[14] = 0
ENDIF
IF HILF == 1
REG[13] = 1
REG[14] = 0
ENDIF
IF HILF == 2
REG[13] = 1
REG[14] = 1
ENDIF
HILF=(REG[2] / 10000) MOD 10
REG[15] = HILF
If REG[15] < 0 OR REG[15] > 1
REG[15]=0
REG[6]=1
EndIf
HILF=(REG[2] / 100000) MOD 10
REG[16] = HILF
HILF=(REG[2] / 1000000) MOD 10
REG[17] = HILF
If REG[17] < 1 OR REG[17] > 1
REG[17]=0
REG[6]=1
Endif
HILF=(REG[2] / 10000000) MOD 10
If HILF < 0 OR HILF > 3
HILF=0
EndIf
IF HILF == 0
REG[18] = 0
REG[19] = 0
ENDIF
HILF=(REG[2] / 100000000) MOD 10
REG[20]=HILF
If REG[20] < 0 OR REG[20] > 5
REG[20]=0
REG[6]=1
EndIf
If REG[6] ==1
CALL("ANZ_OPT_RECH")
DEBUG("REG[2]: "<<REG[2])
EndIf
END_SUB
SUB(SET_SFKEYS)
IF ANZ_CHANNELS > 1
VS1.st=$82075
VS1.se=1
VS2.st=$82076
VS2.se=1
ELSE
VS1.st=""
VS1.se=2
VS2.st=""
VS2.se=2
ENDIF
IF ANZ_DATS_PRO_CH > 1
VS3.st=$82078
VS3.se=1
VS4.st=$82077
VS4.se=1
A_NRSDS.wr=2
ELSE
VS3.st=""
VS3.se=2
VS4.st=""
VS4.se=2
A_NRSDS.wr=1
ENDIF
VS5.se=1
END_SUB
SUB(ANZ_OPT_RECH)
REG[2] = 0
REG[2] = REG[2] + REG[10]
REG[2] = REG[2] + REG[11]*10
REG[2] = REG[2] + REG[12]*100
IF REG[13] == 1
REG[2] = REG[2] + (REG[13]+REG[14])*1000
ENDIF
REG[2] = REG[2] + REG[15] * 10000
REG[2] = REG[2] + REG[16] * 100000
REG[2] = REG[2] + REG[17] * 1000000
REG[3]=0
REG[2] = REG[2] + (REG[3]+REG[18])*10000000
HILF=REG[20]*100000000
REG[2]=REG[2]+HILF
WNP("/Tool/Toolcarrier/tcCarr37[u"<< NRCH <<"," << NRSDS << "]",REG[2])
END_SUB
SUB(LESEN_KIN)
INDEX_KINEM = RNP("/Tool/Toolcarrier/tcCarr23[u"<< NRCH <<","<< NRSDS <<"]")
IF INDEX_KINEM == "T"
SWKINEM = $82051
ENDIF
IF INDEX_KINEM == "P"
SWKINEM = $82052
ENDIF
IF INDEX_KINEM == "M"
SWKINEM = $82050
ENDIF
RETURN
END_SUB
//END
//B(UPS_2)
SUB(ANW_DS_WZ)
DEBUG("REG[20]: "<<REG[20])
If REG[20] < 3
WZW=$82065
If REG[20] ==0
SWDATWE=$82023
WZW_T.wr=0
WZW.wr=0
EndIf
If REG[20] ==1
SWDATWE=$82064
EndIf
If REG[20] ==2
SWDATWE=$82065
EndIf
Else
WZW=$82064
If REG[20] ==3
SWDATWE=$82023
WZW_T.wr=0
WZW.wr=0
EndIf
If REG[20] ==4
SWDATWE=$82064
EndIf
If REG[20] ==5
SWDATWE=$82065
EndIf
EndIf
If SWKINEM ==$82052
WZW_T.wr=0
WZW_T.st=""
WZW.wr=0
Else
If SWDATWE <> $82023
WZW_T.wr=1
WZW_T=$82117
WZW.wr=2
EndIf
EndIf
END_SUB
SUB(ERM_DS_WZ)
If WZW ==$82065
If SWDATWE ==$82023
REG[20]=0
EndIf
If SWDATWE ==$82064
REG[20]=1
EndIf
If SWDATWE ==$82065
REG[20]=2
EndIf
Else
If SWDATWE ==$82023
REG[20]=3
EndIf
If SWDATWE ==$82064
REG[20]=4
EndIf
If SWDATWE ==$82065
REG[20]=5
EndIf
EndIf
END_SUB
SUB(CHECK_2)
REG[1]=0
IF INIT_2 ==0
IF EVAL(REG[0]) < -360
REG[1]=1
DLGL($80593<<REG[22])
RETURN
ENDIF
IF EVAL(REG[0]) > 360
REG[1]=1
DLGL($80593<<REG[22])
RETURN
ENDIF
ENDIF
RETURN
END_SUB
SUB(HIRTH_1)
IF INDEX_SWDRA1HI == 0
SWDRA1HI = $82023
SWDRA1WOFF=0.0
SWDRA1WOFF.st = ""
SWDRA1WOFF.wr = 0
SWDRA1WR=0.0
SWDRA1WR.st = ""
SWDRA1WR.ut = ""
SWDRA1WR.wr = 0
REG[18] = 0
CALL("ANZ_OPT_RECH")
ELSE
SWDRA1HI = $82022
SWDRA1WOFF.st = $82081
SWDRA1WOFF.ut = $82012
SWDRA1WOFF.wr = 2
SWDRA1WR.st = $82082
SWDRA1WR.ut = $82012
SWDRA1WR.wr = 2
SWDRA1WR_L.wr = 1
END_SUB
SUB(HIRTH_2)
IF INDEX_SWDRA2HI == 0
SWDRA2HI = $82023
SWDRA2WOFF = 0.0
SWDRA2WOFF.st = ""
SWDRA2WOFF.wr = 0
SWDRA2WR = 0.0
SWDRA2WR.st = ""
SWDRA2WR.ut = ""
SWDRA2WR.wr = 0
REG[19] = 0
CALL("ANZ_OPT_RECH")
ELSE
SWDRA2HI = $82022
SWDRA2WOFF.st = $82081
SWDRA2WOFF.ut = $82012
SWDRA2WOFF.wr = 2
SWDRA2WR.st = $82082
SWDRA2WR.ut = $82012
SWDRA2WR.wr = 2
SWDRA2WR_L.wr = 1
END_SUB
SUB(INITIALISIERUNG_2)
INIT_2 = 1
SWDRA1BEZ = RNP("/Tool/Toolcarrier/tcCarr35[u"<< NRCH <<"," << NRSDS << "]")
SWDRA1WBMIN = RNP("/Tool/Toolcarrier/tcCarr30[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA1WBMAX = RNP("/Tool/Toolcarrier/tcCarr32[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA1WOFF = RNP("/Tool/Toolcarrier/tcCarr26[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA1WR = RNP("/Tool/Toolcarrier/tcCarr28[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA1AK = RNP("/Tool/Toolcarrier/tcCarr24[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA2BEZ = RNP("/Tool/Toolcarrier/tcCarr36[u"<< NRCH <<"," << NRSDS << "]")
SWDRA2WBMIN = RNP("/Tool/Toolcarrier/tcCarr31[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA2WBMAX = RNP("/Tool/Toolcarrier/tcCarr33[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA2WOFF = RNP("/Tool/Toolcarrier/tcCarr27[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA2WR = RNP("/Tool/Toolcarrier/tcCarr29[u"<< NRCH <<","<< NRSDS <<"]")
SWDRA2AK = RNP("/Tool/Toolcarrier/tcCarr25[u"<< NRCH <<","<< NRSDS <<"]")
CALL("ANZ_OPT_DECO")
CALL("ANW_DS_WZ")
IF REG[11] == 1
SWDRA1MOD = $82064
ELSE
If REG[11] ==0
SWDRA1MOD = $82065
Else
SWDRA1MOD = $82220
EndIf
ENDIF
IF REG[12] == 1
SWDRA2MOD = $82064
ELSE
If REG[12] ==0
SWDRA2MOD = $82065
Else
SWDRA2MOD = $82220
EndIf
ENDIF
IF SWDRA1WR == 0.0
INDEX_SWDRA1HI = 0
ELSE
INDEX_SWDRA1HI = 1
ENDIF
IF SWDRA2WR == 0.0
INDEX_SWDRA2HI = 0
ELSE
INDEX_SWDRA2HI = 1
ENDIF
CALL("HIRTH_1")
CALL("HIRTH_2")
IF ANZ_DATS_PRO_CH > 1
SWDSNAME = RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]")
IF SWDSNAME == ""
WNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<"," << NRSDS << "]",SWDSNAME)
ENDIF
ELSE
SWDSNAME = RNP("/Tool/Toolcarrier/tcCarr34[u"<< NRCH <<","<< 1 <<"]")
ENDIF
INIT_2 = 0
RETURN
END_SUB
//END

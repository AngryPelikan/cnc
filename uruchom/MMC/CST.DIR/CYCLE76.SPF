PROC CYCLE76(REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _DPR,REAL _LENG,REAL _WID,REAL _CRAD,REAL _PA,REAL _PO,REAL _STA,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _CDIR,INT _VARI,REAL _AP1,REAL _AP2) SAVE SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.02.07 Nov 27, 2001
;Rechteckzapfen
DEF STRING[70] _KNAME
DEF AXIS _XX,_YY,_ZZ
DEF INT _AS1,_AS2,_BA1,_DIR,_FRK,_M3_5,_PMZ,_INI=1,_ZSD3
DEF REAL _FAK1,_FAK2,_LP1,_LP2,_RP,_SC,_SD,_SD1,_SD2,_TX,_TY,_XREF,_YREF
DEF REAL _ZREF
DEF REAL _MIRR=0
_XX=$P_AXN1 _YY=$P_AXN2 _ZZ=$P_AXN3
IF(_DPR>0)
_DP=_RFP-_DPR
ENDIF
_MIRR=$P_ACTFRAME[_XX,MI]+$P_ACTFRAME[_YY,MI]
IF(_MIRR==1)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF(_RFP<_DP)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_ACTFRAME[_ZZ,MI])
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_TOOLR<0) GOTOF _FEHL5
_BA1=0
IF(_VARI B_AND 'B00000001')
_BA1=1
ENDIF
IF(_VARI B_AND 'B00000010')
_BA1=_BA1+2
ENDIF
IF(_BA1<1)OR(_BA1>2) GOTOF _FEHL1
IF(_BA1==1)AND(_MID<0) GOTOF _FEHL6
_VARI=_BA1+300
_M3_5=$P_SDIR[$P_MSNUM]
IF(_CDIR==0)
IF(_M3_5==4)
_DIR=3 _FRK=42
ELSE
_DIR=2 _FRK=41
ENDIF
ENDIF
IF(_CDIR==1)
IF(_M3_5==4)
_DIR=2 _FRK=41
ELSE
_DIR=3 _FRK=42
ENDIF
ENDIF
IF(_CDIR==2)
_DIR=2 _FRK=41
ENDIF
IF(_CDIR==3)
_DIR=3 _FRK=42
ENDIF
IF _ZSD[2]==1
_TX=_LENG/2 _TY=_WID/2
ELSE
_TX=0 _TY=0
ENDIF
_LENG=ABS(_LENG) _WID=ABS(_WID)
_AS1=3 _AS2=3
IF(_BA1==1)
_LP1=((_AP1-_LENG)/2-_FAL+_SDIS)/2
ELSE
_LP1=(_FAL+_SDIS)/2
ENDIF
_LP2=_LP1
_KNAME="_E_SP_REC_ANF:_E_SP_REC_END"
IF _BA1==1
_CONT2[0]=_LENG/2+_FAL _CONT2[1]=0
_CONT2[2]=_LENG/2+_FAL _CONT2[3]=_WID/2+_FAL
_CONT2[4]=_CRAD+_FAL
_FAL=0
ELSE
_CONT2[0]=_LENG/2 _CONT2[1]=0
_CONT2[2]=_LENG/2 _CONT2[3]=_WID/2
_CONT2[4]=_CRAD
ENDIF
_CONT2[5]=_LENG/2-_CRAD _CONT2[6]=_WID/2-_CRAD
_CONT2[7]=_DIR
ATRANS AX[_XX]=_PA AX[_YY]=_PO
AROT RPL=_STA
ATRANS AX[_XX]=_TX AX[_YY]=_TY
N30 CYCLE72(_KNAME,_RTP,_RFP,_SDIS,_DP,_MID,_FAL,_FALD,_FFP1,_FFD,_VARI,_FRK,_AS1,_LP1,_FFD,_AS2,_LP2)
ATRANS AX[_XX]=-_TX AX[_YY]=-_TY
AROT RPL=-_STA
ATRANS AX[_XX]=-_PA AX[_YY]=-_PO
_RET:
RET
_FEHL1: STOPRE
SETAL(61002)
RET
_FEHL5: STOPRE
SETAL(61112)
RET
_FEHL6: STOPRE
SETAL(61610)
RET
_E_SP_REC_ANF:
IF(_CONT2[7]==2)
N100 G1 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
IF(_CONT2[6]>0)
N105 AX[$P_AXN2]=-_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N110 G2 AX[$P_AXN1]=_CONT2[5] AX[$P_AXN2]=-_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N115 G1 AX[$P_AXN1]=-_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N120 G2 AX[$P_AXN1]=-_CONT2[2] AX[$P_AXN2]=-_CONT2[6] CR=_CONT2[4]
ENDIF
IF(_CONT2[6]>0)
N130 G1 AX[$P_AXN2]=_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N135 G2 AX[$P_AXN1]=-_CONT2[5] AX[$P_AXN2]=_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N140 G1 AX[$P_AXN1]=_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N145 G2 AX[$P_AXN1]=_CONT2[2] AX[$P_AXN2]=_CONT2[6] CR=_CONT2[4]
ENDIF
N150 G1 AX[$P_AXN2]=_CONT2[1]
ELSE
N200 G1 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
IF(_CONT2[6]>0)
N205 AX[$P_AXN2]=_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N210 G3 AX[$P_AXN1]=_CONT2[5] AX[$P_AXN2]=_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N215 G1 AX[$P_AXN1]=-_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N220 G3 AX[$P_AXN1]=-_CONT2[2] AX[$P_AXN2]=_CONT2[6] CR=_CONT2[4]
ENDIF
IF(_CONT2[6]>0)
N230 G1 AX[$P_AXN2]=-_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N235 G3 AX[$P_AXN1]=-_CONT2[5] AX[$P_AXN2]=-_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N240 G1 AX[$P_AXN1]=_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N245 G3 AX[$P_AXN1]=_CONT2[2] AX[$P_AXN2]=-_CONT2[6] CR=_CONT2[4]
ENDIF
N250 G1 AX[$P_AXN2]=_CONT2[1]
ENDIF
_E_SP_REC_END:
RET

KOMP_TYP="B-SPLINE"
KOMP_TYP.lt=$82176
ADDHTX(KOMP_TYP,"PGZ.pdf",355,"B-SPLINE")
HM_TV=1
Else
KOMP_TYP=$81504
KOMP_TYP.lt=$82130
BAHN="G642"
BAHN.lt=$82177
BAHN.wr=2
HM_TV=1
EndIf
EndIf
EndIf
If HM_TV==0
If KOMP_TYP =="B-SPLINE"

SUB(TOG_KOMP_TYP)
REG[1]=1
CLRHTX(KOMP_TYP)
DEBUG("MD19330_2_W: "<<MD19330_2_W)
If MD19330_2_W ==1
MD19330_2=0
MD19330_2_W=0
KOMP_TYP.wr=0
KOMP_TYP.st=""
KOMP_TYP=$81504
FOC="BAHN"
Else
HM_TV=0

KOMP_TYP=$81504
KOMP_TYP.st=""
EndIf
BAHN.st=$82133
If KOMP_TYP ==$81504
BAHN.wr=ANZ_WR
Else
BAHN.wr=1
EndIf
DEBUG("KOMP_TYP:"<<KOMP_TYP)
CLRHTX(BAHN)
If KOMP_TYP ==$81504
If REG[13] ==0
BAHN="G64"

RA_TRAF="TRAORI(2)"
RA_TRAF.lt=$82173
ADDHTX(RA_TRAF,"PGZ.pdf",353,"TRAORI")
Else
RA_TRAF=$81504
RA_TRAF.lt=$82171
EndIf
Else
RA_TRAF=$81504
RA_TRAF.lt=$82171
EndIf
EndIf
Else
RA_TRAF.st=""
RA_TRAF.wr=0
RA_TRAF=$81504
MD19410_0=0
EndIf
END_SUB

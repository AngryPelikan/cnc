EndIf
If REG[15] ==2
KOMP_TYP="COMPCURV"
KOMP_TYP.lt=$82175<<" COMPCURV"
ADDHTX(KOMP_TYP,"PGZ.pdf",355,"COMPCURV")
EndIf
If REG[15] ==3
KOMP_TYP="B-Spline"
KOMP_TYP.lt=$82176
ADDHTX(KOMP_TYP,"PGZ.pdf",355,"B-Spline")
EndIf
Else

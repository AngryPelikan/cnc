Endif
ANZ_WR=1
ANW_TECH=$81504
CALL("ANZ_TECH")
DEBUG("TOLL.st: "<<TOLL.st)
END_SUB
SUB(ANZ_TECH)
If LEVEL < 6
REG[3]=0
CLRHTX(KOMP_TYP)
If MD19330_2 ==1
KOMP_TYP.st=$82131
KOMP_TYP.wr=ANZ_WR

SUB(AUSW_TOLM)
HILF=0
REG[6]=0
REG[10]=REG[2] MOD 10
If REG[10] < 0 OR REG[10] > 3
REG[10]=3
REG[6]=1
DEBUG("1")
EndIf
If BEA_ART =="A"
If REG[10] <> 0
REG[10]=0
REG[6]=1
DEBUG("2")
EndIf
EndIf
If BEA_ART =="S"
If REG[10] <> 3
REG[10]=3
REG[6]=1
DEBUG("2")
EndIf
EndIf
If BEA_ART =="V"
If REG[10] <> 2
REG[10]=2
REG[6]=1
DEBUG("3")
EndIf
EndIf
If BEA_ART =="F"
DEBUG("BEA_ART: "<<BEA_ART)
DEBUG("REG10: "<<REG[10])
If REG[10] <> 1
REG[10]=1
REG[6]=1
DEBUG("4")
EndIf
EndIf
HILF=(REG[2] / 10) MOD 10
REG[11] = 0
HILF=(REG[2] / 100) MOD 10
REG[12] = HILF
If REG[12] < 0 OR REG[12] > 2
REG[12]=0
REG[6]=1
DEBUG("5")
EndIf
CALL("TECH_AUSW")
HILF=(REG[2] / 10000000) MOD 10
REG[17]=HILF
HILF=(REG[2] / 100000000) MOD 10
REG[20]=HILF
If REG[6] ==1
DLGL($82163)
REG[19] =REG[10]+(REG[11]*10)+(REG[12]*100)+(REG[13]*1000)+(REG[14]*10000)+(REG[15]*100000)+(REG[16]*1000000)
If REG[10] ==0
WNP("_TOLT[0]",REG[19])
EndIf
If REG[10] ==1
WNP("_TOLT[0]",REG[19])
EndIf
If REG[10] ==2
WNP("_TOLT[1]",REG[19])
EndIf
If REG[10] ==3
WNP("_TOLT[2]",REG[19])
EndIf
EndIf
DEBUG("BEA_ART: "<<BEA_ART)
DEBUG("REG10: "<<REG[10])
DEBUG("REG11: "<<REG[11])
DEBUG("REG12: "<<REG[12])
DEBUG("REG13: "<<REG[13])
DEBUG("REG14: "<<REG[14])
DEBUG("REG15: "<<REG[15])
DEBUG("REG16: "<<REG[16])
END_SUB
SUB(TECH_AUSW)
HILF=(REG[2] / 1000) MOD 10
REG[13]=HILF
If HILF < 0 OR HILF > 3
REG[13]=2
REG[6]=1
DEBUG("7")
EndIf
HILF=(REG[2] / 10000) MOD 10
REG[14] = HILF
If REG[14] < 0 OR REG[14] > 2
REG[14]=0
REG[6]=1
DEBUG("8")
EndIf
HILF=(REG[2] / 100000) MOD 10
REG[15] = HILF
If REG[15] < 0 OR REG[15] > 3
REG[15]=0
REG[6]=1
DEBUG("9")
EndIf
HILF=(REG[2] / 1000000) MOD 10
REG[16] = HILF
If REG[16] < 0 OR REG[16] > 1
REG[16]=0
REG[6]=1
DEBUG("10")
Endif
END_SUB
SUB(ANZEIG)
If REG[10] ==0
BEA=$82138
BEA.lt=$82170
TOLL.wr=0
TOLL.st=""
TOLL_st.st=""
EndIf
If REG[10] ==1
BEA=$80443
BEA.lt=$82167
EndIf
If REG[10] ==2
BEA=$82137
BEA.lt=$82168
EndIf
If REG[10] ==3
BEA=$80442
BEA.lt=$82169
EndIf
If REG[7] ==1
If ENTRY ==3
Else
TOLL=EVAL("TOLL"<<BEA_ART)
EndIf
Else
TOLL=EVAL("TOLL"<<BEA_ART)
EndIf
CLRHTX(RA_TRAF)
If MD19410_0 ==1
If REG[12] ==0
RA_TRAF=$81504

SUB(TOG_BEA)
DEBUG("BEA_A: "<<BEA)
HM_TV=0
If MD19330_2_W ==1
MD19330_2_W=0
MD19330_2=0
EndIf
If MD19410_0_W ==1
MD19410_0_W=0
MD19410_0=0
EndIf
If BEA ==$80443
BEA_ART="V"
REG[2]=EVAL("TOLT"<<BEA_ART)
CALL("AUSW_TOLM")
CALL("ANZEIG")
HM_TV=1
EndIf
If HM_TV ==0
If BEA ==$82137
BEA_ART="S"
REG[2]=EVAL("TOLT"<<BEA_ART)
CALL("AUSW_TOLM")
CALL("ANZEIG")
HM_TV=1
EndIf
EndIf
If HM_TV ==0
If BEA ==$80442
BEA_ART="A"
TOLL.wr=0
TOLL.st=""
TOLL_st.st=""
REG[2]=EVAL("TOLT"<<BEA_ART)
CALL("AUSW_TOLM")
CALL("ANZEIG")
HM_TV=1
EndIf
EndIf
If HM_TV ==0
If BEA ==$82138
BEA_ART="F"
TOLL.wr=2
TOLL.st="_TOL"
TOLL_st.st=$82122
REG[2]=EVAL("TOLT"<<BEA_ART)
CALL("AUSW_TOLM")
CALL("ANZEIG")
HM_TV=1
EndIf
EndIf
DEBUG("BEA_E: "<<BEA)
END_SUB
SUB(TOG_TECH)

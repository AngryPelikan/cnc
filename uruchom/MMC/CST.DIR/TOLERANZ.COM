EndIf
If REG[13] ==1
BAHN="G641"
BAHN.lt=$82178
ADDHTX(BAHN,"PGZ.pdf",356,"G641")
EndIf
If REG[13] ==2
BAHN="G642"
BAHN.lt=$82177
ADDHTX(BAHN,"PGZ.pdf",356,"G642")
EndIf
Else
BAHN="G642"
BAHN.wr=1
ADDHTX(BAHN,"PGZ.pdf",356,"G642")
EndIf
VORS.st=$80971
VORS.wr=ANZ_WR
CLRHTX(VORS)
If REG[14] ==0
VORS="FFWOF SOFT"
ADDHTX(VORS,"PGZ.pdf",357,"FFWOF")
EndIf
If REG[14] ==1
VORS="FFWON SOFT"
ADDHTX(VORS,"PGZ.pdf",357,"FFWON")
EndIf
If REG[14] ==2
VORS="FFWOF BRISK"
ADDHTX(VORS,"PGZ.pdf",357,"BRISK")
EndIf
Else
ANW_TECH.wr=0
ANW_TECH.st=""
KOMP_TYP.wr=0
KOMP_TYP.st=""
BAHN.wr=0
BAHN.st=""
VORS.wr=0
VORS.st=""
EndIf
END_SUB

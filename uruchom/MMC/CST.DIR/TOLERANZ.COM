BAHN="G642"
BAHN.lt=$82177
BAHN.wr=1
EndIf
If HM_TV==0
If KOMP_TYP =="COMPCAD"
KOMP_TYP="COMPCURV"
KOMP_TYP.lt=$82175<<" COMPCURV"
ADDHTX(KOMP_TYP,"PGZ.pdf",355,"COMPCURV")
HM_TV=1
EndIf
EndIf
If HM_TV==0
If KOMP_TYP =="COMPCURV"

PROC HOLES2 (REAL CPA,REAL CPO,REAL RAD,REAL STA1,REAL INDA,INT NUM,INT _VARI,INT _UMODE) SAVE DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.04.17 Sep 08, 2003
;Lochkreis
DEF AXIS _X,_Y
DEF REAL HH1,HH2,HH3
DEF INT HZ1,_SPIND,_H8
_X=$P_AXN1 _Y=$P_AXN2 RAD=ABS(RAD) NUM=ABS(NUM) HH3=STA1
_SPIND=ABS(_VARI) DIV 100
IF ((_SPIND<>2)AND(_SPIND<>0)) GOTOF _FEHL5
IF ((_VARI MOD 100)<>0) GOTOF _FEHL5
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF _FEHL5
IF NUM==0 GOTOF FEHL1 IF $P_MC GOTOF _MM0
SETAL(62100)
STOPRE
M0
_MM0:IF INDA <> 0 GOTOF _MM1
INDA=360/NUM
_MM1: IF ABS(INDA)*(NUM-1) >= 360 GOTOF FEHL2
IF _SPIND==2
SBLOF
ST_CUST(_UMODE)
SBLON
ENDIF
_MM2:G0 G60 AX[_X]=CPA+RAD*COS(HH3) AX[_Y]=CPO+RAD*SIN(HH3)
HH3=HH3+INDA HZ1=HZ1+1
IF HZ1 < NUM GOTOB _MM2
IF _SPIND==2
SBLOF
ST_CUST(_UMODE+1)
SBLON
ENDIF
RET
FEHL1:STOPRE
SETAL(61103)
RET
FEHL2:STOPRE
SETAL(61106)
RET
_FEHL5:STOPRE
N710 SETAL(61002)
RET
_FEHL12:STOPRE
N711 SETAL(61002)
RET

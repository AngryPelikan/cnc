PROC CYCPE_SC SBLOF DISPLOF
;VERSION: 06.04.24 Mar 26, 2004
;CHANGE : 06.03.03 Sep 18, 2002
DEF STRING[40] _SERR
DEF INT _TCI, _TCRD
_TCI=$P_TC
IF(_TCI>0)
IF ($TC_CARR37[_TCI] MOD 1000 DIV 100)>=2
_TCRD=4
ENDIF
_TCRD=_TCRD+($TC_CARR37[_TCI] MOD 100 DIV 10)
IF(_TC_ST==31)OR(_TC_ST==33)OR(_TC_ST==35)OR(_TC_ST==37)
CASE _TCRD OF 1 GOTOF _RD1 2 GOTOF _RD2 4 GOTOF _RD4 5 GOTOF _RD4 DEFAULT GOTOF _RDe
_RD1:
_SERR=<<(SUBSTR($TC_CARR35[_TCI],0,5))<<": "<<_TC_A1<<"  "<<(SUBSTR($TC_CARR36[_TCI],0,5))<<": "<<_TC_A2
SETAL(62180,_SERR)
GOTOF _RDe
_RD2: _SERR=<<(SUBSTR($TC_CARR36[_TCI],0,5))<<": "<<_TC_A2
SETAL(62181,_SERR)
GOTOF _RDe
_RD4: _SERR=<<(SUBSTR($TC_CARR35[_TCI],0,5))<<": "<<_TC_A1
SETAL(62181,_SERR)
_RDe:
M0
ENDIF
IF(_TC_ST==21)OR(_TC_ST==23)OR(_TC_ST==25)OR(_TC_ST==27)
IF _TCRD<>2
_SERR=<<(SUBSTR($TC_CARR35[_TCI],0,5))<<": "<<_TC_A1
SETAL(62181,_SERR)
ENDIF
M0
ENDIF
IF(_TC_ST==30)OR(_TC_ST==32)
IF _TCRD<4
_SERR=<<(SUBSTR($TC_CARR36[_TCI],0,5))<<": "<<_TC_A2
SETAL(62181,_SERR)
ENDIF
M0
ENDIF
STOPRE
ENDIF
M17
